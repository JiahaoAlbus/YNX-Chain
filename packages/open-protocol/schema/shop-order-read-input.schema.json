{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ynx:tool:shop.order.read:input:1",
  "title": "Shop selected order read arguments",
  "type": "object",
  "additionalProperties": false,
  "required": ["orderId", "fields", "snapshot"],
  "properties": {
    "orderId": {"type": "string", "minLength": 1, "maxLength": 256},
    "fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 9,
      "uniqueItems": true,
      "description": "Exact selected fields in ascending lexical order; no implicit defaults or scope expansion.",
      "items": {
        "type": "string",
        "enum": ["createdAt", "currency", "reservationExpiresAt", "shippingYNXT", "status", "subtotalYNXT", "taxYNXT", "totalYNXT", "updatedAt"]
      }
    },
    "snapshot": {"type": "string", "pattern": "^[0-9a-f]{128}$"}
  }
}
