{
  "name": "@ynx-chain/open-protocol",
  "version": "0.0.0-dev.3",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/open-envelope.d.ts",
      "import": "./src/open-envelope.js"
    },
    "./identity-challenge": {
      "types": "./src/identity-challenge.d.ts",
      "import": "./src/identity-challenge.js"
    },
    "./framing": {
      "types": "./src/framing.d.ts",
      "import": "./src/framing.js"
    },
    "./identity-event": {
      "types": "./src/identity-event.d.ts",
      "import": "./src/identity-event.js"
    },
    "./bound-grant": {
      "types": "./src/bound-grant.d.ts",
      "browser": null,
      "node": "./src/bound-grant.js",
      "default": null
    }
  },
  "files": [
    "src/",
    "schema/",
    "go/",
    "test/fixtures/"
  ],
  "scripts": {
    "test:framing": "node --test test/framing.test.mjs",
    "test:identity-challenge": "node --test test/identity-challenge.test.mjs",
    "test": "node --test test/*.test.mjs",
    "test:identity-event": "node --test test/identity-event.test.mjs",
    "test:bound-grant": "node --test test/bound-grant.test.mjs"
  }
}
