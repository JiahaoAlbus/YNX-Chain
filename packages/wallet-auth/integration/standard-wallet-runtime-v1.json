{
  "schemaVersion": "1.0.0",
  "contractId": "YNX-STANDARD-WALLET-RUNTIME-V1",
  "runtimeVersion": "1.0.0-p0.0",
  "package": { "name": "@ynx-chain/wallet-auth", "version": "1.2.0", "publicRegistryPublished": false },
  "subpaths": {
    "shared": "@ynx-chain/wallet-auth/standard-wallet-runtime",
    "web": "@ynx-chain/wallet-auth/standard-wallet-web",
    "native": "@ynx-chain/wallet-auth/standard-wallet-native"
  },
  "platforms": {
    "web": { "adapter": "installStandardWalletWebRuntime", "transport": ["EIP-6963", "EIP-1193"], "legacyInjection": "if-empty-never-overwrite" },
    "android": { "adapter": "createStandardWalletNativeBridge", "transport": ["canonical-json-rpc-bridge", "React-Native-JS-runtime"] },
    "ios": { "adapter": "createStandardWalletNativeBridge", "transport": ["canonical-json-rpc-bridge", "React-Native-JS-runtime"] },
    "macos": { "adapter": "createStandardWalletNativeBridge", "transport": ["canonical-json-rpc-bridge", "JavaScriptCore-JS-runtime"] },
