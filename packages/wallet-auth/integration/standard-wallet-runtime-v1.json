    { "name": "@noble/hashes", "version": "2.2.0", "license": "MIT", "attribution": "THIRD_PARTY_NOTICES.md" }
  ],
  "truth": {
    "sourceImplemented": true,
    "packedArtifactInstallHarness": true,
    "realBrowserExtensionInstalled": false,
    "realAndroidWalletInstalled": false,
    "realIosWalletInstalled": false,
    "realMacosWalletInstalled": false,
    "realDesktopWalletInstalled": false,
    "realWalletConnectRelay": false,
    "deployedPublic": false
  }
