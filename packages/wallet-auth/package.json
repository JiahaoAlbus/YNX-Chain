{
  "name": "@ynx-chain/wallet-auth",
  "version": "1.3.0",
  "packageManager": "npm@11.5.1",
  "license": "UNLICENSED",
  "description": "Strict Sign in with YNX Wallet request, approval, and product-session binding protocol",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./standard-wallet-runtime": {
      "types": "./src/index.d.ts",
      "import": "./src/standard-wallet-runtime.js",
      "default": "./src/standard-wallet-runtime.js"
    },
    "./standard-wallet-web": {
      "types": "./src/index.d.ts",
      "import": "./src/standard-wallet-web-runtime.js",
      "default": "./src/standard-wallet-web-runtime.js"
    },
    "./standard-wallet-native": {
      "types": "./src/index.d.ts",
      "import": "./src/standard-wallet-native-bridge.js",
      "default": "./src/standard-wallet-native-bridge.js"
    },
    "./standard-wallet-walletconnect": {
      "types": "./src/index.d.ts",
      "import": "./src/standard-wallet-walletconnect-runtime.js",
      "default": "./src/standard-wallet-walletconnect-runtime.js"
    },
    "./gateway-node-host": {
      "types": "./src/gateway-node-host.d.ts",
      "import": "./src/gateway-node-host.js",
      "default": "./src/gateway-node-host.js"
    },
    "./gateway-backup": {
      "types": "./src/gateway-backup.d.ts",
      "import": "./src/gateway-backup.js",
      "default": "./src/gateway-backup.js"
    },
    "./sponsorship-ledger-node": {
      "types": "./src/sponsorship-ledger-node.d.ts",
      "import": "./src/sponsorship-ledger-node.js",
      "default": "./src/sponsorship-ledger-node.js"
    },
    "./product-session-gateway-node-host": {
      "types": "./src/index.d.ts",
      "import": "./src/product-session-gateway-node-host.js",
      "default": "./src/product-session-gateway-node-host.js"
    },
    "./product-session-gateway-node-state-migration": {
      "types": "./src/index.d.ts",
      "import": "./src/product-session-gateway-node-state-migration.js",
      "default": "./src/product-session-gateway-node-state-migration.js"
    },
    "./wallet-provider-discovery": {
      "types": "./src/index.d.ts",
      "import": "./src/wallet-provider-discovery.js",
      "default": "./src/wallet-provider-discovery.js"
    },
    "./metamask-evm": {
      "types": "./src/index.d.ts",
      "import": "./src/metamask-evm-adapter.js",
      "default": "./src/metamask-evm-adapter.js"
    },
    "./wallet-connection-coordinator": {
      "types": "./src/index.d.ts",
      "import": "./src/wallet-connection-coordinator.js",
      "default": "./src/wallet-connection-coordinator.js"
    }
  },
  "types": "./src/index.d.ts",
  "files": ["src", "scripts", "harness", "testdata", "integration", "THIRD_PARTY_NOTICES.md", "central-registry.json", "product-session-registry.json", "registry-conflict-evidence.json", "CENTRAL_INTEGRATION.md"],
  "bin": {
    "ynx-wallet-gatewayd": "scripts/ynx-wallet-gatewayd.mjs",
    "ynx-wallet-product-session-state-migrate": "scripts/ynx-wallet-product-session-state-migrate.mjs",
    "ynx-wallet-product-session-state-materialize": "scripts/ynx-wallet-product-session-state-materialize.mjs",
    "ynx-wallet-gateway-backup": "scripts/ynx-wallet-gateway-backup.mjs",
    "ynx-wallet-gateway-state-lock": "scripts/ynx-wallet-gateway-state-lock.mjs",
    "ynx-wallet-sponsorship-state-lock": "scripts/ynx-wallet-sponsorship-state-lock.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "npm test && npm run verify:no-bare-authorize && npm run verify:no-legacy-9102 && npm run verify:standard-wallet-connect-consumer && npm run verify:standard-wallet-e2e-execution && npm run verify:installed-standard-wallet-runtime",
    "verify:no-bare-authorize": "node scripts/verify-no-bare-wallet-authorize.mjs",
    "verify:no-legacy-9102": "node scripts/verify-no-legacy-chain-9102.mjs",
    "verify:standard-wallet-connect-consumer": "node scripts/verify-standard-wallet-connect-consumer.mjs",
    "verify:installed-standard-wallet-runtime": "node scripts/run-standard-wallet-installed-harness.mjs",
    "verify:standard-wallet-e2e-execution": "node scripts/verify-standard-wallet-e2e-execution-plan.mjs",
    "drill:backup": "node scripts/run-gateway-backup-drill.mjs",
    "benchmark:gateway": "node scripts/benchmark-gateway.mjs",
    "probe:public-gateway": "node scripts/verify-public-gateway.mjs",
    "probe:public-gateway-multi-user": "node scripts/verify-public-gateway-multi-user.mjs",
    "verify:web-companion-6441": "node scripts/verify-wallet-web-companion-6441-acceptance.mjs",
    "probe:public-erc4337": "node scripts/probe-public-erc4337.mjs",
    "verify:canonical-wallet-callers": "node scripts/verify-canonical-wallet-callers.mjs",
    "report:canonical-wallet-callers": "node scripts/verify-canonical-wallet-callers.mjs --report-only",
    "verify:testnet-deployment": "node scripts/verify-testnet-deployment.mjs",
    "monitor:testnet-deployment": "node scripts/monitor-testnet-deployment.mjs",
    "integrity:testnet-deployment": "node scripts/deployment-artifact-integrity.mjs",
    "promote:public-erc4337-metadata": "node scripts/promote-public-erc4337-metadata.mjs",
    "proof:product-session": "node test/generate-product-session-visible-proof.mjs",
    "vector:strategy": "node scripts/generate-strategy-mandate-vector.mjs"
  },
  "dependencies": {
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.2.0"
  },
  "engines": { "node": ">=22" },
  "private": true
}
