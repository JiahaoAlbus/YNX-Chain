    "proof:product-session": "node test/generate-product-session-visible-proof.mjs",
    "vector:strategy": "node scripts/generate-strategy-mandate-vector.mjs",
    "qa:pq-recovery": "node scripts/qa-pq-wallet-recovery.mjs",
    "test:owned-interfaces": "npm run test:source-v2-acquisition && npm run test:auth-runtime-closure && node scripts/assert-pq-test-provider.mjs && node --test --test-concurrency=1 test/pq-wallet-native-action-signing.test.mjs test/pq-native-action-codec.test.mjs test/pq-native-action-go-interop.test.mjs test/auth-identity-proof-frame.test.mjs test/pq-wallet-auth-identity-signing.test.mjs test/original-identity-peer-runtime.test.mjs test/original-wallet-identity-source-binding.test.mjs test/original-ide-identity-peer-binding.test.mjs test/original-ide-native-auth-binding.test.mjs test/auth-native-type-only-export.test.mjs test/auth-source-acquisition-driver.test.mjs test/auth-source-transition.test.mjs test/auth-source-issued-observed-height.test.mjs test/auth-source-v2-public-consumer.test.mjs test/auth-identity-verification.test.mjs test/pq-registered-member.test.mjs test/original-ide-public-export.test.mjs test/original-ide-private-client-r33.test.mjs test/original-auth-identity-private-joint-registration.test.mjs test/pq-wallet-policy.test.mjs test/pq-wallet-policy-v2.test.mjs test/pq-wallet-revocation-wire.test.mjs test/pq-wallet-revocation-policy.test.mjs test/auth-policy-r35-projection.test.mjs test/auth-policy-r35-normal-source-transaction.test.mjs test/walletconnect-address-profile.test.mjs test/walletconnect-dependency-closure.test.mjs test/walletconnect-partial-initialization.test.mjs test/walletconnect-cleanup-observation.test.mjs test/central-browser-pair-cleanup.test.mjs test/original-ide-cold-terminal-custody.test.mjs test/original-host-terminal-journal-cleanup.test.mjs test/original-host-first-enter-r48.test.mjs && npm run test:types",
    "test:types:browser": "node test/check-type-closures.mjs --only=browser",
    "test:types:node-private": "node test/check-type-closures.mjs --only=node-private",
    "test:auth-runtime-closure": "node --experimental-import-meta-resolve --test test/auth-runtime-closure.test.mjs",
    "test:source-v2-acquisition": "node integration/source-acquisition-r101/tests/run.mjs",
    "test:pq-action-transport": "node --test --test-concurrency=1 test/pq-action-transport.test.mjs && tsc -p test/tsconfig.pq-action-transport-browser.json && tsc -p test/tsconfig.pq-action-transport-node.json",
    "test:pq-native-r140-compatibility": "node --test test/pq-native-r140-compatibility.test.mjs",
    "test:joint-child-cleanup": "node --test --test-name-pattern=\"joint cleanup (retains|drains|waits)|R11 PUBLIC joint|R11 PUBLIC failed commit|R20 PUBLIC typed (partial|IDE selects)|R33 PUBLIC parent retire drains\" test/original-auth-identity-private-joint-registration.test.mjs && node --test test/pq-native-r140-compatibility.test.mjs",
    "test:auth4-deploy-composition": "node --test test/auth4-deploy-composition.test.mjs test/pq-native-r140-compatibility.test.mjs && tsc -p test/tsconfig.pq-contract-deployment-transport-browser.json && tsc -p test/tsconfig.pq-contract-deployment-transport-node.json",
    "test:r154-normal-paired": "node --test test/r154-normal-paired-build.test.mjs test/pq-native-r140-compatibility.test.mjs",
    "test:developer-contract": "node --test test/developer-contract-connection.test.mjs test/walletconnect-address-profile.test.mjs test/walletconnect-dapp-lifecycle.test.mjs test/walletconnect-cleanup-observation.test.mjs && npm run test:types:browser",
    "test:r159-normal-typed": "node --test test/r159-normal-publication-build.test.mjs test/r154-normal-paired-build.test.mjs test/pq-native-r140-compatibility.test.mjs",
    "test:artifact-contract": "node --test --test-concurrency=1 test/ide-artifact-manifest.test.mjs test/ide-artifact-signature.test.mjs test/contract-relay-guard.test.mjs test/contract-relay-guard-node.test.mjs test/developer-contract-connection.test.mjs test/walletconnect-runtime-closure.test.mjs && npm run test:types"
