  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./gateway-node-host": {
      "types": "./src/gateway-node-host.d.ts",
      "import": "./src/gateway-node-host.js",
      "default": "./src/gateway-node-host.js"
    }
  },
  "types": "./src/index.d.ts",
  "files": ["src", "scripts", "testdata", "integration", "central-registry.json", "registry-conflict-evidence.json", "CENTRAL_INTEGRATION.md"],
