[Unit]
Description=YNX Quant public isolated Testnet research workspace
After=network-online.target ynx-quant-exchange.service
Wants=network-online.target ynx-quant-exchange.service

[Service]
Type=simple
User=ynx
Group=ynx
WorkingDirectory=/opt/ynx-quant/current
EnvironmentFile=/etc/ynx/ynx-quant.env
ExecStart=/opt/ynx-quant/current/ynx-quant
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ynx-quant

[Install]
WantedBy=multi-user.target
