[Unit]
Description=YNX Quant authoritative Testnet market-tape dependency
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ynx
Group=ynx
WorkingDirectory=/opt/ynx-quant/current
EnvironmentFile=/etc/ynx/ynx-quant.env
ExecStart=/opt/ynx-quant/current/ynx-exchange
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ynx-quant

[Install]
WantedBy=multi-user.target
