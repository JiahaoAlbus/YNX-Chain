wallet-auth.ynxweb4.com, wallet-auth-testnet.43.153.202.237.sslip.io {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
  }
  @ynx_product_session_v2 path /v2/product-sessions/*
  handle @ynx_product_session_v2 {
    reverse_proxy 127.0.0.1:6441
  }
  handle {
    reverse_proxy 127.0.0.1:18445
  }
}
