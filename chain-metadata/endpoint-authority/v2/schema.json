  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ynxweb4.com/schemas/endpoint-authority-v2.json",
  "description": "Shape only. The SDK semantic and cryptographic verifier, independent root, exact consumer, trusted clock and durable checkpoint are mandatory. This schema does not activate a release.",
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "tree"
      ],
      "properties": {
        "repository": {
          "const": "https://github.com/JiahaoAlbus/YNX-Chain"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "tree": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "httpStatus",
        "bodySha256",
        "observedAt",
        "tlsVerified",
        "directDNS"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "httpStatus": {
          "const": 200
        },
        "bodySha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
        },
        "tlsVerified": {
          "const": true
        },
        "directDNS": {
          "const": true
        }
      }
    },
    "endpointEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "health",
        "version",
        "source",
        "chainId",
        "receiptSha256"
      ],
      "properties": {
        "health": {
          "$ref": "#/$defs/observation"
        },
        "version": {
          "$ref": "#/$defs/observation"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "chainId": {
          "const": 6423
        },
        "receiptSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
