                    },
                    "registrySha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "callbackContractSha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "currentPublicSourceAccepted": {
                      "const": true
                    },
                    "productSessionAccepted": {
