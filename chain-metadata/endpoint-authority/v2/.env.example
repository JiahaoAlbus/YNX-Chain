# Public, independently reviewed files; never populated from remote manifest.
YNX_ENDPOINT_AUTHORITY_TRUST_ROOT_FILE=/etc/ynx/endpoint-authority/trust-root.json
YNX_ENDPOINT_AUTHORITY_CHECKPOINT_FILE=/var/lib/ynx/endpoint-authority/checkpoint.json
# Signer machine only. External Ed25519 PKCS8 PEM, private regular file 0600.
# Do not place the key value in env, command arguments, logs, this repo, or apps.
YNX_ENDPOINT_AUTHORITY_SIGNING_KEY_FILE=
# This example activates nothing. Existing bundled v1.1 PENDING remains in use.
