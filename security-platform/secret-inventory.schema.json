{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ynx:security:secret-inventory:v1",
  "title": "YNX Secret Inventory Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "schema",
    "source",
    "asOf",
    "status",
    "requiredSecretTypes",
    "separationRules",
    "valueMaterialStored",
    "secrets",
    "blockedBy"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "schema": { "const": "security-platform/secret-inventory.schema.json" },
    "source": { "type": "string", "minLength": 1 },
    "asOf": { "type": "string", "format": "date-time" },
    "status": { "enum": ["not-configured", "partial", "configured"] },
    "requiredSecretTypes": {
      "type": "array",
      "minItems": 12,
      "uniqueItems": true,
      "items": {
        "enum": [
          "validator-key",
          "faucet-key",
          "deploy-key",
          "treasury-key",
          "provider-credential",
          "database-credential",
          "api-credential",
          "artifact-signing-key",
          "mobile-signing-key",
          "tls-key",
          "backup-encryption-key",
          "recovery-key"
        ]
      }
    },
    "separationRules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "valueMaterialStored": { "const": false },
    "secrets": {
      "type": "array",
      "items": { "$ref": "#/$defs/secretMetadata" }
    },
    "blockedBy": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "secretMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "class",
        "secretType",
        "owner",
        "product",
        "environment",
        "purpose",
        "provider",
        "managerReference",
        "storageLocation",
        "accessPolicy",
        "rotationPeriodDays",
        "createdAt",
        "expiresAt",
        "lastRotatedAt",
        "nextRotationAt",
        "revocationStatus",
        "breakGlassPolicy",
        "auditStatus",
        "backupStatus",
        "recoveryBoundary",
        "rotationRunbook",
        "lastRotationEvidence"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
        "class": { "type": "string", "minLength": 1 },
        "secretType": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "product": { "type": "string", "minLength": 1 },
        "environment": { "enum": ["local", "testnet", "staging", "production"] },
        "purpose": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "managerReference": { "type": "string", "minLength": 1 },
        "storageLocation": { "type": "string", "minLength": 1 },
        "accessPolicy": { "type": "string", "minLength": 1 },
        "rotationPeriodDays": { "type": "integer", "minimum": 1, "maximum": 730 },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "lastRotatedAt": { "type": "string", "format": "date-time" },
        "nextRotationAt": { "type": "string", "format": "date-time" },
        "revocationStatus": { "enum": ["active", "pending", "revoked"] },
        "breakGlassPolicy": { "type": "string", "minLength": 1 },
        "auditStatus": { "enum": ["not-configured", "pending", "verified"] },
        "backupStatus": { "enum": ["prohibited", "not-configured", "pending", "verified"] },
        "recoveryBoundary": { "type": "string", "minLength": 1 },
        "rotationRunbook": { "type": "string", "minLength": 1 },
        "lastRotationEvidence": { "type": "string", "minLength": 1 }
      }
    }
  }
}
