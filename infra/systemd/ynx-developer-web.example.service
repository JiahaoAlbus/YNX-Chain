[Unit]
Description=YNX Developer public Testnet preview
After=network-online.target ynx-chaind.service ynx-ai-gatewayd.service ynx-app-gatewayd.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/ynx-developer/current
Environment=NODE_ENV=production
Environment=PORT=18111
Environment=YNX_DEVELOPER_VERSION=0.2.0-testnet-preview
Environment=YNX_DEVELOPER_COMMIT=17ee9ae5
Environment=YNX_DEVELOPER_CHAIN_URL=http://127.0.0.1:6420
Environment=YNX_DEVELOPER_AI_URL=http://127.0.0.1:6429
Environment=YNX_DEVELOPER_APP_GATEWAY_URL=http://127.0.0.1:6432
ExecStart=/usr/bin/node apps/developer/scripts/server.mjs
Restart=always
RestartSec=3
TimeoutStopSec=15
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadOnlyPaths=/opt/ynx-developer

[Install]
WantedBy=multi-user.target
