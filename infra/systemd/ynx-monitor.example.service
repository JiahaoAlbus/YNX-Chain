[Unit]
Description=YNX Network Monitor control plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ynx
Group=ynx
WorkingDirectory=/opt/ynx-monitor/current/apps/monitor
Environment=NODE_ENV=production
EnvironmentFile=/etc/ynx/ynx-monitor.env
ExecStart=/usr/bin/node node_modules/tsx/dist/cli.mjs server/index.ts
Restart=always
RestartSec=3
TimeoutStopSec=20
MemoryMax=512M
TasksMax=256
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/ynx-monitor

[Install]
WantedBy=multi-user.target
