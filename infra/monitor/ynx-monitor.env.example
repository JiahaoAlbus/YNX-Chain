YNX_MONITOR_PORT=18112
YNX_MONITOR_SESSION_SECRET=__SESSION_SECRET__
YNX_MONITOR_STATE_INTEGRITY_KEY=__STATE_INTEGRITY_KEY__
YNX_MONITOR_STATE_PATH=/var/lib/ynx-monitor/state.json
YNX_MONITOR_DISABLE_PASSWORD_LOGIN=1
YNX_MONITOR_RPC_URL=http://127.0.0.1:6420
YNX_MONITOR_EXPLORER_URL=http://127.0.0.1:6427
YNX_MONITOR_INDEXER_URL=http://127.0.0.1:6426
YNX_MONITOR_FAUCET_URL=http://127.0.0.1:6428
YNX_MONITOR_GATEWAY_URL=http://127.0.0.1:6437
YNX_MONITOR_AI_URL=http://127.0.0.1:6429
YNX_MONITOR_PUBLIC_ORIGIN=https://monitor.ynxweb4.com
YNX_MONITOR_ALLOWED_ORIGINS=https://monitor.ynxweb4.com
YNX_MONITOR_PUBLIC_STATUS_PATH=/var/lib/ynx-monitor/public-status.json
YNX_MONITOR_PUBLIC_STATUS_MAX_AGE_SECONDS=120
YNX_MONITOR_PUBLIC_STATUS_INTEGRITY_KEY=__PUBLIC_STATUS_INTEGRITY_KEY__
YNX_MONITOR_PUBLIC_STATUS_EXPECTED_SOURCE=ynx.status.publisher
YNX_MONITOR_PUBLIC_STATUS_APPROVAL_ID=public-network-probes-v2
YNX_MONITOR_PUBLIC_STATUS_PROBES='[{"id":"rpc","name":"YNX RPC","url":"http://127.0.0.1:6420/health","versionUrl":"http://127.0.0.1:6420/node/identity","dependencies":[]},{"id":"indexer","name":"YNX Indexer","url":"http://127.0.0.1:6426/health","versionUrl":"http://127.0.0.1:6426/version","dependencies":["rpc"]},{"id":"explorer","name":"YNX Explorer","url":"http://127.0.0.1:6427/health","versionUrl":"http://127.0.0.1:6427/version","dependencies":["rpc","indexer"]},{"id":"faucet","name":"YNX Faucet","url":"http://127.0.0.1:6428/health","dependencies":["rpc"]},{"id":"gateway","name":"YNX App Gateway","url":"http://127.0.0.1:6437/health","dependencies":["rpc"]}]'
