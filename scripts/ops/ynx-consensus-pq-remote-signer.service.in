# Candidate only. Render every @...@ from independent operator configuration.
# Install as exactly ynx-consensus-pq-remote-signer.service; do not enable/start
# until the target's original custody, checkpoint publisher and peer are ready.
# Requires systemd >= 250 with working LoadCredentialEncrypted. No plaintext
# EnvironmentFile, synthetic key initialization, automatic reconnect or retry.
#
# The checkpoint directory must expose the actual writer's committed state at
# the SAME original path. Set checkpointFormat explicitly to one of:
# atomic-committed-json-v1, snapshot-journal-v1, block-journal-v2. For journals,
# the ORIGINAL adjacent <state>.read.lock must also be visible and readable;
# the daemon opens it read-only with SH|NB, never creates it, and rejects busy,
# changed, corrupt or incomplete reads without source repair or cache fallback.
# Bind the directory, never an individual inode, so writer compaction/atomic
# replacements stay visible. The daemon reopens, fully reconstructs and binds
# exact authenticated engine H/AppHash on every request. The independent
# bootstrap, schedule, migration and optional runtime pins remain mandatory.
# This unit DOES NOT provide cross-host replication. A frozen file is not a
# live source. CHECKPOINT_PROVIDER_UNIT names the real local source/mount owner,
# not a dummy readiness unit. Its being active does not prove freshness. Source
# data and read locks must remain outside both writable HRS directory mounts.
#
# ORIGINAL_PQ_HRS_DIRECTORY must preserve HostKeyBinding.SignerStatePath.
# Never rewrite that binding or move/reset either original history to fit this
# template. Existing private files must be single-link 0600 and owned by the
# dedicated service UID; original history directories must be 0700. Original
# keys/vault are read-only here; only history directories are writable.
[Unit]
Description=YNX original PQ consensus remote signer
Requires=@CHECKPOINT_PROVIDER_UNIT@
After=network-online.target @CHECKPOINT_PROVIDER_UNIT@
Wants=network-online.target

[Service]
Type=exec
User=ynx-pq-signer
Group=ynx-pq-signer
UMask=0077
# This is service bookkeeping, not an instruction to relocate custody/HRS.
StateDirectory=ynx-consensus-pq-remote-signer
StateDirectoryMode=0700
LoadCredentialEncrypted=ynx-pq-recovery:/etc/credstore.encrypted/ynx-pq-recovery
ExecStart=/usr/local/libexec/ynx-consensus-pq-remote-signer-launch /etc/ynx/consensus-pq-remote-signer.conf
Restart=no
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=15s
SendSIGKILL=yes
LimitCORE=0
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
BindReadOnlyPaths=@CHECKPOINT_DIRECTORY@
ReadOnlyPaths=@OPERATOR_INPUTS_DIRECTORY@ @ORIGINAL_VAULT@ @ORIGINAL_LEGACY_KEY@ @ORIGINAL_TRANSPORT_KEY@
ReadWritePaths=@ORIGINAL_PQ_HRS_DIRECTORY@ @ORIGINAL_LEGACY_HRS_DIRECTORY@
UnsetEnvironment=BASH_ENV ENV SHELLOPTS BASHOPTS CDPATH LD_PRELOAD LD_LIBRARY_PATH GODEBUG GOTRACEBACK
# REQUIRED: decimal byte budget from measurements of these exact target inputs.
# Do not reuse the small synthetic process-window cap for production migration.
# The launcher compares the loaded unit's MemoryMax to the pinned configuration
# and verifies its supplied measurement artifact; no default budget is provided.
MemoryMax=@MEASURED_TARGET_MEMORY_MAX_BYTES@
TasksMax=160
StandardOutput=null
StandardError=journal
SyslogIdentifier=ynx-consensus-pq-remote-signer

[Install]
WantedBy=multi-user.target
