  "interface": {
    "getter": "acquireOriginalProductSessionDeviceV4Source()",
    "rawMethod": "produceHTTPProof(input3,sameNativeHeld,originalFrozenAbortContext)",
    "return": "Same frozen branded operation, synchronous",
    "operation": [
      "readOriginalMember",
      "assertCurrent",
      "retire",
      "join",
      "close"
    ],
    "lateFailure": "RETURN same failed operation before original SDK active/current throws; do not lose unattachable frozen/primitive abort partial",
    "beforeEffectFailure": "Original validation/abort refusal, no private effect to own",
    "devicePorts": "Original SDK owns exact4 projection over SAME raw fixed-image owner; not public SDK export yet",
    "stageFlag": "YNX_ORIGINAL_PRODUCT_DEVICE_V4_HTTP_PRODUCER_STAGE"
  },
  "implemented": [
    "Actual Native source4-to-fixed-factory producer and opaque operation",
    "Same actual held/context/AbortSignal/current prepost, original late reason and bounded binary original",
    "Parent join/close custody fence, first-close-result/debt and env teardown order",
    "Public result/cleanup/exact length diagnostics without changing caller reasons"
  ],
  "tests": {
    "newNapiProducerControls": 15,
    "napiPassIncludingSuite": 16,
    "simulatedBoundaryArchiveSuiteSkipped": 1,
    "actualNewArchiveLinked": true,
    "actualDefinedSymbol": true,
