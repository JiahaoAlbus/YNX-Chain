static napi_value SetMode(napi_env env,napi_callback_info info){napi_value v=nullptr;size_t n=1;if(napi_get_cb_info(env,info,&n,&v,nullptr,nullptr)!=napi_ok||n!=1)return nullptr;char text[64];size_t size=0;if(napi_get_value_string_utf8(env,v,text,sizeof(text),&size)!=napi_ok)return nullptr;mode.assign(text,size);return DeviceV4Undefined(env);}
static napi_value Counts(napi_env env,napi_callback_info){napi_value o=nullptr,v=nullptr;napi_create_object(env,&o);for(auto item:{std::pair<const char*,unsigned>{"opens",opens},{"currents",currents},{"closes",closes}}){napi_create_uint32(env,item.second,&v);napi_set_named_property(env,o,item.first,v);}return o;}
static napi_value SetScope(napi_env env,napi_callback_info info){size_t n=1;napi_value v=nullptr;if(napi_get_cb_info(env,info,&n,&v,nullptr,nullptr)!=napi_ok||n!=1)return nullptr;size_t size=0;napi_get_value_string_utf8(env,v,nullptr,0,&size);if(size>65536)return nullptr;std::vector<char>b(size+1);napi_get_value_string_utf8(env,v,b.data(),b.size(),&size);PUBLIC_scope=[NSJSONSerialization JSONObjectWithData:[NSData dataWithBytes:b.data() length:size] options:0 error:nil];return DeviceV4Undefined(env);}
static napi_value Init(napi_env env,napi_value exports){if(!RegisterOriginalProductDeviceV4SourceStage(env,exports))return nullptr;napi_property_descriptor methods[]={{"setMode",nullptr,SetMode,nullptr,nullptr,nullptr,napi_default,nullptr},{"counts",nullptr,Counts,nullptr,nullptr,nullptr,napi_default,nullptr},{"setScope",nullptr,SetScope,nullptr,nullptr,nullptr,napi_default,nullptr}};if(napi_define_properties(env,exports,3,methods)!=napi_ok)return nullptr;return exports;}
