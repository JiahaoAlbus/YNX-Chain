static NSError*mockError(NSString*code){return [NSError errorWithDomain:@"PUBLIC-MOCK-SOURCE" code:1 userInfo:@{NSLocalizedDescriptionKey:code}];}
@implementation YNXAuthIdentitySourceAuthority
+(instancetype)acquireOriginalProductSessionDeviceV4Source:(NSError**)error{opens++;auto*s=[self new];if(mode=="partial"&&error)*error=mockError(@"PUBLIC_SOURCE_ACQUIRE_PARTIAL");return s;}
-(BOOL)assertOriginalProductSessionDeviceV4SourceCurrent:(NSError**)error{currents++;if(mode=="cpp-current")throw std::runtime_error("PUBLIC Source C++ exception");if(mode=="throw-current")@throw [NSException exceptionWithName:@"PUBLIC_SOURCE" reason:@"not real Root" userInfo:nil];if(retired||mode=="current-fail"||mode=="ref-fail"){if(error)*error=mockError(@"PUBLIC_SOURCE_CURRENT_REFUSED");return NO;}return YES;}
-(NSDictionary*)copyOriginalProductSessionDeviceV4Scope:(NSError**)error{if(![self assertOriginalProductSessionDeviceV4SourceCurrent:error])return nil;return PUBLIC_scope;}
-(void)retire{retired=YES;}
-(BOOL)join:(NSError**)error{if(!retired||mode=="join-pending"){if(error)*error=mockError(@"PUBLIC_SOURCE_JOIN_PENDING");return NO;}return YES;}
-(BOOL)close:(NSError**)error{closes++;if(mode=="close-fail"){if(error)*error=mockError(@"PUBLIC_SOURCE_CLOSE_REFUSED");return NO;}return YES;}
@end
