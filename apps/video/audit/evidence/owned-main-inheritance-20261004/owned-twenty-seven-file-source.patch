+			path, e := s.cfg.Objects.Resolve(key)
+			if e != nil {
+				t.Fatal(e)
+			}
+			if _, e = os.Stat(path); e != nil {
+				t.Fatalf("published metadata lost original media %s: %v", kind, e)
+			}
+		})
+	}
