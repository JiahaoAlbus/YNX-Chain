# OFFLINE issuer only. Values are file references, never private key bytes.
# Do not source this file on the Finance HTTP host.
YNX_FINANCE_RELEASE_PUBLIC_ROOT_FILE=/secure/finance-release/trust-v2.json
YNX_FINANCE_RELEASE_PRIVATE_KEY_FILE=/secure/finance-release/offline-issuer-ed25519.pem
# Runtime executor uses fixed root-owned /etc/ynx/finance-release-trust-v2.json.
# The service account must not access private issuer material or the control ledger.
