{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ynxweb4.com/schemas/finance-order-approval-v1.schema.json",
  "title": "YNX Finance Broker Sandbox order approval v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["account", "accountPublicKey", "applicationId", "brokerAccountId", "callbackStateHash", "chainEnvironment", "chainId", "challengeId", "expiresAt", "issuedAt", "nonce", "order", "orderHash", "origin", "platform", "productId", "provider", "requestId", "signature", "subjectId", "tradingEnvironment", "version"],
  "properties": {
    "version": {"const": "1"},
    "productId": {"const": "finance"},
    "applicationId": {"const": "com.ynxweb4.finance.web"},
    "origin": {"const": "https://finance.ynxweb4.com"},
    "platform": {"const": "web"},
    "chainId": {"const": "0x1917"},
    "chainEnvironment": {"const": "testnet"},
    "tradingEnvironment": {"const": "sandbox"},
    "provider": {"const": "alpaca_broker"},
    "account": {"type": "string", "pattern": "^ynx1[023456789acdefghjklmnpqrstuvwxyz]{38}$"},
    "accountPublicKey": {"type": "string", "pattern": "^(02|03)[0-9a-f]{64}$"},
    "subjectId": {"type": "string", "pattern": "^subject_[0-9a-f]{64}$"},
    "brokerAccountId": {"$ref": "#/$defs/providerUuid"},
    "requestId": {"type": "string", "pattern": "^request_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "callbackStateHash": {"$ref": "#/$defs/hash"},
    "challengeId": {"type": "string", "pattern": "^challenge_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "nonce": {"$ref": "#/$defs/uuid"},
    "issuedAt": {"$ref": "#/$defs/timestamp"},
    "expiresAt": {"$ref": "#/$defs/timestamp"},
    "orderHash": {"$ref": "#/$defs/hash"},
    "signature": {"type": "string", "pattern": "^[0-9a-f]{128}$"},
    "order": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetClass", "assetId", "currency", "extendedHours", "feeBoundSource", "limitPrice", "maxCost", "maxFee", "orderId", "orderType", "qty", "side", "symbol", "timeInForce"],
      "properties": {
        "orderId": {"$ref": "#/$defs/uuid"},
        "assetId": {"$ref": "#/$defs/providerUuid"},
        "symbol": {"type": "string", "pattern": "^[A-Z][A-Z0-9.]{0,11}$"},
        "assetClass": {"const": "us_equity"},
        "side": {"enum": ["buy", "sell"]},
        "qty": {"type": "string", "pattern": "^(?:[1-9][0-9]{0,5}|1000000)$"},
        "orderType": {"const": "limit"},
        "limitPrice": {"$ref": "#/$defs/price"},
        "currency": {"const": "USD"},
        "maxCost": {"$ref": "#/$defs/money"},
        "maxFee": {"$ref": "#/$defs/money"},
        "feeBoundSource": {"enum": ["provider_quote", "provider_current_schedule", "operator_policy"]},
        "timeInForce": {"const": "day"},
        "extendedHours": {"const": false}
      }
    }
  },
  "$defs": {
    "unsigned": {
      "type": "object",
      "additionalProperties": false,
      "required": ["account", "accountPublicKey", "applicationId", "brokerAccountId", "callbackStateHash", "chainEnvironment", "chainId", "challengeId", "expiresAt", "issuedAt", "nonce", "order", "orderHash", "origin", "platform", "productId", "provider", "requestId", "subjectId", "tradingEnvironment", "version"],
      "properties": {
        "version": {"const": "1"}, "productId": {"const": "finance"}, "applicationId": {"const": "com.ynxweb4.finance.web"}, "origin": {"const": "https://finance.ynxweb4.com"}, "platform": {"const": "web"}, "chainId": {"const": "0x1917"}, "chainEnvironment": {"const": "testnet"}, "tradingEnvironment": {"const": "sandbox"}, "provider": {"const": "alpaca_broker"},
        "account": {"type": "string", "pattern": "^ynx1[023456789acdefghjklmnpqrstuvwxyz]{38}$"}, "accountPublicKey": {"type": "string", "pattern": "^(02|03)[0-9a-f]{64}$"}, "subjectId": {"type": "string", "pattern": "^subject_[0-9a-f]{64}$"}, "brokerAccountId": {"$ref": "#/$defs/providerUuid"}, "requestId": {"type": "string", "pattern": "^request_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "callbackStateHash": {"$ref": "#/$defs/hash"}, "challengeId": {"type": "string", "pattern": "^challenge_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "nonce": {"$ref": "#/$defs/uuid"}, "issuedAt": {"$ref": "#/$defs/timestamp"}, "expiresAt": {"$ref": "#/$defs/timestamp"}, "orderHash": {"$ref": "#/$defs/hash"},
        "order": {"$ref": "#/$defs/order"}
      }
    },
    "order": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetClass", "assetId", "currency", "extendedHours", "feeBoundSource", "limitPrice", "maxCost", "maxFee", "orderId", "orderType", "qty", "side", "symbol", "timeInForce"],
      "properties": {
        "orderId": {"$ref": "#/$defs/uuid"}, "assetId": {"$ref": "#/$defs/providerUuid"}, "symbol": {"type": "string", "pattern": "^[A-Z][A-Z0-9.]{0,11}$"}, "assetClass": {"const": "us_equity"}, "side": {"enum": ["buy", "sell"]}, "qty": {"type": "string", "pattern": "^(?:[1-9][0-9]{0,5}|1000000)$"}, "orderType": {"const": "limit"}, "limitPrice": {"$ref": "#/$defs/price"}, "currency": {"const": "USD"}, "maxCost": {"$ref": "#/$defs/money"}, "maxFee": {"$ref": "#/$defs/money"}, "feeBoundSource": {"enum": ["provider_quote", "provider_current_schedule", "operator_policy"]}, "timeInForce": {"const": "day"}, "extendedHours": {"const": false}
      }
    },
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "providerUuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "price": {"type": "string", "pattern": "^(?:0\\.[0-9]{0,3}[1-9]|[1-9][0-9]{0,8}(?:\\.[0-9]{0,3}[1-9])?)$"},
    "money": {"type": "string", "pattern": "^(?:0|0\\.[0-9]{0,5}[1-9]|[1-9][0-9]{0,12}(?:\\.[0-9]{0,5}[1-9])?)$"}
  }
}
