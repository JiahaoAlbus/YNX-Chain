{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ynxweb4.com/schemas/finance-order-approval-v1.transport.schema.json",
  "title": "YNX Finance Broker Sandbox order approval transport v1",
  "oneOf": [
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/approved"},
    {"$ref": "#/$defs/rejected"},
    {"$ref": "#/$defs/revoked"}
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "requestId": {"type": "string", "pattern": "^request_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "account": {"type": "string", "pattern": "^ynx1[023456789acdefghjklmnpqrstuvwxyz]{38}$"},
    "publicKey": {"type": "string", "pattern": "^(02|03)[0-9a-f]{64}$"},
    "signature": {"type": "string", "pattern": "^[0-9a-f]{128}$"},
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "route", "unsigned", "version"],
      "properties": {
        "kind": {"const": "finance_order_approval_request"},
        "route": {"const": "ynxwallet://finance-order-approval"},
        "unsigned": {"$ref": "finance-order-approval-v1.schema.json#/$defs/unsigned"},
        "version": {"const": "1"}
      }
    },
    "approved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approval", "callbackStateHash", "kind", "requestId", "status", "version"],
      "properties": {
        "approval": {"$ref": "finance-order-approval-v1.schema.json"},
        "callbackStateHash": {"$ref": "#/$defs/hash"},
        "kind": {"const": "finance_order_approval_result"},
        "requestId": {"$ref": "#/$defs/requestId"},
        "status": {"const": "approved"},
        "version": {"const": "1"}
      }
    },
    "rejected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["callbackStateHash", "kind", "reason", "requestId", "status", "version"],
      "properties": {
        "callbackStateHash": {"$ref": "#/$defs/hash"},
        "kind": {"const": "finance_order_approval_result"},
        "reason": {"const": "USER_REJECTED"},
        "requestId": {"$ref": "#/$defs/requestId"},
        "status": {"const": "rejected"},
        "version": {"const": "1"}
      }
    },
    "revocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["account", "accountPublicKey", "approvalDigest", "reason", "requestId", "revokedAt", "signature", "version"],
      "properties": {
        "account": {"$ref": "#/$defs/account"},
        "accountPublicKey": {"$ref": "#/$defs/publicKey"},
        "approvalDigest": {"$ref": "#/$defs/hash"},
        "reason": {"const": "USER_REVOKED"},
        "requestId": {"$ref": "#/$defs/requestId"},
        "revokedAt": {"$ref": "#/$defs/timestamp"},
        "signature": {"$ref": "#/$defs/signature"},
        "version": {"const": "1"}
      }
    },
    "revoked": {
      "type": "object",
      "additionalProperties": false,
      "required": ["callbackStateHash", "kind", "requestId", "revocation", "status", "version"],
      "properties": {
        "callbackStateHash": {"$ref": "#/$defs/hash"},
        "kind": {"const": "finance_order_approval_result"},
        "requestId": {"$ref": "#/$defs/requestId"},
        "revocation": {"$ref": "#/$defs/revocation"},
        "status": {"const": "revoked"},
        "version": {"const": "1"}
      }
    }
  }
}
