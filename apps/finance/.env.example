YNX_FINANCE_LISTEN=127.0.0.1:6436
# Production and all activation tooling use one exact absolute path. A relative
# path is suitable only for an isolated local development server.
YNX_FINANCE_STATE_PATH=./var/finance/state.json
# YNX_FINANCE_DATABASE_URL=postgres://finance:secret@db.internal/finance?sslmode=require
YNX_FINANCE_WEB_DIR=apps/finance/web
YNX_FINANCE_WALLET_GATEWAY_URL=http://127.0.0.1:8787
YNX_FINANCE_INTERNAL_KEY=replace-with-at-least-32-bytes-from-secret-manager
YNX_FINANCE_ALLOWED_ORIGINS=http://127.0.0.1:6436
YNX_EXPLORER_URL=http://127.0.0.1:6427
YNX_PAY_URL=http://127.0.0.1:6425
YNX_PAY_API_KEY=replace-with-pay-read-key
YNX_AI_GATEWAY_URL=http://127.0.0.1:6431
YNX_AI_GATEWAY_KEY=replace-with-finance-ai-scope-key
YNX_FINANCE_HELP_URL=https://ynxweb4.com/support
YNX_FINANCE_PRIVACY_URL=https://ynxweb4.com/privacy
YNX_FINANCE_DISPUTE_URL=https://ynxweb4.com/support/disputes

# Server-only Alpaca BROKER Sandbox; never a personal Trading/Paper account.
# Missing credentials disable this module, not existing Finance.
YNX_CHAIN_ENV=testnet
YNX_EVM_CHAIN_ID=6423
FINANCE_TRADING_ENV=sandbox
FINANCE_BROKER_PROVIDER=alpaca_broker
FINANCE_TRADING_ENABLED=false
FINANCE_LIVE_ENABLED=false
FINANCE_SANDBOX_WRITES_ENABLED=false
# Set only with the reviewed 64-hex activation receipt when enabling writes:
# FINANCE_SANDBOX_WRITE_ACTIVATION_RECEIPT_SHA256=
# Owner whose persistent Sandbox mapping is checked by finance:doctor -- --network-read-only
# and finance:sandbox:activation-plan -- --local-read-only:
YNX_FINANCE_BROKER_VERIFY_ACCOUNT=
# Canonical server-side fee inputs required before /api/broker/challenges can create a review request:
YNX_FINANCE_BROKER_MAX_FEE_USD=1
YNX_FINANCE_BROKER_FEE_BOUND_SOURCE=operator_policy
YNX_FINANCE_BROKER_FEE_EVIDENCE_REF=operator-policy:replace-with-reviewed-reference
ALPACA_BROKER_SANDBOX_BASE_URL=https://broker-api.sandbox.alpaca.markets
ALPACA_BROKER_TOKEN_URL=https://authx.sandbox.alpaca.markets/v1/oauth2/token
ALPACA_MARKET_DATA_SANDBOX_BASE_URL=https://data.sandbox.alpaca.markets
FINANCE_BROKER_READ_RATE_PER_MINUTE=180
FINANCE_BROKER_WRITE_RATE_PER_MINUTE=30
FINANCE_MARKET_DATA_RATE_PER_MINUTE=180
# Graceful shutdown admission drain deadline. The server rejects new business
# requests immediately and waits up to this many seconds for admitted requests.
YNX_FINANCE_SHUTDOWN_TIMEOUT_SECONDS=30
ALPACA_BROKER_AUTH_MODE=client_credentials
ALPACA_BROKER_CLIENT_ID=
ALPACA_BROKER_CLIENT_SECRET=
# Only for explicitly provisioned legacy_basic broker credentials:
ALPACA_BROKER_API_KEY=
ALPACA_BROKER_API_SECRET=
# No global account ID. Each authenticated user needs a persistent owned mapping.
