{
  "name": "@ynx/finance-web-wallet",
  "private": true,
  "type": "module",
  "scripts": {
    "build:wallet": "esbuild wallet-auth-entry.js --bundle --minify --platform=browser --target=es2022 --outfile=wallet-auth.js",
