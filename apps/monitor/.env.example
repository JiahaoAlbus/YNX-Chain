YNX_MONITOR_PORT=4675
YNX_MONITOR_SESSION_SECRET=
# JSON array: [{"username":"name","role":"viewer|operator","passwordHash":"scrypt hex"}]
YNX_MONITOR_USERS=
YNX_MONITOR_STATE_PATH=tmp/monitor/state.json
YNX_MONITOR_STATE_INTEGRITY_KEY=
YNX_MONITOR_RPC_URL=http://127.0.0.1:6420
YNX_MONITOR_EXPLORER_URL=http://127.0.0.1:6427
YNX_MONITOR_INDEXER_URL=http://127.0.0.1:6426
YNX_MONITOR_AI_URL=http://127.0.0.1:6429
# Server-side only. Enables advisory incident summaries.
YNX_MONITOR_AI_KEY=
# Central Gateway wallet verification. Roles are assigned only by this server.
YNX_MONITOR_PUBLIC_ORIGIN=http://127.0.0.1:4675
YNX_MONITOR_WALLET_AUTH_URL=
YNX_MONITOR_WALLET_AUTH_KEY=
# JSON object, e.g. {"ynx1address":"viewer"}
YNX_MONITOR_WALLET_ROLES={}
# JSON object of safe names to local file paths, for example {"chain":"/var/log/ynx/chain.log"}
YNX_MONITOR_LOG_SOURCES={}
# Public HTTPS-only JSON array. Each item has id, name, kind, url and optional
# versionUrl / expectedEvmChainId. For any service expected to be bound to the
# canonical testnet, also set expectedChainId=6423,
# expectedCosmosChainId=ynx_6423-1 and expectedNativeSymbol=YNXT. A missing or
# wrong configured identity fails closed; it is never shown as a healthy chain.
# When unset, /connectivity reports not_configured rather than inventing an
# Offline result.
YNX_MONITOR_P0_CONNECTIVITY_PROBES=[]
