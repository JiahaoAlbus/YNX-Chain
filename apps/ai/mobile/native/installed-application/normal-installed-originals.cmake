# Original A adds this source to its already selected single final image.
# This file creates no library, runtime, provider, or duplicate application6.
function(ynx_ai_add_p08_ios_install_loan selected_target)
  if(NOT TARGET "${selected_target}")
    message(FATAL_ERROR "Original A selected target must already exist")
  endif()
  if(NOT CMAKE_SYSTEM_NAME STREQUAL "iOS")
    message(FATAL_ERROR "P08 installed application loan currently supports iOS only")
  endif()
  get_target_property(already "${selected_target}" YNX_P08_INSTALLED_LOAN)
  if(already)
    message(FATAL_ERROR "P08 installed application loan may be composed only once")
  endif()
  target_sources("${selected_target}" PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/InstalledApplicationOriginal.ios.mm")
  set_source_files_properties("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/InstalledApplicationOriginal.ios.mm" PROPERTIES COMPILE_FLAGS "-fobjc-arc")
  target_compile_features("${selected_target}" PRIVATE cxx_std_20)
  target_include_directories("${selected_target}" PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../contracts/sdk-mobile-application-v6")
  target_link_libraries("${selected_target}" PRIVATE "-framework Foundation")
  set_target_properties("${selected_target}" PROPERTIES YNX_P08_INSTALLED_LOAN TRUE)
endfunction()
