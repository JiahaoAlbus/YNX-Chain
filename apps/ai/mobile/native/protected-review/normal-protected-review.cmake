# A composes the owning UI once into the already selected matching image.
function(ynx_ai_add_p08_ios_protected_review selected_target)
  if(NOT TARGET "${selected_target}" OR NOT CMAKE_SYSTEM_NAME STREQUAL "iOS")
    message(FATAL_ERROR "Original A existing iOS selected target required")
  endif()
  get_target_property(already "${selected_target}" YNX_P08_PROTECTED_REVIEW)
  if(already)
    message(FATAL_ERROR "P08 UI7 must be composed only once")
  endif()
  target_sources("${selected_target}" PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/OriginalProtectedReview.ios.mm")
  set_source_files_properties("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/OriginalProtectedReview.ios.mm" PROPERTIES COMPILE_FLAGS "-fobjc-arc")
  target_compile_features("${selected_target}" PRIVATE cxx_std_20)
  target_include_directories("${selected_target}" PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../contracts/mobile-protected-review" "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../contracts/sdk-mobile-application-v6")
  target_link_libraries("${selected_target}" PRIVATE "-framework UIKit" "-framework Foundation")
  set_target_properties("${selected_target}" PROPERTIES YNX_P08_PROTECTED_REVIEW TRUE)
endfunction()

function(ynx_ai_add_p08_android_protected_review selected_target)
  if(NOT TARGET "${selected_target}" OR NOT ANDROID)
    message(FATAL_ERROR "Original A existing Android selected target required")
  endif()
  get_target_property(already "${selected_target}" YNX_P08_PROTECTED_REVIEW)
  if(already)
    message(FATAL_ERROR "P08 UI7 must be composed only once")
  endif()
  target_sources("${selected_target}" PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/OriginalProtectedReview.android.cpp")
  target_compile_features("${selected_target}" PRIVATE cxx_std_20)
  target_include_directories("${selected_target}" PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../contracts/mobile-protected-review" "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../contracts/sdk-mobile-application-v6")
  set_target_properties("${selected_target}" PROPERTIES YNX_P08_PROTECTED_REVIEW TRUE)
endfunction()
