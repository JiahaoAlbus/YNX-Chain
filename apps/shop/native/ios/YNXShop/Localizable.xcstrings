        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원래 결제 내역이 불완전합니다. 새로고침만 하고 재전송하지 마세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial original está incompleto. Solo actualiza; no reenvíes."
          }
        },
