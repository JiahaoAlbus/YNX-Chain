          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Convites de membros ainda não estão disponíveis aqui. Os membros atuais são lidos da loja."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приглашение участников здесь пока недоступно. Текущие участники загружаются из записей магазина."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دعوات الأعضاء غير متاحة هنا بعد. تتم قراءة العضويات الحالية من المتجر."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Undangan anggota belum tersedia di sini. Keanggotaan saat ini dibaca dari toko."
          }
        }
      }
    },
    "seller_network_fee_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Network-fee amounts are not supplied here and are not included in the displayed principal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
