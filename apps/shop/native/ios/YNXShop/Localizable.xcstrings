    "seller_finance_read_only": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read-only payment records. No payout or refund transfer is performed here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支付记录仅供读取。此处不执行提现或退款转账。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "付款記錄僅供讀取。此處不執行提領或退款轉帳。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支払い記録は読み取り専用です。ここでは出金や返金送金を実行しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결제 기록은 읽기 전용입니다. 여기서는 출금이나 환불 이체를 실행하지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registros de pago de solo lectura. Aquí no se realizan retiros ni transferencias de reembolso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrements de paiement en lecture seule. Aucun retrait ni transfert de remboursement n’est effectué ici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahlungsdatensätze sind schreibgeschützt. Hier werden keine Auszahlungen oder Erstattungstransfers ausgeführt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Registros de pagamento somente para leitura. Nenhum saque ou transferência de reembolso é feito aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записи платежей доступны только для чтения. Выплаты и переводы возврата здесь не выполняются."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجلات الدفع للقراءة فقط. لا يتم هنا تنفيذ سحب أو تحويل مبالغ مستردة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catatan pembayaran hanya baca. Penarikan atau transfer pengembalian dana tidak dilakukan di sini."
          }
        }
      }
    },
    "seller_fulfillment_boundary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shipment records describe fulfillment. They do not verify payment or transfer funds."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发货记录仅表示履约状态，不证明收款，也不转移资金。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "出貨記錄僅表示履約狀態，不證明收款，也不轉移資金。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "発送記録は配送状況を示します。入金の確認や資金移動は行いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "발송 기록은 이행 상태를 나타냅니다. 결제를 검증하거나 자금을 이체하지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los registros de envío describen la preparación del pedido. No verifican pagos ni transfieren fondos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les enregistrements d’expédition décrivent la livraison. Ils ne vérifient pas le paiement et ne transfèrent aucun fonds."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versanddatensätze beschreiben die Abwicklung. Sie bestätigen keine Zahlung und übertragen keine Mittel."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Registros de envio descrevem a entrega. Não verificam pagamentos nem transferem fundos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записи отправки отражают исполнение заказа. Они не подтверждают оплату и не переводят средства."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصف سجلات الشحن تنفيذ الطلب. وهي لا تتحقق من الدفع ولا تحول الأموال."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catatan pengiriman menjelaskan pemenuhan pesanan. Catatan ini tidak memverifikasi pembayaran atau mentransfer dana."
          }
        }
      }
    },
    "seller_inventory_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Total stock includes reserved units. Available stock is total minus reserved; adjustments cannot reduce stock below reservations."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "库存总量包含已预留数量。可售库存为总量减去预留；调整后总量不可低于预留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "庫存總量包含已預留數量。可售庫存為總量減去預留；調整後總量不可低於預留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "総在庫には引当済み分を含みます。販売可能在庫は総在庫から引当分を引いた数で、引当数を下回る調整はできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "총 재고에는 예약 수량이 포함됩니다. 판매 가능 재고는 총 재고에서 예약 수량을 뺀 값이며 예약 수량보다 적게 조정할 수 없습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El stock total incluye las unidades reservadas. El disponible es el total menos las reservas; no se puede reducir por debajo de ellas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le stock total inclut les unités réservées. Le stock disponible est le total moins les réservations ; le total ne peut pas être inférieur aux réservations."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Gesamtbestand enthält reservierte Einheiten. Verfügbar ist Gesamtbestand minus Reservierungen; er darf nicht unter die Reservierungen gesenkt werden."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O estoque total inclui unidades reservadas. O disponível é o total menos as reservas; não pode ser reduzido abaixo delas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Общий запас включает резерв. Доступный запас равен общему минус резерв; общий запас нельзя снизить ниже резерва."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشمل إجمالي المخزون الوحدات المحجوزة. المتاح هو الإجمالي ناقص المحجوز؛ ولا يمكن خفض الإجمالي عن المحجوز."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Total stok mencakup unit yang dicadangkan. Stok tersedia adalah total dikurangi cadangan; total tidak boleh lebih rendah dari cadangan."
          }
        }
      }
    },
    "seller_member_invite_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Member invitations are not available here yet. Current memberships are read from the store."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
