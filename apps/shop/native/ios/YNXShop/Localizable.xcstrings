    "order_input_required": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a rating from 1 to 5, or enter a reason. Reason: up to 1000 UTF-8 bytes; details: up to 5000."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择 1 至 5 分，或填写原因。原因最多 1000 个 UTF-8 字节，说明最多 5000 个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇 1 至 5 分，或填寫原因。原因最多 1000 個 UTF-8 位元組，說明最多 5000 個。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1〜5の評価を選択するか、理由を入力してください。理由はUTF-8で1000バイト、詳細は5000バイトまで。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1~5점의 평점을 선택하거나 사유를 입력하세요. 사유는 UTF-8 1000바이트, 상세 내용은 5000바이트까지 가능합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una calificación de 1 a 5 o escribe un motivo. Motivo: hasta 1000 bytes UTF-8; detalles: hasta 5000."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une note de 1 à 5 ou saisissez un motif. Motif : 1000 octets UTF-8 maximum ; détails : 5000."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie eine Bewertung von 1 bis 5 oder geben Sie einen Grund ein. Grund: maximal 1000 UTF-8-Bytes; Details: maximal 5000."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma avaliação de 1 a 5 ou informe um motivo. Motivo: até 1000 bytes UTF-8; detalhes: até 5000."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите оценку от 1 до 5 или укажите причину. Причина: до 1000 байт UTF-8; подробности: до 5000."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر تقييماً من 1 إلى 5 أو أدخل السبب. السبب: حتى 1000 بايت UTF-8؛ التفاصيل: حتى 5000."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih penilaian 1 sampai 5 atau isi alasan. Alasan: maksimal 1000 byte UTF-8; rincian: maksimal 5000."
          }
        }
      }
    },
    "order_request_pending": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An earlier request for this order is still unconfirmed. Keep the original request before making another change."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此订单先前的请求尚未确认。请保留原请求，再处理新的更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此訂單先前的請求尚未確認。請保留原請求，再處理新的變更。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この注文の以前のリクエストは未確認です。別の変更を行う前に、元のリクエストを保持してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 주문의 이전 요청이 아직 확인되지 않았습니다. 다른 변경을 하기 전에 원래 요청을 보존하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una solicitud anterior de este pedido sigue sin confirmar. Conserva la solicitud original antes de realizar otro cambio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une demande précédente pour cette commande reste non confirmée. Conservez la demande initiale avant toute autre modification."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine frühere Anfrage zu dieser Bestellung ist noch unbestätigt. Bewahren Sie die ursprüngliche Anfrage vor einer weiteren Änderung auf."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma solicitação anterior deste pedido ainda não foi confirmada. Preserve a solicitação original antes de fazer outra alteração."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предыдущий запрос по этому заказу ещё не подтверждён. Сохраните исходный запрос, прежде чем вносить другое изменение."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم تأكيد طلب سابق لهذا الطلب بعد. احتفظ بالطلب الأصلي قبل إجراء تغيير آخر."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan sebelumnya untuk pesanan ini belum dikonfirmasi. Simpan permintaan asli sebelum membuat perubahan lain."
          }
        }
      }
    },
