    "native_history_pending": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original payment history is incomplete. Refresh only; do not resend."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原付款历史尚未完整。请仅刷新，不要重发。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原付款歷史尚未完整。請僅重新整理，不要重送。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の支払い履歴が未完了です。更新のみ行い、再送しないでください。"
