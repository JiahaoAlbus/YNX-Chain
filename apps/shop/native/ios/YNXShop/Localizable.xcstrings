    "seller_audit_scope": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account audit log. Each row retains the original object reference."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账户审计日志；每条记录保留原对象引用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帳戶稽核記錄；每筆記錄保留原物件參照。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントの監査ログです。各記録に元の対象参照を保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 감사 기록입니다. 각 기록은 원래 대상 참조를 유지합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registro de auditoría de la cuenta. Cada fila conserva la referencia al objeto original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Journal d’audit du compte. Chaque ligne conserve la référence à l’objet d’origine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfprotokoll des Kontos. Jede Zeile enthält die ursprüngliche Objektreferenz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Registro de auditoria da conta. Cada linha mantém a referência ao objeto original."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Журнал аудита учётной записи. Каждая запись сохраняет ссылку на исходный объект."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجل تدقيق الحساب. يحتفظ كل سجل بمرجع الكائن الأصلي."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Log audit akun. Setiap baris mempertahankan referensi objek asli."
          }
        }
      }
    },
    "seller_authority_boundary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seller uses a separate Wallet connection and the store’s current permissions. Buyer access does not grant Seller rights."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "商家使用独立的 Wallet 连接与店铺当前权限。买家权限不授予商家操作权。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "商家使用獨立的 Wallet 連線與店鋪目前權限。買家權限不授予商家操作權。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出品者は個別のWallet接続と店舗の現在の権限を使用します。購入者のアクセス権では出品者の操作は許可されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "판매자는 별도의 Wallet 연결과 상점의 현재 권한을 사용합니다. 구매자 접근 권한은 판매자 권한을 부여하지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El vendedor usa una conexión independiente de Wallet y los permisos actuales de la tienda. El acceso de comprador no otorga derechos de vendedor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le vendeur utilise une connexion Wallet distincte et les autorisations actuelles de la boutique. L’accès acheteur ne confère aucun droit vendeur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verkäufer verwenden eine separate Wallet-Verbindung und die aktuellen Shop-Berechtigungen. Käuferzugriff erteilt keine Verkäuferrechte."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O vendedor usa uma conexão separada do Wallet e as permissões atuais da loja. O acesso de comprador não concede direitos de vendedor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продавец использует отдельное подключение Wallet и текущие права магазина. Доступ покупателя не даёт прав продавца."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم البائع اتصال Wallet منفصلاً وأذونات المتجر الحالية. وصول المشتري لا يمنح حقوق البائع."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penjual memakai koneksi Wallet terpisah dan izin toko saat ini. Akses pembeli tidak memberikan hak penjual."
          }
        }
      }
    },
    "seller_check_result": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the current status above. Closing this form does not cancel an operation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请核对上方当前状态。关闭表单不会取消原操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請核對上方目前狀態。關閉表單不會取消原操作。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上記の現在の状態を確認してください。フォームを閉じても操作はキャンセルされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위의 현재 상태를 확인하세요. 양식을 닫아도 작업은 취소되지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta el estado actual arriba. Cerrar este formulario no cancela una operación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez l’état actuel ci-dessus. Fermer ce formulaire n’annule pas une opération."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfen Sie den aktuellen Status oben. Das Schließen dieses Formulars bricht keinen Vorgang ab."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique o estado atual acima. Fechar este formulário não cancela uma operação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте текущее состояние выше. Закрытие формы не отменяет операцию."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من الحالة الحالية أعلاه. إغلاق هذا النموذج لا يلغي العملية."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Periksa status saat ini di atas. Menutup formulir tidak membatalkan operasi."
          }
        }
      }
    },
    "seller_confirm_revoke": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I understand this removes the member’s role in this store."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我理解此操作将撤销该成员在本店的角色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我理解此操作將撤銷該成員在本店的角色。"
          }
