          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비교 초안 생성을 위해 위의 공개 상품 요약을 제공하는 데 동의합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acepto compartir el resumen público de productos anterior para generar un borrador de comparación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J’accepte de partager le résumé public des produits ci-dessus pour générer un brouillon de comparaison."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich stimme zu, die obige öffentliche Produktübersicht zur Erstellung eines Vergleichsentwurfs weiterzugeben."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Concordo em compartilhar o resumo público dos produtos acima para gerar um rascunho de comparação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я согласен передать приведённое выше общедоступное описание товаров для создания черновика сравнения."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوافق على مشاركة ملخص المنتجات العام أعلاه لإنشاء مسودة مقارنة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya setuju membagikan ringkasan produk publik di atas untuk membuat draf perbandingan."
          }
        }
      }
    },
    "agent_disclosure_is_not_grant": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agreement to share public context does not grant spending or payment permission."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同意披露公开上下文不代表授予支出或支付权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同意揭露公開上下文不代表授予支出或付款權限。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公開コンテキストの共有への同意は、支出や支払いの権限を付与しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공개 맥락 제공에 동의해도 지출이나 결제 권한은 부여되지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceptar compartir contexto público no concede permiso para gastar ni pagar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accord de partage du contexte public n’autorise aucune dépense ni aucun paiement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zustimmung zur Weitergabe öffentlichen Kontexts erteilt keine Ausgaben- oder Zahlungsberechtigung."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Concordar em compartilhar contexto público não concede permissão para gastos ou pagamentos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Согласие на передачу общедоступного контекста не даёт разрешения на расходы или платежи."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الموافقة على مشاركة السياق العام لا تمنح إذناً بالإنفاق أو الدفع."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Persetujuan berbagi konteks publik tidak memberikan izin pengeluaran atau pembayaran."
          }
        }
      }
