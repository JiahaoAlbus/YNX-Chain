      }
    },
    "seller_order_states_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Order, payment, shipment and return states are separate. Check the original records for each."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订单、付款、发货和售后状态彼此独立，请分别核对原记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訂單、付款、出貨和售後狀態彼此獨立，請分別核對原記錄。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "注文、支払い、発送、返品の状態はそれぞれ独立しています。各元記録を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주문, 결제, 발송 및 반품 상태는 서로 독립적입니다. 각각의 원래 기록을 확인하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los estados de pedido, pago, envío y devolución son independientes. Consulta cada registro original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les états de commande, paiement, expédition et retour sont distincts. Vérifiez chaque enregistrement d’origine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestell-, Zahlungs-, Versand- und Rückgabestatus sind getrennt. Prüfen Sie jeweils die ursprünglichen Datensätze."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os estados de pedido, pagamento, envio e devolução são separados. Verifique cada registro original."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Состояния заказа, оплаты, отправки и возврата независимы. Проверяйте соответствующие исходные записи."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حالات الطلب والدفع والشحن والإرجاع منفصلة. تحقق من السجلات الأصلية لكل منها."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Status pesanan, pembayaran, pengiriman, dan pengembalian terpisah. Periksa catatan asli masing-masing."
          }
        }
      }
    },
    "seller_publish_boundary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Publishing applies these title, variant, price and stock changes to the original listing. Existing images are kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发布会将以上名称、规格、价格和库存变更应用到原商品，保留现有图片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "發布會將以上名稱、規格、價格和庫存變更套用到原商品，保留現有圖片。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公開すると、元の商品にこの商品名・バリエーション・価格・在庫の変更を適用します。既存画像は保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게시하면 원래 상품에 이름, 옵션, 가격 및 재고 변경이 적용됩니다. 기존 이미지는 유지됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La publicación aplica estos cambios de nombre, variantes, precio y stock a la ficha original. Se conservan las imágenes existentes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La publication applique ces modifications de nom, variantes, prix et stock à la fiche d’origine. Les images existantes sont conservées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Veröffentlichen werden diese Änderungen an Titel, Varianten, Preis und Bestand auf das ursprüngliche Angebot angewendet. Vorhandene Bilder bleiben erhalten."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A publicação aplica as alterações de nome, variantes, preço e estoque ao anúncio original. As imagens existentes são mantidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Публикация применяет изменения названия, вариантов, цены и запаса к исходному товару. Текущие изображения сохраняются."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطبق النشر تغييرات الاسم والخيارات والسعر والمخزون على العرض الأصلي. يتم الاحتفاظ بالصور الحالية."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Publikasi menerapkan perubahan nama, varian, harga, dan stok ke produk asli. Gambar yang ada dipertahankan."
          }
        }
      }
    },
    "seller_refund_boundary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A return approval or refund request does not prove that a refund has completed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同意退货或申请退款不代表退款已完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同意退貨或申請退款不代表退款已完成。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返品の承認や返金の申請は、返金の完了を証明しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "반품 승인이나 환불 요청은 환불 완료를 증명하지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprobar una devolución o solicitar un reembolso no demuestra que el reembolso se haya completado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’approbation d’un retour ou une demande de remboursement ne prouve pas que le remboursement est terminé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine genehmigte Rückgabe oder Erstattungsanfrage beweist keine abgeschlossene Erstattung."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A aprovação de uma devolução ou solicitação de reembolso não comprova que o reembolso foi concluído."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одобрение возврата товара или запрос возврата средств не подтверждает завершение возврата денег."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الموافقة على الإرجاع أو طلب استرداد المبلغ لا يثبت اكتمال رد المبلغ."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Persetujuan pengembalian barang atau permintaan pengembalian dana tidak membuktikan pengembalian dana telah selesai."
          }
        }
      }
    },
    "seller_return_boundary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This decides only the original return request. It does not receive goods, restock inventory or transfer refund funds."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作仅决定原退货申请，不登记收货、不回补库存，也不转移退款资金。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作僅決定原退貨申請，不登記收貨、不回補庫存，也不轉移退款資金。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の返品申請に対する判断のみを行います。返品の受領、在庫への戻し、返金送金は行いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 동작은 원래 반품 요청만 결정합니다. 반품 수령, 재고 복구 또는 환불 이체는 실행하지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo decide la solicitud de devolución original. No recibe mercancías, repone stock ni transfiere reembolsos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action décide uniquement de la demande de retour d’origine. Elle ne réceptionne pas de marchandises, ne réapprovisionne pas le stock et ne transfère aucun remboursement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies entscheidet nur über die ursprüngliche Rückgabeanfrage. Es erfasst keinen Wareneingang, erhöht keinen Bestand und überweist keine Erstattung."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ação decide apenas a solicitação de devolução original. Não recebe mercadorias, repõe estoque nem transfere reembolsos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это решение только по исходному запросу возврата товара. Оно не регистрирует получение товара, не пополняет запас и не переводит возврат средств."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرر هذا الإجراء طلب الإرجاع الأصلي فقط. لا يسجل استلام البضائع ولا يعيدها للمخزون ولا يحول مبالغ مستردة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini hanya memutuskan permintaan pengembalian barang asli. Tidak menerima barang, menambah stok, atau mentransfer dana pengembalian."
          }
        }
      }
    },
    "seller_revoke_warning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes the role in this store. Wallet session revocation is tracked separately and may remain unconfirmed; check the original revocation record."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作撤销本店角色。Wallet 会话撤销单独跟踪，可能仍未确认；请核对原撤销记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作撤銷本店角色。Wallet 工作階段撤銷單獨追蹤，可能仍未確認；請核對原撤銷記錄。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この店舗での役割を取り消します。Walletセッションの失効は別に追跡され、未確認の場合があります。元の取消記録を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 상점의 역할을 취소합니다. Wallet 세션 취소는 별도로 추적되며 미확인 상태일 수 있습니다. 원래 취소 기록을 확인하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se elimina el rol en esta tienda. La revocación de sesiones Wallet se sigue por separado y puede seguir sin confirmar; consulta el registro original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action retire le rôle dans cette boutique. La révocation des sessions Wallet est suivie séparément et peut rester non confirmée ; vérifiez l’enregistrement d’origine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies entfernt die Rolle in diesem Shop. Der Widerruf von Wallet-Sitzungen wird separat verfolgt und kann unbestätigt bleiben. Prüfen Sie den ursprünglichen Widerrufsdatensatz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ação remove a função nesta loja. A revogação de sessões Wallet é acompanhada separadamente e pode continuar sem confirmação; verifique o registro original."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это удаляет роль в этом магазине. Отзыв сеансов Wallet отслеживается отдельно и может остаться неподтверждённым; проверьте исходную запись отзыва."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل هذا الإجراء الدور في هذا المتجر. يتم تتبع إلغاء جلسات Wallet بشكل منفصل وقد يظل غير مؤكد؛ تحقق من سجل الإلغاء الأصلي."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini menghapus peran di toko ini. Pencabutan sesi Wallet dilacak terpisah dan mungkin belum terkonfirmasi; periksa catatan pencabutan asli."
          }
        }
      }
    },
    "seller_section_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This section is currently unavailable. Refresh or check the current store connection and permissions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此区域当前不可用。请刷新，或核对当前店铺连接与权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此區域目前無法使用。請重新整理，或核對目前店鋪連線與權限。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このセクションは現在利用できません。更新するか、店舗の接続と権限を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 영역은 현재 사용할 수 없습니다. 새로고침하거나 현재 상점 연결과 권한을 확인하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta sección no está disponible. Actualiza o comprueba la conexión y los permisos de la tienda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette section est indisponible. Actualisez ou vérifiez la connexion et les autorisations de la boutique."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Bereich ist derzeit nicht verfügbar. Aktualisieren Sie oder prüfen Sie die Shop-Verbindung und Berechtigungen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta seção está indisponível. Atualize ou verifique a conexão e as permissões da loja."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Раздел сейчас недоступен. Обновите данные или проверьте подключение и права магазина."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا القسم غير متاح حالياً. حدّث البيانات أو تحقق من اتصال المتجر وأذوناته."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagian ini belum tersedia. Segarkan atau periksa koneksi dan izin toko saat ini."
          }
        }
      }
    },
    "seller_settlement_scope": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only records linked to this store’s visible original invoices are shown."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅显示与本店当前可见原发票关联的记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅顯示與本店目前可見原發票關聯的記錄。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この店舗で現在表示可能な元の請求書に紐づく記録のみを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 상점에서 현재 조회 가능한 원래 청구서와 연결된 기록만 표시합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se muestran registros vinculados a las facturas originales visibles de esta tienda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les enregistrements liés aux factures d’origine visibles de cette boutique sont affichés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es werden nur Datensätze angezeigt, die mit sichtbaren ursprünglichen Rechnungen dieses Shops verknüpft sind."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente registros vinculados às faturas originais visíveis desta loja são exibidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показаны только записи, связанные с видимыми исходными счетами этого магазина."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر فقط السجلات المرتبطة بالفواتير الأصلية المرئية لهذا المتجر."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya catatan yang terkait dengan faktur asli yang terlihat dari toko ini yang ditampilkan."
          }
        }
      }
    },
    "seller_store_edit_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Store profile and payout settings are read only here. No address change is submitted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此处店铺资料与收款设置仅供读取，不提交地址变更。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此處店鋪資料與收款設定僅供讀取，不提交地址變更。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "店舗情報と受取設定はここでは読み取り専用です。アドレス変更は送信しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상점 정보와 수취 설정은 읽기 전용입니다. 주소 변경은 제출되지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El perfil y los ajustes de cobro son de solo lectura aquí. No se envía ningún cambio de dirección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le profil et les paramètres de versement sont en lecture seule ici. Aucun changement d’adresse n’est envoyé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Shop-Profil und Auszahlungseinstellungen sind hier schreibgeschützt. Es wird keine Adressänderung gesendet."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O perfil e as configurações de recebimento são somente para leitura. Nenhuma alteração de endereço é enviada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Профиль магазина и настройки получения доступны только для чтения. Изменение адреса не отправляется."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملف المتجر وإعدادات الاستلام للقراءة فقط هنا. لا يتم إرسال أي تغيير للعنوان."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil toko dan pengaturan penerimaan hanya baca di sini. Perubahan alamat tidak dikirim."
          }
        }
      }
    },
    "seller_unknown_warning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not treat an unconfirmed result as payment received. Check the original payment records before fulfilling an order."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果未确认时，不可按已收款处理；履约前请核对原支付记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結果未確認時，不可按已收款處理；履約前請核對原付款記錄。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未確認の結果を入金済みとして扱わないでください。発送前に元の支払い記録を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미확인 결과를 입금 완료로 취급하지 마세요. 주문 이행 전에 원래 결제 기록을 확인하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No trates un resultado sin confirmar como pago recibido. Consulta los registros originales antes de preparar el pedido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne considérez pas un résultat non confirmé comme un paiement reçu. Vérifiez les enregistrements d’origine avant d’expédier la commande."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behandeln Sie unbestätigte Ergebnisse nicht als Zahlungseingang. Prüfen Sie vor der Abwicklung die ursprünglichen Zahlungsdatensätze."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não trate um resultado não confirmado como pagamento recebido. Verifique os registros originais antes de preparar o pedido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не считайте неподтверждённый результат полученной оплатой. Проверьте исходные платёжные записи перед исполнением заказа."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تعتبر نتيجة غير مؤكدة دفعة مستلمة. تحقق من سجلات الدفع الأصلية قبل تنفيذ الطلب."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jangan anggap hasil yang belum terkonfirmasi sebagai pembayaran diterima. Periksa catatan pembayaran asli sebelum memenuhi pesanan."
          }
        }
      }
    },
    "seller_change_confirmed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original operation recorded. Refresh to check the current state."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原操作已记录，请刷新核对当前状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原操作已記錄，請重新整理核對目前狀態。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の操作を記録しました。更新して現在の状態を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원래 작업이 기록되었습니다. 새로고침하여 현재 상태를 확인하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Operación original registrada. Actualiza para comprobar el estado actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Opération d’origine enregistrée. Actualisez pour vérifier l’état actuel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ursprünglicher Vorgang erfasst. Aktualisieren Sie, um den aktuellen Status zu prüfen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Operação original registrada. Atualize para verificar o estado atual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исходная операция записана. Обновите данные для проверки текущего состояния."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تسجيل العملية الأصلية. حدّث البيانات للتحقق من الحالة الحالية."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Operasi asli dicatat. Segarkan untuk memeriksa status saat ini."
          }
        }
      }
    },
    "seller_original_prepared": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original request is prepared and has not been sent. Review before submitting it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原请求已准备且尚未发送，请核对后提交原请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原請求已準備且尚未送出，請核對後提交原請求。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のリクエストは準備済みで、まだ送信されていません。確認してから送信してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원래 요청은 준비되었으며 아직 전송되지 않았습니다. 검토한 후 제출하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La solicitud original está preparada y no se ha enviado. Revísala antes de enviarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La demande d’origine est préparée et n’a pas été envoyée. Vérifiez-la avant de l’envoyer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ursprüngliche Anfrage ist vorbereitet und wurde noch nicht gesendet. Prüfen Sie sie vor dem Senden."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A solicitação original está preparada e ainda não foi enviada. Revise antes de enviá-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исходный запрос подготовлен и ещё не отправлен. Проверьте его перед отправкой."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الطلب الأصلي جاهز ولم يتم إرساله بعد. راجعه قبل إرساله."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan asli telah disiapkan dan belum dikirim. Tinjau sebelum mengirimkannya."
          }
        }
      }
    },
    "seller_original_unconfirmed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original operation result is not confirmed. Check the original request; do not create a replacement."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原操作结果未确认，请查询原请求，不要创建替代请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原操作結果未確認，請查詢原請求，不要建立替代請求。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の操作の結果は未確認です。元のリクエストを照会し、代替リクエストを作成しないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원래 작업 결과가 확인되지 않았습니다. 원래 요청을 조회하고 대체 요청을 만들지 마세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resultado original no está confirmado. Consulta la solicitud original; no crees otra que la sustituya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le résultat de l’opération d’origine n’est pas confirmé. Consultez la demande d’origine sans en créer une autre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ergebnis des ursprünglichen Vorgangs ist unbestätigt. Prüfen Sie die ursprüngliche Anfrage; erstellen Sie keinen Ersatz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O resultado da operação original não foi confirmado. Consulte a solicitação original; não crie uma substituta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Результат исходной операции не подтверждён. Проверьте исходный запрос и не создавайте заменяющий."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نتيجة العملية الأصلية غير مؤكدة. تحقق من الطلب الأصلي ولا تنشئ طلباً بديلاً."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasil operasi asli belum terkonfirmasi. Periksa permintaan asli; jangan membuat penggantinya."
          }
        }
      }
    },
