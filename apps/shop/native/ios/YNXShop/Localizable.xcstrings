    "privacy_deleted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Personal Shop data deleted. Terminal orders were pseudonymized; public-chain settlement evidence remains retained."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "个人商城数据已删除。终态订单已去标识化；公开链结算证据继续保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "個人商城資料已刪除。終態訂單已去識別化；公開鏈結算證據繼續保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "個人Shopデータを削除しました。終端注文は仮名化され、公開チェーンの決済証拠は保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인 Shop 데이터가 삭제되었습니다. 종료 주문은 가명 처리되었으며 공개 체인 결제 증거는 유지됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminaron tus datos personales de Shop. Los pedidos terminales se seudonimizaron y se conserva la evidencia de liquidación en cadena pública."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données personnelles Shop ont été supprimées. Les commandes terminales ont été pseudonymisées et la preuve de règlement sur chaîne publique est conservée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Persönliche Shop-Daten wurden gelöscht. Abgeschlossene Bestellungen wurden pseudonymisiert; der Abrechnungsnachweis auf der öffentlichen Chain bleibt erhalten."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados pessoais da Shop foram excluídos. Pedidos terminais foram pseudonimizados e a evidência de liquidação na cadeia pública permanece retida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Персональные данные Shop удалены. Завершённые заказы псевдонимизированы; доказательства расчётов в публичной сети сохранены."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حُذفت بيانات المتجر الشخصية. استُبدلت هوية الطلبات النهائية بمعرّف مستعار، وبقيت أدلة التسوية على السلسلة العامة محفوظة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data pribadi Shop dihapus. Identitas pesanan akhir disamarkan dan bukti penyelesaian pada rantai publik tetap disimpan."
          }
        }
      }
    },
    "privacy_delete_failed": {
      "localizations": {
