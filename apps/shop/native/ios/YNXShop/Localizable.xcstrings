    "seller_native_reconcile_required": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Native payment needs reconciliation. Do not fulfill based on this record."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原生支付需对账，请勿据此记录履约。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原生付款需對帳，請勿據此記錄履約。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネイティブ決済の照合が必要です。この記録に基づいて発送しないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네이티브 결제 대사가 필요합니다. 이 기록을 근거로 주문을 이행하지 마세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pago nativo requiere conciliación. No prepares el pedido basándote en este registro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paiement natif nécessite un rapprochement. N’expédiez pas sur la base de cet enregistrement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die native Zahlung muss abgeglichen werden. Wickeln Sie die Bestellung nicht anhand dieses Datensatzes ab."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O pagamento nativo precisa de conciliação. Não prepare o pedido com base neste registro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нативный платёж требует сверки. Не исполняйте заказ на основании этой записи."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب الدفع الأصلي مطابقة. لا تنفذ الطلب بناءً على هذا السجل."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembayaran native perlu direkonsiliasi. Jangan penuhi pesanan berdasarkan catatan ini."
          }
        }
      }
    },
    "seller_native_receipt_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Validated native receipts are unavailable. Check the original operation; payment is not confirmed here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚无可校验的原生收据。请查询原操作，此处未确认收款。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚無可驗證的原生收據。請查詢原操作，此處未確認收款。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検証可能な領収記録を取得できません。元の操作を確認してください。入金は未確認です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검증 가능한 영수증이 없습니다. 원래 작업을 확인하세요. 결제는 확인되지 않았습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay recibos nativos validados. Consulta la operación original; el pago no está confirmado aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les reçus natifs validés sont indisponibles. Vérifiez l’opération d’origine ; le paiement n’est pas confirmé ici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Validierte native Belege fehlen. Prüfen Sie den ursprünglichen Vorgang; die Zahlung ist hier unbestätigt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibos nativos validados indisponíveis. Consulte a operação original; o pagamento não está confirmado aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверенные нативные квитанции недоступны. Проверьте исходную операцию; оплата здесь не подтверждена."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإيصالات الأصلية المتحقق منها غير متاحة. تحقق من العملية الأصلية؛ الدفع غير مؤكد هنا."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuitansi native tervalidasi tidak tersedia. Periksa operasi asli; pembayaran belum dikonfirmasi di sini."
          }
        }
      }
    },
