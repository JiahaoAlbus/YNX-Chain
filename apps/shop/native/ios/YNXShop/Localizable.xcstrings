    "agent_keys_and_payment_boundary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your private keys stay in Wallet. Any payment requires your separate review and approval in Wallet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "私钥保留在 Wallet 中。任何付款均须在 Wallet 中另行审核并批准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "私鑰保留在 Wallet 中。任何付款均須在 Wallet 中另行審閱並批准。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "秘密鍵はWallet内に保持されます。支払いにはWalletでの個別の確認と承認が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인 키는 Wallet에 보관됩니다. 모든 결제는 Wallet에서 별도로 검토하고 승인해야 합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus claves privadas permanecen en Wallet. Cada pago requiere tu revisión y aprobación por separado en Wallet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos clés privées restent dans Wallet. Tout paiement nécessite votre examen et votre approbation distincts dans Wallet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre privaten Schlüssel bleiben in Wallet. Jede Zahlung erfordert Ihre gesonderte Prüfung und Freigabe in Wallet."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas chaves privadas ficam no Wallet. Qualquer pagamento exige sua revisão e aprovação separadas no Wallet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
