    "agent_disclosure_consent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I agree to share the public product summary above to generate a comparison draft."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
