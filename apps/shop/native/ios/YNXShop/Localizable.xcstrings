    "seller_revision_changed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This product changed after the form was opened. Close the form and reload before reviewing again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此商品在表单打开后已变更。请关闭表单并重新加载后再次核对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此商品在表單開啟後已變更。請關閉表單並重新載入後再次核對。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォームを開いた後に商品が変更されました。フォームを閉じ、再読み込みしてから確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "양식을 연 후 상품이 변경되었습니다. 양식을 닫고 새로 불러온 후 다시 검토하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El producto cambió después de abrir el formulario. Ciérralo y vuelve a cargar antes de revisarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le produit a changé depuis l’ouverture du formulaire. Fermez-le et rechargez avant de vérifier à nouveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Produkt wurde seit dem Öffnen des Formulars geändert. Schließen Sie es und laden Sie die Daten zur erneuten Prüfung neu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O produto mudou após abrir o formulário. Feche e recarregue antes de revisar novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Товар изменился после открытия формы. Закройте форму и обновите данные перед повторной проверкой."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغير هذا المنتج بعد فتح النموذج. أغلق النموذج وأعد التحميل قبل المراجعة مجدداً."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Produk berubah setelah formulir dibuka. Tutup formulir dan muat ulang sebelum meninjau kembali."
          }
        }
      }
    },
