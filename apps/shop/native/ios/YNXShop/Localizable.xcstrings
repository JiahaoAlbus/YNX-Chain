    "seller_native_config_no_conversion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter exact UInt64 integers without signs, decimals or leading zeros. No conversion from the existing price or fees is applied."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请填写精确 UInt64 整数，不带符号、小数或前导零。不从现有价格或费用换算。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請填寫精確 UInt64 整數，不帶符號、小數或前導零。不從現有價格或費用換算。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "符号・小数・先頭の余分な0を付けず、正確なUInt64整数を入力してください。既存の価格や手数料からの換算は行いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부호, 소수점, 앞자리 0 없이 정확한 UInt64 정수를 입력하세요. 기존 가격이나 수수료에서 환산하지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce enteros UInt64 exactos sin signos, decimales ni ceros iniciales. No se convierte el precio ni los cargos existentes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez des entiers UInt64 exacts, sans signe, décimales ni zéros initiaux. Aucun prix ni frais existant n’est converti."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie exakte UInt64-Ganzzahlen ohne Vorzeichen, Dezimalstellen oder führende Nullen ein. Vorhandene Preise oder Gebühren werden nicht umgerechnet."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Insira inteiros UInt64 exatos, sem sinais, decimais ou zeros à esquerda. Não há conversão de preços ou taxas existentes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите точные целые UInt64 без знаков, дробной части и ведущих нулей. Существующие цены и сборы не конвертируются."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل أعداد UInt64 الصحيحة بدقة دون إشارات أو كسور أو أصفار بادئة. لا يتم تحويل الأسعار أو الرسوم الحالية."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan bilangan bulat UInt64 tepat tanpa tanda, desimal, atau nol di depan. Harga atau biaya yang ada tidak dikonversi."
          }
        }
      }
    },
    "seller_native_price_not_configured": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No native price configured for this variant. This affects native invoicing only; the existing price remains separate."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此规格未配置原生价格，仅影响原生开票；现有价格独立保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此規格未設定原生價格，僅影響原生開票；現有價格獨立保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバリエーションのネイティブ価格は未設定です。ネイティブ請求にのみ影響し、既存価格は別に保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 옵션의 네이티브 가격이 설정되지 않았습니다. 네이티브 청구서에만 영향을 주며 기존 가격은 별도로 유지됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta variante no tiene precio nativo. Solo afecta a la facturación nativa; el precio existente se mantiene separado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun prix natif n’est configuré pour cette variante. Seule la facturation native est concernée ; le prix existant reste distinct."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diese Variante ist kein nativer Preis konfiguriert. Dies betrifft nur native Rechnungen; der bestehende Preis bleibt separat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta variante não tem preço nativo configurado. Isso afeta apenas faturas nativas; o preço existente permanece separado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нативная цена варианта не задана. Это влияет только на нативные счета; существующая цена остаётся отдельной."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم تعيين سعر أصلي لهذا الخيار. يؤثر ذلك فقط على الفوترة الأصلية؛ يبقى السعر الحالي منفصلاً."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Harga native untuk varian ini belum diatur. Ini hanya memengaruhi faktur native; harga yang ada tetap terpisah."
          }
        }
      }
    },
    "seller_native_charges_not_configured": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Native shipping and tax are not configured. Explicit native charge values are required for native invoicing; existing fees remain separate."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未配置原生运费和税费。原生开票须明确配置这些值；现有费用独立保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未設定原生運費和稅費。原生開票須明確設定這些值；現有費用獨立保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネイティブの送料と税額は未設定です。ネイティブ請求には明示的な設定が必要で、既存の料金とは別に保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네이티브 배송비와 세금이 설정되지 않았습니다. 네이티브 청구서에는 명시적인 값이 필요하며 기존 비용은 별도로 유지됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El envío y los impuestos nativos no están configurados. La facturación nativa requiere valores explícitos; los cargos existentes siguen separados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La livraison et les taxes natives ne sont pas configurées. La facturation native exige des valeurs explicites ; les frais existants restent distincts."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Native Versand- und Steuerbeträge sind nicht konfiguriert. Native Rechnungen erfordern explizite Werte; bestehende Gebühren bleiben separat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O frete e os impostos nativos não estão configurados. Faturas nativas exigem valores explícitos; as taxas existentes permanecem separadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нативные доставка и налог не заданы. Для нативного счёта нужны явные значения; существующие сборы остаются отдельными."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم تعيين الشحن والضريبة الأصليين. تتطلب الفوترة الأصلية قيماً صريحة؛ تبقى الرسوم الحالية منفصلة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengiriman dan pajak native belum diatur. Faktur native memerlukan nilai eksplisit; biaya yang ada tetap terpisah."
          }
        }
      }
    },
    "native_quote_not_payment": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frozen seller price; this is not a payment receipt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已冻结的卖家价格，此处不是付款回执。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已凍結的賣家價格，此處不是付款回執。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確定済みの販売者価格です。支払い領収書ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확정된 판매자 가격이며 결제 영수증이 아닙니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Precio fijado del vendedor; no es un recibo de pago."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prix vendeur figé ; ceci ne vaut pas reçu de paiement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Festgehaltener Verkäuferpreis; kein Zahlungsbeleg."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Preço fixado do vendedor; não é um recibo de pagamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зафиксированная цена продавца; это не подтверждение оплаты."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سعر البائع المحفوظ؛ هذا ليس إيصال دفع."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Harga penjual yang dibekukan; ini bukan bukti pembayaran."
          }
        }
      }
    }
  },
  "version": "1.0"
