    "shop_checkout_verifies_terms": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a catalog estimate. Final amounts and availability are checked when the order is created."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此为目录估算。创建订单时将核验最终金额与库存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此為目錄估算。建立訂單時將核驗最終金額與庫存。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはカタログからの概算です。注文作成時に最終金額と在庫を確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카탈로그 기준 예상 금액입니다. 주문 생성 시 최종 금액과 재고를 확인합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es una estimación del catálogo. El importe final y la disponibilidad se verifican al crear el pedido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il s’agit d’une estimation du catalogue. Le montant final et la disponibilité sont vérifiés à la création de la commande."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist eine Katalogschätzung. Endbetrag und Verfügbarkeit werden beim Erstellen der Bestellung geprüft."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta é uma estimativa do catálogo. O valor final e a disponibilidade são verificados ao criar o pedido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это оценка по каталогу. Итоговая сумма и наличие проверяются при создании заказа."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا تقدير من الكتالوج. يتم التحقق من المبالغ النهائية والتوفر عند إنشاء الطلب."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini adalah perkiraan katalog. Jumlah akhir dan ketersediaan diperiksa saat pesanan dibuat."
          }
        }
      }
    },
