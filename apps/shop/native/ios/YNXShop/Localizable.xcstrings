          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размер сетевых комиссий здесь не предоставлен и не включён в отображаемую основную сумму."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مبالغ رسوم الشبكة غير متوفرة هنا وليست ضمن المبلغ الأساسي المعروض."
          }
        },
        "id": {
          "stringUnit": {
