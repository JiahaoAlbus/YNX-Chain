        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der ursprüngliche Verlauf ist unvollständig. Nur aktualisieren, nicht erneut senden."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico original está incompleto. Apenas atualize; não reenvie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исходная история неполна. Только обновите, не отправляйте повторно."
