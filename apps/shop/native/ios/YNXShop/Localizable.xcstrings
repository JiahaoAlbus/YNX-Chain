    "privacy_delete_warning": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Active payment, fulfillment, return, refund or dispute workflows must reach a terminal state before deletion. Finalized orders are pseudonymized; authoritative public-chain settlement evidence remains retained."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "付款、履约、退货、退款或争议流程必须进入终态后才能删除。终态订单会被去标识化；权威公开链结算证据继续保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "付款、履約、退貨、退款或爭議流程必須進入終態後才能刪除。終態訂單會去識別化；權威公開鏈結算證據繼續保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支払い、履行、返品、返金、紛争の処理は、削除前に終端状態へ到達する必要があります。終端注文は仮名化され、公開チェーンの決済証拠は保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결제, 이행, 반품, 환불 또는 분쟁 절차가 종료 상태에 도달해야 삭제할 수 있습니다. 종료 주문은 가명 처리되며 공개 체인 결제 증거는 유지됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los procesos activos de pago, preparación, devolución, reembolso o disputa deben alcanzar un estado terminal antes de eliminar. Los pedidos finalizados se seudonimizan; se conserva la evidencia autorizada de liquidación en cadena pública."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les processus actifs de paiement, préparation, retour, remboursement ou litige doivent atteindre un état terminal avant suppression. Les commandes finalisées sont pseudonymisées ; la preuve de règlement officielle sur chaîne publique est conservée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktive Zahlungs-, Erfüllungs-, Rückgabe-, Erstattungs- oder Streitfallabläufe müssen vor dem Löschen einen Endzustand erreichen. Abgeschlossene Bestellungen werden pseudonymisiert; der maßgebliche Abrechnungsnachweis auf der öffentlichen Chain bleibt erhalten."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fluxos ativos de pagamento, atendimento, devolução, reembolso ou disputa devem chegar a um estado terminal antes da exclusão. Pedidos finalizados são pseudonimizados; a evidência oficial de liquidação na cadeia pública permanece retida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Активные процессы оплаты, исполнения, возврата, возмещения или спора должны перейти в конечное состояние до удаления. Завершённые заказы псевдонимизируются; официальный расчётный материал публичной сети сохраняется."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن تصل عمليات الدفع والتنفيذ والإرجاع والاسترداد أو النزاع النشطة إلى حالة نهائية قبل الحذف. تُستبدل هوية الطلبات النهائية بمعرّف مستعار، وتبقى أدلة التسوية المعتمدة على السلسلة العامة محفوظة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alur pembayaran, pemenuhan, pengembalian, pengembalian dana, atau sengketa yang aktif harus mencapai status akhir sebelum penghapusan. Identitas pesanan akhir disamarkan; bukti penyelesaian resmi pada rantai publik tetap disimpan."
          }
        }
      }
    },
