    "cart_sync_review": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose which cart to use. Both versions remain encrypted in recovery history. Keeping this device’s draft requires a new version-checked save."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择使用哪份购物车。两份数据均保留在加密恢复历史中。保留本机草稿需要重新校验版本并保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇使用哪份購物車。兩份資料均保留在加密復原歷史中。保留本機草稿需要重新驗證版本並儲存。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用するカートを選択してください。両方の内容は暗号化された復元履歴に残ります。この端末の下書きを保存する際は、再度バージョンを確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용할 장바구니를 선택하세요. 두 버전 모두 암호화된 복구 기록에 보관됩니다. 이 기기의 초안을 저장하려면 버전을 다시 확인합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija un carrito. Ambas versiones se conservan en el historial cifrado. Guardar el borrador local requiere comprobar de nuevo la versión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un panier. Les deux versions restent dans le journal chiffré. Le brouillon local sera enregistré après une nouvelle vérification de version."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie einen Warenkorb. Beide Versionen bleiben im verschlüsselten Wiederherstellungsverlauf. Der lokale Entwurf wird erst nach erneuter Versionsprüfung gespeichert."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um carrinho. Ambas as versões ficam no histórico criptografado. Salvar o rascunho local exige nova verificação da versão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите корзину. Обе версии сохраняются в зашифрованной истории. Перед сохранением локального черновика версия будет проверена повторно."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر السلة التي تريد استخدامها. تُحفظ النسختان في سجل استرداد مشفر. يتطلب حفظ مسودة هذا الجهاز التحقق من الإصدار مجددًا."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih keranjang. Kedua versi disimpan dalam riwayat pemulihan terenkripsi. Draf lokal disimpan setelah versi diperiksa kembali."
          }
        }
      }
    },
