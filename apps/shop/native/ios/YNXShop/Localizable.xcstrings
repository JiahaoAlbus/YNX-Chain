    "seller_native_amount_boundary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Native amounts are exact atomic units from accepted records. Order totals are not converted into atoms here. No refund transfer is submitted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原生金额是已接受记录中的精确原子单位。此处不把订单金额换算为原子，也不提交退款转账。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原生金額是已接受記錄中的精確原子單位。此處不把訂單金額換算為原子，也不提交退款轉帳。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネイティブ金額は記録の正確な最小単位です。注文金額の換算や返金送金は行いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네이티브 금액은 기록의 정확한 최소 단위입니다. 주문 금액 환산이나 환불 이체는 실행하지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los importes nativos son unidades atómicas exactas de los registros aceptados. No se convierten totales ni se envían reembolsos aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les montants natifs sont les unités atomiques exactes des enregistrements acceptés. Les totaux ne sont pas convertis et aucun remboursement n’est envoyé ici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Native Beträge sind exakte atomare Einheiten akzeptierter Datensätze. Bestellsummen werden hier nicht umgerechnet und keine Erstattungen gesendet."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os valores nativos são unidades atômicas exatas dos registros aceitos. Os totais não são convertidos e nenhum reembolso é enviado aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нативные суммы — точные атомарные единицы из принятых записей. Суммы заказа не конвертируются, возврат не отправляется."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المبالغ الأصلية وحدات ذرية دقيقة من السجلات المقبولة. لا يتم تحويل إجمالي الطلب أو إرسال استرداد هنا."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jumlah native adalah satuan atomik tepat dari catatan yang diterima. Total pesanan tidak dikonversi dan pengembalian dana tidak dikirim di sini."
          }
        }
      }
    },
