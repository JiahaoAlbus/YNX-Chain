    "cart_sync_unconfirmed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cart sync is unconfirmed. The original request and key are preserved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "购物车同步尚未确认，原请求和键已保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
