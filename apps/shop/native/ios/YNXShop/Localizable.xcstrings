    "seller_reload_listing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use currently loaded server version"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "采用当前已加载的服务器版本"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "採用目前已載入的伺服器版本"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込み済みのサーバー版を使う"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 불러온 서버 버전 사용"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar versión del servidor cargada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser la version serveur chargée"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktuell geladene Serverversion verwenden"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar versão do servidor carregada"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использовать загруженную версию сервера"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدام إصدار الخادم المحمّل حالياً"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan versi server yang sedang dimuat"
          }
        }
      }
    },
    "seller_reload_listing_confirmation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace this form with the currently loaded server listing? The saved local draft remains until you save again. Original pending operations are unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用当前已加载的服务器商品替换表单内容？已保存的本机草稿会保留至再次保存；待核对的原操作不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用目前已載入的伺服器商品取代表單內容？已儲存的本機草稿會保留至再次儲存；待核對的原操作不變。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォームを読み込み済みのサーバー版に置き換えますか？保存済みのローカル下書きは再保存まで保持され、未確認の元の操作は変更しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "양식을 현재 불러온 서버 상품으로 바꿀까요? 저장된 로컬 초안은 다시 저장할 때까지 유지되며 대기 중인 원래 작업은 변경되지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Reemplazar el formulario con la ficha cargada del servidor? El borrador local guardado se conserva hasta volver a guardar. Las operaciones originales pendientes no cambian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplacer le formulaire par la fiche serveur chargée ? Le brouillon local enregistré reste conservé jusqu’au prochain enregistrement. Les opérations d’origine en attente ne changent pas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Formular durch das geladene Serverangebot ersetzen? Der lokale Entwurf bleibt bis zum erneuten Speichern erhalten. Ausstehende ursprüngliche Vorgänge bleiben unverändert."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Substituir o formulário pelo anúncio do servidor carregado? O rascunho local salvo permanece até salvar novamente. Operações originais pendentes não são alteradas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заменить форму загруженной версией товара с сервера? Локальный черновик останется до повторного сохранения. Исходные ожидающие операции не изменятся."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استبدال النموذج بعرض الخادم المحمّل حالياً؟ تبقى المسودة المحلية المحفوظة حتى الحفظ مجدداً. لا تتغير العمليات الأصلية المعلقة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganti formulir dengan produk server yang sedang dimuat? Draf lokal tersimpan tetap ada hingga disimpan kembali. Operasi asli yang tertunda tidak berubah."
          }
        }
      }
    },
    "seller_store_changed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The store policy, payout account or update time changed. Close this form, refresh and review the new values before activating."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "店铺政策、收款账户或更新时间已变更。请关闭表单、刷新并重新审核后再激活。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "店鋪政策、收款帳戶或更新時間已變更。請關閉表單、重新整理並重新審閱後再啟用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "店舗ポリシー、受取アカウント、更新日時のいずれかが変更されました。フォームを閉じて更新し、再確認してから有効化してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상점 정책, 수취 계정 또는 수정 시각이 변경되었습니다. 양식을 닫고 새로고침한 뒤 새 값을 검토하여 활성화하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La política, la cuenta de cobro o la fecha de actualización han cambiado. Cierra el formulario, actualiza y revisa los nuevos valores antes de activar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La politique, le compte de versement ou la date de mise à jour a changé. Fermez le formulaire, actualisez et vérifiez les nouvelles valeurs avant d’activer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Shop-Richtlinien, Auszahlungskonto oder Aktualisierungszeit haben sich geändert. Schließen Sie das Formular, aktualisieren Sie und prüfen Sie die neuen Werte vor der Aktivierung."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A política, a conta de recebimento ou a data de atualização mudou. Feche o formulário, atualize e revise os novos valores antes de ativar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правила магазина, счёт получения или время обновления изменились. Закройте форму, обновите данные и проверьте новые значения перед активацией."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيرت سياسة المتجر أو حساب الاستلام أو وقت التحديث. أغلق النموذج وحدّث البيانات وراجع القيم الجديدة قبل التفعيل."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kebijakan toko, akun penerimaan, atau waktu pembaruan berubah. Tutup formulir, segarkan, dan tinjau nilai baru sebelum mengaktifkan."
          }
        }
      }
    },
    "seller_store_input_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The trust link is optional and must use HTTPS. The payout account is optional and must be a canonical ynx1 address. A policy is required for activation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "信任链接可留空，填写时须为 HTTPS。收款账户可留空，填写时须为规范 ynx1 地址。激活时必须提供政策。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "信任連結可留空，填寫時須為 HTTPS。收款帳戶可留空，填寫時須為標準 ynx1 位址。啟用時必須提供政策。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "信頼情報のリンクは任意で、HTTPSが必要です。受取アカウントも任意で、正規のynx1アドレスが必要です。有効化にはポリシーが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신뢰 링크는 선택 사항이며 HTTPS여야 합니다. 수취 계정도 선택 사항이며 표준 ynx1 주소여야 합니다. 활성화하려면 정책이 필요합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El enlace de confianza es opcional y debe usar HTTPS. La cuenta de cobro es opcional y debe ser una dirección ynx1 canónica. La activación requiere una política."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lien de confiance est facultatif et doit utiliser HTTPS. Le compte de versement est facultatif et doit être une adresse ynx1 canonique. Une politique est requise pour l’activation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Vertrauenslink ist optional und muss HTTPS verwenden. Das Auszahlungskonto ist optional und muss eine kanonische ynx1-Adresse sein. Zur Aktivierung sind Richtlinien erforderlich."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O link de confiança é opcional e deve usar HTTPS. A conta de recebimento é opcional e deve ser um endereço ynx1 canônico. Uma política é necessária para ativar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылка доверия необязательна и должна использовать HTTPS. Счёт получения необязателен и должен быть каноническим адресом ynx1. Для активации нужны правила."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رابط الثقة اختياري ويجب أن يستخدم HTTPS. حساب الاستلام اختياري ويجب أن يكون عنوان ynx1 قياسياً. يلزم توفير سياسة للتفعيل."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tautan kepercayaan opsional dan harus memakai HTTPS. Akun penerimaan opsional dan harus berupa alamat ynx1 kanonis. Kebijakan diperlukan untuk aktivasi."
          }
        }
      }
    },
    "seller_store_profile_read_only": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Store profile and payout details are read only in this view. Activation requires a separate owner review."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本页店铺资料与收款信息仅供读取；激活须由 owner 另行审核。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本頁店鋪資料與收款資訊僅供讀取；啟用須由 owner 另行審閱。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画面の店舗情報と受取情報は読み取り専用です。有効化には所有者による個別の確認が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 화면의 상점 정보와 수취 정보는 읽기 전용입니다. 활성화하려면 소유자의 별도 검토가 필요합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El perfil y los datos de cobro son de solo lectura en esta vista. La activación requiere una revisión separada del propietario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le profil et les informations de versement sont en lecture seule ici. L’activation nécessite une vérification distincte par le propriétaire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Shop-Profil und Auszahlungsdaten sind hier schreibgeschützt. Die Aktivierung erfordert eine separate Prüfung durch den Eigentümer."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O perfil e os dados de recebimento são somente para leitura nesta tela. A ativação exige uma revisão separada pelo proprietário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Профиль магазина и данные получения в этом разделе доступны только для чтения. Активация требует отдельной проверки владельцем."
          }
