{
  "sourceLanguage": "en",
  "strings": {
    "local_data_locked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local data is locked. Unlock to restore the original cart."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地数据已锁定。解锁后恢复原购物车。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本機資料已鎖定。解鎖後恢復原購物車。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルデータはロックされています。解除して元のカートを復元してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 데이터가 잠겨 있습니다. 잠금을 해제하여 기존 장바구니를 복원하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos locales están bloqueados. Desbloquéalos para restaurar el carrito original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données locales sont verrouillées. Déverrouillez-les pour restaurer le panier d’origine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Daten sind gesperrt. Zum Wiederherstellen des ursprünglichen Warenkorbs entsperren."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados locais estão bloqueados. Desbloqueie para restaurar o carrinho original."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальные данные заблокированы. Разблокируйте их, чтобы восстановить исходную корзину."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البيانات المحلية مقفلة. افتحها لاستعادة سلة التسوق الأصلية."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data lokal terkunci. Buka kunci untuk memulihkan keranjang asli."
          }
        }
      }
    },
