    "privacy_recovery_notice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletion pauses earlier requests. Their original contents may remain as encrypted recovery evidence, including addresses. They will not run again after confirmed deletion."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除会暂停此前请求。其原始内容可能作为加密恢复证据保留，包括地址；删除确认后不会再次执行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除會暫停先前請求。其原始內容可能作為加密復原證據保留，包括地址；刪除確認後不會再次執行。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除中は以前のリクエストを停止します。住所を含む元の内容が暗号化された復旧証拠として残る場合があります。削除確認後に再実行されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제 중에는 이전 요청이 중지됩니다. 주소를 포함한 원본 내용이 암호화된 복구 증거로 남을 수 있으며 삭제 확인 후에는 다시 실행되지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La eliminación pausa las solicitudes anteriores. Su contenido original, incluidas las direcciones, puede conservarse como prueba cifrada de recuperación. No se ejecutarán después de confirmar la eliminación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La suppression suspend les anciennes demandes. Leur contenu original, y compris les adresses, peut être conservé comme preuve chiffrée de récupération. Elles ne seront plus exécutées après confirmation de la suppression."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Löschung hält frühere Anfragen an. Ihr ursprünglicher Inhalt, einschließlich Adressen, kann als verschlüsselter Wiederherstellungsnachweis erhalten bleiben. Nach bestätigter Löschung werden sie nicht erneut ausgeführt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A eliminação suspende os pedidos anteriores. O conteúdo original, incluindo moradas, pode permanecer como prova cifrada de recuperação. Os pedidos não serão executados após a confirmação da eliminação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаление приостанавливает старые запросы. Их исходное содержимое, включая адреса, может сохраняться как зашифрованные данные восстановления. После подтверждения удаления они больше не выполнятся."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوقف الحذف الطلبات السابقة مؤقتًا. قد يبقى محتواها الأصلي، بما فيه العناوين، كأدلة استرداد مشفرة. ولن تُنفذ مجددًا بعد تأكيد الحذف."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penghapusan menjeda permintaan lama. Isi aslinya, termasuk alamat, dapat disimpan sebagai bukti pemulihan terenkripsi. Permintaan tersebut tidak akan dijalankan lagi setelah penghapusan dikonfirmasi."
          }
        }
      }
    },
