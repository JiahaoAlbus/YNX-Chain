    "privacy_draining": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finishing submitted requests. New changes and pending retries are paused."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待已提交请求的结果。新修改和待处理重试已暂停。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待已提交請求的結果。新修改和待處理重試已暫停。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信済みリクエストの結果を待っています。新しい変更と再試行は停止中です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제출된 요청의 결과를 기다리는 중입니다. 새 변경과 재시도는 일시 중지되었습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando el resultado de las solicitudes enviadas. Los cambios nuevos y los reintentos están pausados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente du résultat des demandes envoyées. Les nouvelles modifications et les nouvelles tentatives sont suspendues."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ergebnisse gesendeter Anfragen werden abgewartet. Neue Änderungen und Wiederholungen sind angehalten."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A aguardar os resultados dos pedidos enviados. Novas alterações e tentativas estão suspensas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ожидаются результаты отправленных запросов. Новые изменения и повторные попытки приостановлены."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ انتظار نتائج الطلبات المرسلة. تم إيقاف التغييرات الجديدة وإعادة المحاولات مؤقتًا."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menunggu hasil permintaan yang telah dikirim. Perubahan baru dan percobaan ulang dijeda."
          }
        }
      }
    },
    "privacy_blocked_unknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A previous request has an unconfirmed result. Deletion has not been sent. Recovery records remain encrypted and changes remain paused."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先前请求的结果尚未确认，删除尚未发送。恢复记录继续加密保存，修改保持暂停。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先前請求的結果尚未確認，刪除尚未送出。復原記錄繼續加密保存，修改保持暫停。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前のリクエスト結果が未確認のため、削除は送信されていません。復旧記録は暗号化して保持され、変更は停止したままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 요청의 결과가 확인되지 않아 삭제를 보내지 않았습니다. 복구 기록은 암호화해 보관하며 변경은 계속 중지됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una solicitud anterior tiene un resultado sin confirmar. No se ha enviado la eliminación. Los registros siguen cifrados y los cambios permanecen pausados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le résultat d’une demande précédente est inconnu. La suppression n’a pas été envoyée. Les données de récupération restent chiffrées et les modifications suspendues."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ergebnis einer früheren Anfrage ist unbestätigt. Die Löschung wurde nicht gesendet. Wiederherstellungsdaten bleiben verschlüsselt und Änderungen angehalten."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O resultado de um pedido anterior não está confirmado. A eliminação não foi enviada. Os registos permanecem cifrados e as alterações suspensas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Результат предыдущего запроса не подтверждён. Запрос на удаление не отправлен. Данные восстановления сохранены в зашифрованном виде, изменения приостановлены."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نتيجة طلب سابق غير مؤكدة. لم يُرسل طلب الحذف. تبقى سجلات الاسترداد مشفرة والتغييرات متوقفة مؤقتًا."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasil permintaan sebelumnya belum terkonfirmasi. Penghapusan belum dikirim. Catatan pemulihan tetap terenkripsi dan perubahan tetap dijeda."
          }
        }
      }
    },
    "privacy_deletion_unknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The deletion result is unconfirmed. Changes and old requests remain paused. Retrying sends the same deletion request."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除结果尚未确认。修改和旧请求保持暂停；重试只发送原删除请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除結果尚未確認。修改和舊請求保持暫停；重試只送出原刪除請求。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除結果は未確認です。変更と以前のリクエストは停止中です。再試行では同じ削除リクエストを送信します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제 결과가 확인되지 않았습니다. 변경과 이전 요청은 중지된 상태이며 재시도는 동일한 삭제 요청만 보냅니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resultado de la eliminación no está confirmado. Los cambios y las solicitudes anteriores siguen pausados. El reintento envía la misma solicitud de eliminación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le résultat de la suppression est inconnu. Les modifications et les anciennes demandes restent suspendues. Une nouvelle tentative renvoie la même demande de suppression."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ergebnis der Löschung ist unbestätigt. Änderungen und frühere Anfragen bleiben angehalten. Ein erneuter Versuch sendet dieselbe Löschanfrage."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O resultado da eliminação não está confirmado. As alterações e os pedidos anteriores continuam suspensos. Tentar novamente envia o mesmo pedido de eliminação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Результат удаления не подтверждён. Изменения и старые запросы остаются приостановленными. Повторная попытка отправит тот же запрос на удаление."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نتيجة الحذف غير مؤكدة. تبقى التغييرات والطلبات السابقة متوقفة. تعيد المحاولة إرسال طلب الحذف نفسه."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasil penghapusan belum terkonfirmasi. Perubahan dan permintaan lama tetap dijeda. Percobaan ulang mengirim permintaan penghapusan yang sama."
          }
        }
      }
    },
    "privacy_cleanup_pending": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server deletion is confirmed. Encrypted evidence is saved; local cleanup still needs to finish. Changes remain paused."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务端删除已确认，加密证据已保存，本地清理尚待完成。修改保持暂停。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器刪除已確認，加密證據已保存，本機清理尚待完成。修改保持暫停。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーでの削除は確認済みです。暗号化された証拠は保存済みですが、端末内の整理が未完了です。変更は停止中です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버 삭제가 확인되었습니다. 암호화된 증거는 저장되었지만 기기 내 정리가 남아 있습니다. 변경은 중지 상태입니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La eliminación del servidor está confirmada. Las pruebas cifradas están guardadas; falta finalizar la limpieza local. Los cambios siguen pausados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La suppression sur le serveur est confirmée. Les preuves chiffrées sont enregistrées ; le nettoyage local reste à terminer. Les modifications restent suspendues."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Löschung auf dem Server ist bestätigt. Verschlüsselte Nachweise sind gespeichert; die lokale Bereinigung steht noch aus. Änderungen bleiben angehalten."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A eliminação no servidor está confirmada. As provas cifradas foram guardadas; falta concluir a limpeza local. As alterações continuam suspensas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаление на сервере подтверждено. Зашифрованные подтверждения сохранены, но локальная очистка ещё не завершена. Изменения приостановлены."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تأكيد الحذف على الخادم. حُفظت الأدلة المشفرة، لكن التنظيف المحلي لم يكتمل. تبقى التغييرات متوقفة مؤقتًا."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penghapusan di server telah dikonfirmasi. Bukti terenkripsi telah disimpan, tetapi pembersihan lokal belum selesai. Perubahan tetap dijeda."
          }
        }
      }
    },
    "privacy_confirmed_evidence": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server deletion is confirmed. Earlier requests remain as encrypted evidence and will not run again. Public-chain and financial records remain verifiable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务端删除已确认。此前请求作为加密证据保留，不会再次执行。公链及财务记录仍可核验。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器刪除已確認。先前請求作為加密證據保留，不會再次執行。公鏈及財務記錄仍可核驗。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーでの削除は確認済みです。以前のリクエストは暗号化された証拠として保持され、再実行されません。公開チェーンと会計記録は引き続き検証できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버 삭제가 확인되었습니다. 이전 요청은 암호화된 증거로 보관되며 다시 실행되지 않습니다. 공개 체인과 재무 기록은 계속 검증할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La eliminación del servidor está confirmada. Las solicitudes anteriores se conservan como pruebas cifradas y no volverán a ejecutarse. Los registros financieros y de la cadena pública siguen siendo verificables."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La suppression sur le serveur est confirmée. Les anciennes demandes sont conservées comme preuves chiffrées et ne seront plus exécutées. Les données financières et de la chaîne publique restent vérifiables."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Löschung auf dem Server ist bestätigt. Frühere Anfragen bleiben als verschlüsselte Nachweise erhalten und werden nicht erneut ausgeführt. Finanzdaten und öffentliche Blockchain-Daten bleiben überprüfbar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A eliminação no servidor está confirmada. Os pedidos anteriores ficam guardados como provas cifradas e não serão executados novamente. Os registos financeiros e da cadeia pública continuam verificáveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаление на сервере подтверждено. Старые запросы сохранены как зашифрованные свидетельства и больше не выполнятся. Финансовые данные и записи публичной цепочки доступны для проверки."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تأكيد الحذف على الخادم. تُحفظ الطلبات السابقة كأدلة مشفرة ولن تُنفذ مجددًا. تبقى السجلات المالية وسجلات السلسلة العامة قابلة للتحقق."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penghapusan di server telah dikonfirmasi. Permintaan lama disimpan sebagai bukti terenkripsi dan tidak akan dijalankan lagi. Catatan keuangan dan rantai publik tetap dapat diverifikasi."
          }
        }
      }
    },
    "privacy_too_many_records": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many pending requests to include in this deletion. Deletion was not sent; your records are preserved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "待处理记录过多，暂时无法安全删除。删除请求尚未发送，记录已保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "待處理記錄過多，暫時無法安全刪除。刪除請求尚未送出，記錄已保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保留中のリクエストが多すぎるため、安全に削除できません。削除は送信されておらず、記録は保持されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대기 요청이 너무 많아 안전하게 삭제할 수 없습니다. 삭제 요청은 전송되지 않았으며 기록은 보관됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay demasiadas solicitudes pendientes para incluirlas en esta eliminación. No se envió la eliminación y sus registros se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de demandes en attente pour les inclure dans cette suppression. La suppression n’a pas été envoyée et vos données sont conservées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele ausstehende Anfragen für diese Löschung. Die Löschung wurde nicht gesendet; Ihre Daten bleiben erhalten."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Existem demasiados pedidos pendentes para incluir nesta eliminação. A eliminação não foi enviada e os seus registos foram preservados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком много ожидающих запросов для этого удаления. Запрос на удаление не отправлен, ваши записи сохранены."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هناك طلبات معلقة كثيرة لا يمكن تضمينها بأمان في هذا الحذف. لم يُرسل طلب الحذف وبقيت سجلاتك محفوظة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terlalu banyak permintaan tertunda untuk disertakan dalam penghapusan ini. Penghapusan belum dikirim dan catatan Anda tetap disimpan."
          }
        }
      }
    },
    "privacy_invalid_receipt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server did not confirm the required deletion receipt. The result remains unconfirmed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务端未确认所需的删除回执，结果仍未确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器未確認所需的刪除回執，結果仍未確認。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーから必要な削除確認を取得できませんでした。結果は未確認のままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 필요한 삭제 영수증을 확인하지 않았습니다. 결과는 아직 확인되지 않았습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no confirmó el recibo de eliminación requerido. El resultado sigue sin confirmarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur n’a pas confirmé le reçu de suppression requis. Le résultat reste inconnu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat den erforderlichen Löschbeleg nicht bestätigt. Das Ergebnis bleibt unbestätigt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor não confirmou o comprovativo de eliminação necessário. O resultado continua por confirmar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер не подтвердил требуемую квитанцию удаления. Результат остаётся неподтверждённым."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يؤكد الخادم إيصال الحذف المطلوب. لا تزال النتيجة غير مؤكدة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Server belum mengonfirmasi tanda terima penghapusan yang diperlukan. Hasilnya masih belum terkonfirmasi."
          }
        }
      }
    },
