          }
        }
      }
    },
    "seller_no_inferred_metrics": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasks use currently visible records. Sales, revenue and delivery deadlines are not inferred."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "待办仅依据当前可见记录，不推算销量、收入或发货期限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "待辦僅依據目前可見記錄，不推算銷量、收入或出貨期限。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクは現在表示可能な記録に基づきます。販売数、収益、発送期限は推定しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업은 현재 표시 가능한 기록을 사용합니다. 판매량, 수익 또는 배송 기한은 추정하지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tareas usan los registros visibles actuales. No se infieren ventas, ingresos ni plazos de envío."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tâches utilisent les enregistrements actuellement visibles. Les ventes, revenus et délais d’expédition ne sont pas déduits."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgaben basieren auf aktuell sichtbaren Datensätzen. Verkäufe, Einnahmen und Versandfristen werden nicht abgeleitet."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As tarefas usam os registros visíveis atuais. Vendas, receitas e prazos de envio não são inferidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задачи основаны на текущих видимых записях. Продажи, доход и сроки отправки не вычисляются предположительно."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستخدم المهام السجلات المرئية حالياً. لا يتم استنتاج المبيعات أو الإيرادات أو مواعيد الشحن."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugas memakai catatan yang terlihat saat ini. Penjualan, pendapatan, dan tenggat pengiriman tidak disimpulkan."
          }
        }
      }
    },
    "seller_no_stores": {
