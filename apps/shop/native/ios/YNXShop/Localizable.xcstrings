    "seller_activation_snapshot_missing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The store’s original update time is unavailable. Refresh before activating."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未取得店铺原更新时间，请刷新后再激活。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未取得店鋪原更新時間，請重新整理後再啟用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "店舗の元の更新日時を取得できません。有効化する前に更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상점의 원래 수정 시각을 사용할 수 없습니다. 활성화 전에 새로고침하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No está disponible la fecha original de actualización. Actualiza antes de activar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La date de mise à jour d’origine est indisponible. Actualisez avant d’activer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der ursprüngliche Aktualisierungszeitpunkt ist nicht verfügbar. Aktualisieren Sie vor der Aktivierung."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A data de atualização original não está disponível. Atualize antes de ativar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исходное время обновления магазина недоступно. Обновите данные перед активацией."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وقت التحديث الأصلي للمتجر غير متاح. حدّث البيانات قبل التفعيل."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu pembaruan asli toko tidak tersedia. Segarkan sebelum mengaktifkan."
          }
        }
      }
    },
    "seller_confirm_activation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I have reviewed this store’s policy and confirm activation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我已审核本店政策，确认激活。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我已審閱本店政策，確認啟用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "店舗ポリシーを確認し、有効化を承認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 상점의 정책을 검토했으며 활성화에 동의합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "He revisado la política de esta tienda y confirmo su activación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J’ai vérifié la politique de cette boutique et je confirme son activation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe die Shop-Richtlinien geprüft und bestätige die Aktivierung."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisei a política desta loja e confirmo a ativação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я проверил правила магазина и подтверждаю активацию."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راجعت سياسة هذا المتجر وأؤكد تفعيله."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya telah meninjau kebijakan toko ini dan mengonfirmasi aktivasi."
          }
        }
      }
    },
    "seller_confirm_invitation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I confirm the account, role and validity period for this invitation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我确认本次邀请的账户、角色与有效期。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我確認本次邀請的帳戶、角色與有效期。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "招待するアカウント、役割、有効期間を確認しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 초대의 계정, 역할 및 유효 기간을 확인합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmo la cuenta, el rol y el periodo de validez de esta invitación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je confirme le compte, le rôle et la durée de validité de cette invitation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich bestätige Konto, Rolle und Gültigkeitsdauer dieser Einladung."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmo a conta, a função e o prazo de validade deste convite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я подтверждаю учётную запись, роль и срок действия приглашения."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أؤكد الحساب والدور ومدة صلاحية هذه الدعوة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya mengonfirmasi akun, peran, dan masa berlaku undangan ini."
          }
        }
      }
    },
    "seller_create_product_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This creates a product on the server with publication turned off. Review and publish it separately when ready."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作在服务器创建未发布商品；准备就绪后须另行审核并发布。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作在伺服器建立未發布商品；準備就緒後須另行審閱並發布。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーに未公開の商品を作成します。準備ができたら別途確認して公開してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에 미게시 상품을 만듭니다. 준비가 되면 별도로 검토하고 게시하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto crea un producto en el servidor sin publicar. Revísalo y publícalo por separado cuando esté listo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action crée un produit non publié sur le serveur. Vérifiez-le et publiez-le séparément lorsqu’il est prêt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies erstellt ein unveröffentlichtes Produkt auf dem Server. Prüfen und veröffentlichen Sie es später gesondert."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ação cria um produto não publicado no servidor. Revise e publique separadamente quando estiver pronto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это создаёт неопубликованный товар на сервере. Когда он будет готов, отдельно проверьте и опубликуйте его."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينشئ هذا الإجراء منتجاً غير منشور على الخادم. راجعه وانشره بشكل منفصل عندما يكون جاهزاً."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini membuat produk di server tanpa publikasi. Tinjau dan publikasikan secara terpisah saat siap."
          }
        }
      }
    },
    "seller_create_store_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new store starts in onboarding. Activation requires a separate owner confirmation of its policy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新店铺初始为待启用状态，须由 owner 另行确认政策后激活。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新店鋪初始為待啟用狀態，須由 owner 另行確認政策後啟用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい店舗は準備中として作成されます。有効化には所有者によるポリシーの個別確認が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 상점은 준비 중 상태로 시작합니다. 활성화하려면 소유자가 정책을 별도로 확인해야 합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tienda nueva empieza en preparación. Su activación requiere que el propietario confirme la política por separado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une nouvelle boutique commence en préparation. Son activation nécessite une confirmation distincte de la politique par le propriétaire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein neuer Shop beginnt in der Einrichtung. Die Aktivierung erfordert eine separate Bestätigung der Richtlinien durch den Eigentümer."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma nova loja começa em preparação. A ativação exige uma confirmação separada da política pelo proprietário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новый магазин создаётся в режиме подготовки. Для активации владелец должен отдельно подтвердить правила."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدأ المتجر الجديد في مرحلة الإعداد. يتطلب التفعيل تأكيداً منفصلاً للسياسة من المالك."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Toko baru dimulai dalam tahap penyiapan. Aktivasi memerlukan konfirmasi kebijakan terpisah oleh pemilik."
          }
        }
      }
    },
    "seller_invitation_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This sends an invitation, not an immediate role grant. The recipient must accept through their own Wallet before membership takes effect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作仅发送邀请，不立即授予角色；对方须通过本人 Wallet 接受后，成员身份才生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作僅傳送邀請，不立即授予角色；對方須透過本人 Wallet 接受後，成員身分才生效。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "招待を送信するだけで、役割を即時付与するものではありません。相手が本人のWalletで承諾して初めてメンバーとなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 동작은 초대만 보내며 역할을 즉시 부여하지 않습니다. 상대방이 본인의 Wallet으로 수락해야 구성원 자격이 적용됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto envía una invitación, no concede el rol de inmediato. El destinatario debe aceptarla con su propio Wallet para que la membresía entre en vigor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action envoie une invitation sans attribuer immédiatement le rôle. Le destinataire doit l’accepter via son propre Wallet pour devenir membre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies sendet eine Einladung und vergibt die Rolle nicht sofort. Die Mitgliedschaft wird erst nach Annahme über das eigene Wallet des Empfängers wirksam."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ação envia um convite sem conceder a função imediatamente. O destinatário deve aceitar pelo próprio Wallet para a participação entrar em vigor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это отправляет приглашение, а не сразу назначает роль. Участие вступает в силу после принятия получателем через собственный Wallet."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرسل هذا الإجراء دعوة ولا يمنح الدور فوراً. يجب أن يقبل المستلم عبر Wallet الخاص به حتى تصبح العضوية سارية."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini mengirim undangan, bukan langsung memberikan peran. Penerima harus menerimanya melalui Wallet miliknya agar keanggotaan berlaku."
          }
        }
      }
    },
    "seller_local_draft_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not save the encrypted local draft. This action did not submit edits to the server."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能保存加密本机草稿；本次操作未向服务器提交编辑内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未能儲存加密本機草稿；本次操作未向伺服器提交編輯內容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗号化したローカル下書きを保存できませんでした。この操作では編集内容をサーバーに送信していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호화된 로컬 초안을 저장하지 못했습니다. 이 동작은 수정 내용을 서버에 제출하지 않았습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar el borrador local cifrado. Esta acción no envió cambios al servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer le brouillon local chiffré. Cette action n’a envoyé aucune modification au serveur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der verschlüsselte lokale Entwurf konnte nicht gespeichert werden. Dabei wurden keine Änderungen an den Server gesendet."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar o rascunho local criptografado. Esta ação não enviou alterações ao servidor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить зашифрованный локальный черновик. Изменения на сервер не отправлялись."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر حفظ المسودة المحلية المشفرة. لم يرسل هذا الإجراء التعديلات إلى الخادم."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Draf lokal terenkripsi tidak dapat disimpan. Tindakan ini tidak mengirim perubahan ke server."
          }
        }
      }
    },
    "seller_local_draft_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This button saves an encrypted draft only on this device. It does not save to the server or publish the listing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此按钮仅在本机加密保存草稿，不保存到服务器，也不发布商品。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此按鈕僅在本機加密儲存草稿，不儲存到伺服器，也不發布商品。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このボタンは暗号化した下書きをこの端末にのみ保存します。サーバーへの保存や商品の公開は行いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 버튼은 암호화된 초안을 이 기기에만 저장합니다. 서버에 저장하거나 상품을 게시하지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este botón guarda un borrador cifrado solo en este dispositivo. No lo guarda en el servidor ni publica el producto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce bouton enregistre un brouillon chiffré uniquement sur cet appareil. Il ne l’enregistre pas sur le serveur et ne publie pas le produit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Schaltfläche speichert einen verschlüsselten Entwurf nur auf diesem Gerät. Sie speichert nichts auf dem Server und veröffentlicht kein Angebot."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este botão salva um rascunho criptografado apenas neste dispositivo. Não salva no servidor nem publica o anúncio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта кнопка сохраняет зашифрованный черновик только на этом устройстве. Она не сохраняет его на сервере и не публикует товар."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحفظ هذا الزر مسودة مشفرة على هذا الجهاز فقط. لا يحفظها على الخادم ولا ينشر العرض."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tombol ini menyimpan draf terenkripsi hanya di perangkat ini. Tidak menyimpan ke server atau memublikasikan produk."
          }
        }
      }
    },
    "seller_local_draft_saved": {
      "extractionState": "manual",
      "localizations": {
        "en": {
