    "invoice_reference_unconfirmed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original invoice is not confirmed yet. Refresh this order; a new invoice will not be created."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原发票尚未确认。请刷新此订单，不会创建新的发票。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原發票尚未確認。請重新整理此訂單，不會建立新發票。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の請求書はまだ確認されていません。この注文を更新してください。新しい請求書は作成しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원래 청구서는 아직 확인되지 않았습니다. 이 주문을 새로고침하세요. 새 청구서는 생성되지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La factura original aún no está confirmada. Actualiza este pedido; no se creará otra factura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La facture initiale reste à confirmer. Actualisez cette commande ; aucune nouvelle facture ne sera créée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ursprüngliche Rechnung ist noch nicht bestätigt. Aktualisiere diese Bestellung; es wird keine neue Rechnung erstellt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A fatura original ainda não foi confirmada. Atualize este pedido; nenhuma nova fatura será criada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исходный счёт ещё не подтверждён. Обновите этот заказ; новый счёт не будет создан."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم تأكيد الفاتورة الأصلية بعد. حدّث هذا الطلب؛ لن يتم إنشاء فاتورة جديدة."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Faktur asli belum dikonfirmasi. Segarkan pesanan ini; faktur baru tidak akan dibuat."
          }
        }
      }
    },
