    "privacy_data_description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export your profile, cart, orders, AI records and buyer audit history. Deletion removes profile, addresses, cart and AI records, and pseudonymizes terminal orders. Public-chain settlement addresses and transaction evidence remain verifiable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出你的资料、购物车、订单、AI 记录和买家审计历史。删除会移除资料、地址、购物车和 AI 记录，并对终态订单去标识化；公开链上的结算地址与交易证据仍可验证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯出你的資料、購物車、訂單、AI 紀錄與買家稽核歷史。刪除會移除資料、地址、購物車與 AI 紀錄，並對終態訂單去識別化；公開鏈上的結算地址與交易證據仍可驗證。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロフィール、カート、注文、AI記録、購入者監査履歴をエクスポートできます。削除ではプロフィール、住所、カート、AI記録を消去し、終端状態の注文を仮名化します。公開チェーン上の決済アドレスと取引証拠は検証可能なまま保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로필, 장바구니, 주문, AI 기록 및 구매자 감사 내역을 내보냅니다. 삭제하면 프로필, 주소, 장바구니 및 AI 기록이 제거되고 종료 상태의 주문은 가명 처리됩니다. 공개 체인의 결제 주소와 거래 증거는 계속 검증할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporta tu perfil, carrito, pedidos, registros de IA y auditoría del comprador. La eliminación borra perfil, direcciones, carrito y registros de IA, y seudonimiza los pedidos terminales. Las direcciones de liquidación y la evidencia de transacciones en la cadena pública siguen siendo verificables."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportez votre profil, panier, commandes, dossiers IA et historique d’audit acheteur. La suppression efface profil, adresses, panier et dossiers IA, et pseudonymise les commandes terminales. Les adresses de règlement et preuves de transaction sur chaîne publique restent vérifiables."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportieren Sie Profil, Warenkorb, Bestellungen, KI-Datensätze und Käufer-Auditverlauf. Beim Löschen werden Profil, Adressen, Warenkorb und KI-Datensätze entfernt und abgeschlossene Bestellungen pseudonymisiert. Abrechnungsadressen und Transaktionsnachweise auf der öffentlichen Chain bleiben überprüfbar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporte perfil, carrinho, pedidos, registros de IA e histórico de auditoria do comprador. A exclusão remove perfil, endereços, carrinho e registros de IA, e pseudonimiza pedidos em estado terminal. Endereços de liquidação e evidências de transação na cadeia pública continuam verificáveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экспортируйте профиль, корзину, заказы, записи ИИ и журнал аудита покупателя. При удалении стираются профиль, адреса, корзина и записи ИИ, а завершённые заказы псевдонимизируются. Адреса расчётов и доказательства транзакций в публичной сети остаются проверяемыми."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صدّر ملفك وسلة التسوق والطلبات وسجلات الذكاء الاصطناعي وسجل تدقيق المشتري. يحذف الإجراء الملف والعناوين والسلة وسجلات الذكاء الاصطناعي ويستبدل هوية الطلبات النهائية بمعرّف مستعار. تبقى عناوين التسوية وأدلة المعاملات على السلسلة العامة قابلة للتحقق."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekspor profil, keranjang, pesanan, catatan AI, dan riwayat audit pembeli. Penghapusan menghapus profil, alamat, keranjang, serta catatan AI dan menyamarkan identitas pesanan berstatus akhir. Alamat penyelesaian dan bukti transaksi pada rantai publik tetap dapat diverifikasi."
          }
        }
      }
    },
