    "seller_activation_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Activation makes this store publicly available under the policy shown above. It does not publish products or authorize payments."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "激活将按上方政策公开本店，不会发布商品或授予支付权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用將依上方政策公開本店，不會發布商品或授予付款權限。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効化すると、上記のポリシーに基づき店舗を公開します。商品の公開や支払い権限の付与は行いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성화하면 위 정책에 따라 상점이 공개됩니다. 상품을 게시하거나 결제 권한을 부여하지는 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La activación hace pública esta tienda bajo la política indicada. No publica productos ni autoriza pagos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’activation rend cette boutique publique selon la politique affichée. Elle ne publie aucun produit et n’autorise aucun paiement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aktivierung macht diesen Shop gemäß den obigen Richtlinien öffentlich. Sie veröffentlicht keine Produkte und autorisiert keine Zahlungen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A ativação torna a loja pública conforme a política acima. Não publica produtos nem autoriza pagamentos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Активация делает магазин общедоступным по указанным правилам. Она не публикует товары и не разрешает платежи."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجعل التفعيل هذا المتجر متاحاً للعامة وفق السياسة أعلاه. لا ينشر المنتجات ولا يمنح إذن الدفع."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivasi membuat toko ini tersedia secara publik dengan kebijakan di atas. Tidak memublikasikan produk atau mengizinkan pembayaran."
          }
        }
      }
    },
    "seller_activation_policy_required": {
      "extractionState": "manual",
      "localizations": {
        "en": {
