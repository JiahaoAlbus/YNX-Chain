# Immersve Test only. This adapter is not mounted on a public Card route.
IMMERSVE_SANDBOX_ENABLED=false
IMMERSVE_SANDBOX_ORIGIN=https://test.immersve.com
IMMERSVE_SANDBOX_PARTNER_ACCOUNT_ID=
IMMERSVE_SANDBOX_LISTENER_ID=
# YNX-owned server credentials only; do not use the public demonstration account.
IMMERSVE_SANDBOX_API_KEY=
IMMERSVE_SANDBOX_API_SECRET=
# Explicit short-lived operator gate for a single YNX-owned Test QA cardholder.
# Never enable in public Card until an approved operation lease and entitlement exist.
IMMERSVE_SANDBOX_WRITE_ENABLED=false
IMMERSVE_SANDBOX_OPERATOR_TICKET=
IMMERSVE_SANDBOX_QA_ACCOUNT_ID=
IMMERSVE_SANDBOX_WRITE_EXPIRES_AT=
IMMERSVE_SANDBOX_MAX_DEPOSIT_MINOR_UNITS=
IMMERSVE_SANDBOX_MAX_PROVIDER_CALLS=
# Card-owned provider lifecycle gate is separate from the Immersve transport gate.
YNX_CARD_PROVIDER_TEST_WRITE_ENABLED=false
# JSON array of explicitly approved TEST program/disclosure/funding metadata.
# Keep [] until a program, terms, risk and fee disclosure are verified.
YNX_CARD_TEST_PROGRAMS_JSON=[]
# Distinct server-to-server HMAC secret, minimum 32 characters. No client exposure.
YNX_CARD_FINANCE_READ_KEY=
