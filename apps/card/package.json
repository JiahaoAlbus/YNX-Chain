{
  "name": "@ynx-chain/card",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "build:web": "node scripts/build-web.mjs",
    "build:deployment-envelope": "node scripts/build-deployment-envelope.mjs",
    "verify:deployment-envelope": "node scripts/verify-deployment-envelope.mjs",
    "generate-sbom": "node scripts/generate-sbom.mjs",
    "security-check": "node scripts/security-check.mjs",
    "typecheck": "node --stack_size=8192 ./node_modules/typescript/bin/tsc --noEmit && node ./node_modules/typescript/bin/tsc --project server/tsconfig.json",
    "serve:backend": "node --import tsx server/main.ts",
    "test:backend": "node --import tsx --test server/*.test.ts",
    "test": "tsx --test src/**/*.test.ts && node --test test/card-native-callback.test.cjs && npm run native-patch:test",
    "bundle-check": "expo export --platform android --platform ios --output-dir dist",
    "check": "npm run security-check && npm run native-patch:check && npm run native-patch:test && npm run typecheck && npm test && npm run bundle-check",
    "native-patch:apply": "node scripts/secure-store-native-patch.mjs",
    "native-patch:check": "node scripts/secure-store-native-patch.mjs --check",
    "native-patch:test": "node --test scripts/secure-store-native-patch.test.mjs",
    "postinstall": "node scripts/secure-store-native-patch.mjs"
  },
  "dependencies": {
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.2.0",
    "@ynx-chain/wallet-auth": "file:vendor/ynx-chain-wallet-auth-1.0.0-98c6d5d7-provider.tgz",
    "@ynx-chain/wallet-auth-product-session-943": "file:vendor/ynx-chain-wallet-auth-1.1.0-943a1693.tgz",
    "@ynx/dapp-connect-sdk": "file:vendor/ynx-dapp-connect-sdk-0.1.0-p0.0-315897e7.tgz",
    "expo": "~57.0.4",
    "expo-crypto": "~57.0.1",
    "expo-linking": "~57.0.0",
    "expo-local-authentication": "~57.0.1",
    "expo-localization": "~57.0.1",
    "expo-secure-store": "57.0.3",
    "expo-status-bar": "~57.0.0",
    "expo-system-ui": "~57.0.1",
    "lucide-react-native": "1.24.0",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/react": "~19.2.2",
    "react-test-renderer": "19.2.3",
    "tsx": "4.23.1",
    "typescript": "~6.0.3"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-secure-store"
        ]
      }
    }
  }
}
