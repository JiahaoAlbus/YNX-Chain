developer.ynxweb4.com {
	encode zstd gzip

	@downloads path /downloads/*
	handle @downloads {
		uri strip_prefix /downloads
		root * /opt/ynx-developer/downloads
		header Content-Disposition "attachment"
		header X-Content-Type-Options "nosniff"
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:18113
	}
}
