{
  "name": "ynx-go",
  "publisher": "ynx",
  "version": "0.1.8",
  "displayName": "%displayName%",
  "description": "%description%",
  "license": "MIT",
  "engines": {
    "vscode": "^1.109.0"
  },
  "main": "./src/extension.cjs",
  "l10n": "./l10n",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onCommand:ynx.go.run",
    "onCommand:ynx.go.configure",
    "onCommand:ynx.go.cancel",
    "onTaskType:ynx-go",
    "onCommand:ynx.go.test"
  ],
  "contributes": {
    "commands": [
      {
        "command": "ynx.go.configure",
        "title": "%command.configure%"
      },
      {
        "command": "ynx.go.run",
        "title": "%command.run%"
      },
      {
        "command": "ynx.go.cancel",
        "title": "%command.cancel%"
      },
      {
        "command": "ynx.go.test",
        "title": "%command.test%"
      }
    ],
    "configuration": {
      "title": "YNX Go",
      "properties": {
        "ynx.go.project": {
          "type": "object",
          "scope": "resource",
          "description": "%configuration.project%"
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "ynx-go",
        "required": [
          "stage",
          "target"
        ],
        "properties": {
          "stage": {
            "type": "string",
            "enum": [
              "build",
              "run",
              "test"
            ]
          },
          "target": {
            "type": "string"
          },
          "runId": {
            "type": "string"
          }
        }
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "ynx.go.run",
          "when": "resourceScheme == file && resourceExtname == .go",
          "group": "ynx@2"
        },
        {
          "command": "ynx.go.test",
          "when": "resourceScheme == file && resourceExtname == .go",
          "group": "ynx@3"
        }
      ]
    },
    "problemMatchers": [
      {
        "name": "ynx-go-compile",
        "owner": "ynx-go",
        "fileLocation": [
          "relative",
          "${cwd}"
        ],
        "pattern": {
          "regexp": "^(.+\\.go):(\\d+):(\\d+):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      }
    ],
    "languages": [
      {
        "id": "go",
        "extensions": [
          ".go"
        ],
        "aliases": [
          "Go"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "go",
        "scopeName": "source.go",
        "path": "./syntaxes/go.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[go]": {
        "editor.insertSpaces": false
      }
    }
  },
  "categories": [
    "Programming Languages"
  ],
  "scripts": {
    "test": "node --test src/go-task-execution.test.mjs"
  }
}
