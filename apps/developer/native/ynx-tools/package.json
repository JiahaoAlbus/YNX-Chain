{
  "name": "ynx-tools",
  "displayName": "YNX Tools",
  "publisher": "ynx",
  "version": "0.2.15",
  "engines": {
    "vscode": "^1.109.0"
  },
  "license": "MIT",
  "icon": "ynx-logo.png",
  "main": "./src/extension.cjs",
  "activationEvents": [
    "onLanguage:solidity",
    "onView:ynx.tools",
    "onCommand:ynx.reviewSelection",
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ynx",
          "title": "YNX",
          "icon": "activity.svg"
        }
      ]
    },
    "views": {
      "ynx": [
        {
          "id": "ynx.tools",
          "name": "YNX Tools"
        }
      ]
    },
    "commands": [
      {
        "command": "ynx.copySolidityProject",
        "title": "YNX: Compile Solidity Project"
      },
      {
        "command": "ynx.openTools",
        "title": "YNX: Open Chain, Wallet and AI Tools"
      },
      {
        "command": "ynx.copyContext",
        "title": "YNX: Copy Selected Context for Review"
      },
      {
        "command": "ynx.createTemplate",
        "title": "YNX: Create Read-only Testnet SDK Starter"
      },
      {
        "command": "ynx.applyReviewedDiff",
        "title": "YNX: Apply Reviewed Text Changes"
      },
      {
        "command": "ynx.reviewSelection",
        "title": "YNX: Review Selection with AI"
      },
      {
        "command": "ynx.importSolidityDiagnostics",
        "title": "YNX: Import Solidity Compiler Diagnostics"
      },
      {
        "command": "ynx.solidityAnalysisStatus",
        "title": "YNX: Solidity Language Status"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": [
          "**/keybindings.json"
        ],
        "url": "./schemas/keybindings.schema.json"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "ynx.reviewSelection",
          "when": "ynx.hasSelection && resourceScheme == file",
          "group": "ynx@1"
        },
        {
          "command": "ynx.copySolidityProject",
          "when": "resourceScheme == file && resourceExtname == .sol",
          "group": "ynx@2"
        },
        {
          "command": "ynx.applyReviewedDiff",
          "when": "resourceScheme == file",
          "group": "ynx@3"
        },
        {
          "command": "ynx.importSolidityDiagnostics",
          "when": "resourceScheme == file && resourceExtname == .sol",
          "group": "ynx@4"
        }
      ]
    },
    "keybindings": [
      {
        "command": "ynx.reviewSelection",
        "key": "ctrl+k ctrl+y",
        "mac": "cmd+k cmd+y",
        "when": "editorTextFocus && editorHasSelection && resourceScheme == file"
      }
    ],
    "languages": [
      {
        "id": "solidity",
        "aliases": [
          "Solidity",
          "solidity"
        ],
        "extensions": [
          ".sol"
        ],
        "configuration": "./languages/solidity-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "solidity",
        "scopeName": "source.solidity",
        "path": "./languages/solidity.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "solidity",
        "path": "./languages/solidity.code-snippets"
      }
    ]
  },
  "extensionKind": [
    "workspace"
  ]
}
