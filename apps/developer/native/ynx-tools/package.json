{
  "name": "ynx-tools",
  "displayName": "%displayName%",
  "publisher": "ynx",
  "version": "0.2.27",
  "engines": {
    "vscode": "^1.109.0"
  },
  "license": "MIT",
  "icon": "ynx-logo.png",
  "main": "./src/extension.cjs",
  "activationEvents": [
    "onLanguage:solidity",
    "onView:ynx.tools",
    "onCommand:ynx.reviewSelection",
    "onStartupFinished",
    "onCommand:ynx.configurePython"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ynx",
          "title": "%container.ynx%",
          "icon": "activity.svg"
        }
      ]
    },
    "views": {
      "ynx": [
        {
          "id": "ynx.tools",
          "name": "%view.ynx.tools%"
        }
      ]
    },
    "commands": [
      {
        "command": "ynx.createSolidityTemplate",
        "title": "%command.ynx.createSolidityTemplate%"
      },
      {
        "command": "ynx.testnetConfiguration",
        "title": "%command.ynx.testnetConfiguration%"
      },
      {
        "command": "ynx.compileSolidity",
        "title": "%command.ynx.compileSolidity%"
      },
      {
        "command": "ynx.copySolidityProject",
        "title": "%command.ynx.copySolidityProject%"
      },
      {
        "command": "ynx.openTools",
        "title": "%command.ynx.openTools%"
      },
      {
        "command": "ynx.copyContext",
        "title": "%command.ynx.copyContext%"
      },
      {
        "command": "ynx.createTemplate",
        "title": "%command.ynx.createTemplate%"
      },
      {
        "command": "ynx.applyReviewedDiff",
        "title": "%command.ynx.applyReviewedDiff%"
      },
      {
        "command": "ynx.reviewSelection",
        "title": "%command.ynx.reviewSelection%"
      },
      {
        "command": "ynx.importSolidityDiagnostics",
        "title": "%command.ynx.importSolidityDiagnostics%"
      },
      {
        "command": "ynx.solidityAnalysisStatus",
        "title": "%command.ynx.solidityAnalysisStatus%"
      },
      {
        "command": "ynx.openLocalReview",
        "title": "%command.ynx.openLocalReview%"
      },
      {
        "command": "ynx.configurePython",
        "title": "%command.ynx.configurePython%"
      },
      {
        "command": "ynx.chainProject",
        "title": "%command.ynx.chainProject%"
      },
      {
        "command": "ynx.configureChainProject",
        "title": "%command.ynx.configureChainProject%"
      },
      {
        "command": "ynx.chainProjectHistory",
        "title": "%command.ynx.chainProjectHistory%"
      },
      {
        "command": "ynx.trackChainTransaction",
        "title": "%command.ynx.trackChainTransaction%"
      },
      {
        "command": "ynx.configureSolidityBuild",
        "title": "%command.ynx.configureSolidityBuild%"
      },
      {
        "command": "ynx.cancelSolidityBuild",
        "title": "%command.ynx.cancelSolidityBuild%"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": [
          "**/keybindings.json"
        ],
        "url": "./schemas/keybindings.schema.json"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "ynx.compileSolidity",
          "when": "resourceScheme == file && resourceExtname == .sol",
          "group": "ynx@2"
        },
        {
          "command": "ynx.reviewSelection",
          "when": "ynx.hasSelection && resourceScheme == file",
          "group": "ynx@1"
        },
        {
          "command": "ynx.copySolidityProject",
          "when": "resourceScheme == file && resourceExtname == .sol",
          "group": "ynx@2"
        },
        {
          "command": "ynx.applyReviewedDiff",
          "when": "resourceScheme == file",
          "group": "ynx@3"
        },
        {
          "command": "ynx.importSolidityDiagnostics",
          "when": "resourceScheme == file && resourceExtname == .sol",
          "group": "ynx@4"
        }
      ]
    },
    "keybindings": [
      {
        "command": "ynx.reviewSelection",
        "key": "ctrl+k ctrl+y",
        "mac": "cmd+k cmd+y",
        "when": "editorTextFocus && editorHasSelection && resourceScheme == file"
      }
    ],
    "languages": [
      {
        "id": "solidity",
        "aliases": [
          "Solidity",
          "solidity"
        ],
        "extensions": [
          ".sol"
        ],
        "configuration": "./languages/solidity-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "solidity",
        "scopeName": "source.solidity",
        "path": "./languages/solidity.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "solidity",
        "path": "./languages/solidity.code-snippets"
      }
    ],
    "configuration": {
      "title": "YNX Solidity",
      "properties": {
        "ynx.solidity.build": {
          "type": "object",
          "scope": "resource",
          "additionalProperties": false,
          "required": [
            "entryPath",
            "contractName"
          ],
          "properties": {
            "entryPath": {
              "type": "string",
              "maxLength": 240
            },
            "contractName": {
              "type": "string",
              "pattern": "^[A-Za-z_$][A-Za-z0-9_$]{0,127}$"
            }
          },
          "description": "%configuration.solidity.build%"
        }
      }
    }
  },
  "extensionKind": [
    "workspace"
  ],
  "l10n": "./l10n",
  "description": "%description%"
}
