  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#A4AAB7"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#C2A7ED"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#BAC6D8"
      }
    },
    {
      "scope": [
        "string",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#8DD1BD"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#E4BD87"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#95BCEC"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#89C9AC"
      }
    },
    {
      "scope": [
        "variable",
        "support.variable"
      ],
      "settings": {
        "foreground": "#E7E9EE"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#CDBDEB"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#A7C2ED"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#FFA8B2",
        "background": "#59333D"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#89C9AC",
    "type": "#89C9AC",
    "class": "#89C9AC",
    "interface": "#89C9AC",
    "enum": "#89C9AC",
    "function": "#95BCEC",
    "method": "#95BCEC",
    "parameter": "#CDBDEB",
    "variable": "#E7E9EE",
    "property": "#CDBDEB",
    "enumMember": "#E4BD87"
  }
}
