  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#8E9BB1" } },
    { "scope": ["keyword", "storage.type", "storage.modifier"], "settings": { "foreground": "#86A9FF" } },
    { "scope": ["keyword.operator"], "settings": { "foreground": "#B7C7E8" } },
    { "scope": ["string", "markup.inline.raw"], "settings": { "foreground": "#79D6DF" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character"], "settings": { "foreground": "#E6BB78" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#A6C0FF" } },
    { "scope": ["entity.name.type", "support.type", "entity.name.namespace"], "settings": { "foreground": "#8BD9C5" } },
    { "scope": ["variable", "support.variable"], "settings": { "foreground": "#E8ECF5" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#BCD0EE" } },
    { "scope": ["entity.name.tag", "entity.other.attribute-name"], "settings": { "foreground": "#86A9FF" } },
    { "scope": ["invalid"], "settings": { "foreground": "#FFAFB7", "background": "#59333D" } }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#8BD9C5",
    "type": "#8BD9C5",
    "class": "#8BD9C5",
    "interface": "#8BD9C5",
    "enum": "#8BD9C5",
    "function": "#A6C0FF",
    "method": "#A6C0FF",
    "parameter": "#BCD0EE",
    "variable": "#E8ECF5",
    "property": "#BCD0EE",
    "enumMember": "#E6BB78"
  }
}
