{
  "name": "@ynx/developer-extension-runtime",
  "version": "0.2.0",
  "private": true,
  "description": "Owned YNX Developer workbench and VS Code extension runtime composition",
  "scripts": {
    "build": "npm run test:run-controls && node scripts/sync-owned-workbench.mjs && theia build --mode production && node scripts/sync-owned-workbench.mjs --seal-build",
    "start": "theia start --hostname 127.0.0.1",
    "test:run-controls": "node --test scripts/workbench-controls.test.mjs scripts/go-task-start-ownership.test.mjs scripts/python-terminal-production-build.test.mjs scripts/cpp-owned-debug-cleanup.test.mjs scripts/identity-launch-consumer.test.mjs scripts/local-workspace-context.test.mjs scripts/current-file-debug-routing.test.mjs scripts/ynx-localization.test.mjs"
  },
  "dependencies": {
    "@theia/callhierarchy": "1.76.0",
    "@theia/core": "1.76.0",
    "@theia/debug": "1.76.0",
    "@theia/editor": "1.76.0",
    "@theia/filesystem": "1.76.0",
    "@theia/markers": "1.76.0",
    "@theia/messages": "1.76.0",
    "@theia/monaco": "1.76.0",
    "@theia/navigator": "1.76.0",
    "@theia/outline-view": "1.76.0",
    "@theia/plugin-ext-vscode": "1.76.0",
    "@theia/preferences": "1.76.0",
    "@theia/process": "1.76.0",
    "@theia/scm": "1.76.0",
    "@theia/search-in-workspace": "1.76.0",
    "@theia/task": "1.76.0",
    "@theia/terminal": "1.76.0",
    "@theia/typehierarchy": "1.76.0",
    "@theia/vsx-registry": "1.76.0",
    "@theia/workspace": "1.76.0",
    "@ynx/developer-workbench": "file:../ynx-workbench"
  },
  "devDependencies": {
    "@theia/cli": "1.76.0"
  },
  "theia": {
    "target": "browser",
    "frontend": {
      "config": {
        "applicationName": "YNX Developer",
        "defaultTheme": "YNX Klein Light",
        "defaultIconTheme": "theia-file-icons",
        "preferences": {
          "window.menuBarVisibility": "visible",
          "telemetry.telemetryLevel": "off",
          "files.autoSave": "off",
          "editor.fontSize": 13,
          "typescript.tsserver.useSyntaxServer": "never",
          "javascript.validate.enable": true,
          "typescript.validate.enable": true,
          "terminal.integrated.defaultProfile.osx": "YNX Bash",
          "terminal.integrated.profiles.osx": {
            "YNX Bash": {
              "path": "/bin/bash",
              "args": [
                "--noprofile",
                "--norc"
              ],
              "env": {
                "BASH_SILENCE_DEPRECATION_WARNING": "1"
              }
            }
          },
          "json.schemaDownload.enable": false,
          "files.associations": {
            "keybindings.json": "jsonc",
            "settings.json": "jsonc",
            "launch.json": "jsonc",
            "tasks.json": "jsonc"
          }
        }
      }
    }
  }
}
