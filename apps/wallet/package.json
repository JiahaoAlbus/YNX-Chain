{
  "name": "@ynx-chain/wallet-app",
  "version": "1.0.0",
  "packageManager": "npm@11.5.1",
  "main": "index.ts",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "tsx --test src/*.test.ts src/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "bundle:android": "expo export --platform android --output-dir dist-android",
    "bundle:ios": "expo export --platform ios --output-dir dist-ios",
    "bundle": "npm run bundle:android && npm run bundle:ios",
    "sbom:generate": "node scripts/sbom-check.mjs --write",
    "sbom:check": "node scripts/sbom-check.mjs",
    "release-content:check": "node scripts/release-content-check.mjs",
    "goal-coverage:check": "node scripts/full-goal-coverage-check.mjs",
    "product-check": "node scripts/product-check.mjs",
    "check": "npm run native-patch:check && npm run native-patch:test && npm run typecheck && npm test && npm run product-check && npm run release-content:check && npm run goal-coverage:check && npm run sbom:check && npm run bundle",
    "postinstall": "node scripts/secure-store-native-patch.mjs",
    "native-patch:apply": "node scripts/secure-store-native-patch.mjs",
    "native-patch:check": "node scripts/secure-store-native-patch.mjs --check",
    "native-patch:test": "node --test scripts/secure-store-native-patch.test.mjs"
  },
  "dependencies": {
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.2.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.5.2",
    "@reown/walletkit": "1.6.0",
    "@walletconnect/core": "2.25.0",
    "@walletconnect/react-native-compat": "2.25.0",
    "@walletconnect/types": "2.25.0",
    "@walletconnect/utils": "2.25.0",
    "@ynx-chain/wallet-auth": "file:../../packages/wallet-auth",
    "ethers": "6.17.0",
    "expo": "~57.0.4",
    "expo-application": "7.0.8",
    "expo-clipboard": "57.0.0",
    "expo-crypto": "~57.0.0",
    "expo-local-authentication": "~57.0.0",
    "expo-screen-capture": "57.0.0",
    "expo-secure-store": "57.0.3",
    "expo-status-bar": "~57.0.0",
    "lucide-react-native": "1.24.0",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-get-random-values": "1.11.0",
    "react-native-qrcode-svg": "6.3.21",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "6.0.0",
    "@types/react": "~19.2.2",
    "tsx": "4.23.1",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@walletconnect/keyvaluestorage": {
      "@react-native-async-storage/async-storage": "$@react-native-async-storage/async-storage"
    },
    "brace-expansion": "5.0.9",
    "uuid": "11.1.1"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-secure-store"
        ]
      }
    }
  }
}
