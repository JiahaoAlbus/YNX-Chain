execute_process(COMMAND "${READELF}" --dynamic "${IMAGE}"
 RESULT_VARIABLE result OUTPUT_VARIABLE dynamic ERROR_VARIABLE error)
if(NOT result STREQUAL "0")
 message(FATAL_ERROR "Cannot inspect Wallet Android dependencies: ${error}")
endif()
string(REGEX MATCHALL "\\(NEEDED\\)[^\n]*" needed "${dynamic}")
set(provider_count 0)
foreach(row IN LISTS needed)
 if(NOT row MATCHES "Shared library: \\[([A-Za-z0-9_.+-]+)\\][ \t]*$")
  message(FATAL_ERROR "Nonportable Wallet Android dependency")
 endif()
 if(CMAKE_MATCH_1 STREQUAL "libynx_wallet_pq.so")
  math(EXPR provider_count "${provider_count} + 1")
 endif()
endforeach()
if(NOT provider_count EQUAL 1)
 message(FATAL_ERROR "Wallet Android must depend on one original shared provider")
endif()
