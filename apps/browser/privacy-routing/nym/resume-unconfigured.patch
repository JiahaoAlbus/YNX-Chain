+fn resume_key_binding(paths: &crate::config::disk_persistence::ClientKeysPaths) -> std::io::Result<Vec<(std::path::PathBuf, u64, std::time::SystemTime, [u8; 32])>> {
+    use sha2::{Digest, Sha256};
+    [&paths.private_identity_key_file, &paths.public_identity_key_file, &paths.private_encryption_key_file,
+     &paths.public_encryption_key_file, &paths.ack_key_file].into_iter().map(|path| {
+        let metadata = std::fs::symlink_metadata(path)?;
+        if !metadata.is_file() { return Err(std::io::Error::other("Not a regular key file")); }
+        let hash: [u8; 32] = Sha256::digest(std::fs::read(path)?).into();
+        Ok((path.clone(), metadata.len(), metadata.modified()?, hash))
+    }).collect()
+}
