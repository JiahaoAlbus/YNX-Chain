+/// An empty chunk is not progress. Only positive, size-checked bytes renew the idle clock;
+/// this clock never changes the separately held absolute policy deadline.
+pub struct BodyProgress { maximum: usize, bytes: usize, idle: Duration, last: Instant }
+impl BodyProgress {
+    pub fn new(maximum: usize, idle: Duration) -> Self { Self { maximum, bytes: 0, idle, last: Instant::now() } }
+    pub fn remaining(&self) -> Result<Duration, Failure> {
+        self.idle.checked_sub(self.last.elapsed()).filter(|v| !v.is_zero()).ok_or(Failure::BodyIdleTimedOut)
+    }
+    pub fn advance(&mut self, amount: usize) -> Result<usize, Failure> {
+        self.remaining()?;
+        let next=self.bytes.checked_add(amount).filter(|v| *v<=self.maximum).ok_or(Failure::BodyLimit)?;
+        self.bytes=next;
+        if amount>0 { self.last=Instant::now(); }
+        Ok(next)
+    }
