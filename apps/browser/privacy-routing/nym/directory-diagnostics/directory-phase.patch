+//! Fixed-vocabulary diagnostics: never format a URL, peer, identity, body or raw error.
+use std::{cell::Cell, error::Error, fmt, time::{Duration, Instant}};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Phase { Policy, ClientBuild, RequestBuild, AwaitHeaders, Body, Json, Complete }
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Failure { PolicyExpired, StepTimedOut, ClientBuild, RequestBuild, Transport { timeout: bool, connect: bool, body: bool, decode: bool }, Status, BodyLimit, Json }
+
+pub struct Attempt {
+    endpoint: &'static str, page: Option<u64>, started: Instant, cap: Duration,
+    phase: Cell<Phase>, bytes: Cell<usize>, status: Cell<Option<u16>>,
+}
+impl Attempt {
+    pub fn new(endpoint: &'static str, page: Option<u64>, cap: Duration) -> Self {
+        Self { endpoint, page, started: Instant::now(), cap, phase: Cell::new(Phase::Policy), bytes: Cell::new(0), status: Cell::new(None) }
+    }
+    pub fn phase(&self, value: Phase) { self.phase.set(value); }
+    pub fn status(&self, value: u16) { self.status.set(Some(value)); }
+    pub fn bytes(&self, value: usize) { self.bytes.set(value); }
+    pub fn remaining(&self) -> Result<Duration, Failure> {
+        self.cap.checked_sub(self.started.elapsed()).filter(|v| !v.is_zero()).ok_or(Failure::StepTimedOut)
+    }
+    pub fn record(&self) -> String {
+        format!("directory endpoint={} page={:?} phase={:?} elapsed_ms={} status={:?} body_bytes={}", self.endpoint, self.page, self.phase.get(), self.started.elapsed().as_millis(), self.status.get(), self.bytes.get())
+    }
+    pub fn failure(&self, kind: Failure, source: Option<Box<dyn Error + Send + Sync>>) -> DirectoryFailure {
+        DirectoryFailure { record: self.record(), kind, source }
+    }
+}
+pub struct DirectoryFailure { record: String, kind: Failure, source: Option<Box<dyn Error + Send + Sync>> }
+impl fmt::Display for DirectoryFailure {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result { write!(f, "{} failure={:?}", self.record, self.kind) }
+}
+impl fmt::Debug for DirectoryFailure {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result { fmt::Display::fmt(self, f) }
+}
+impl Error for DirectoryFailure {
+    fn source(&self) -> Option<&(dyn Error + 'static)> { self.source.as_ref().map(|e| e.as_ref() as &(dyn Error + 'static)) }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test] fn body_timeout_retains_phase_and_partial_count() {
+        let a=Attempt::new("basic",Some(0),Duration::from_secs(20)); a.phase(Phase::Body); a.status(200); a.bytes(261800);
+        let s=a.failure(Failure::StepTimedOut,None).to_string();
+        assert!(s.contains("phase=Body") && s.contains("body_bytes=261800") && s.contains("status=Some(200)"));
+    }
+    #[test] fn policy_expiry_is_not_step_timeout() {
+        let a=Attempt::new("epoch",None,Duration::from_secs(20));
+        assert_ne!(a.failure(Failure::PolicyExpired,None).to_string(), a.failure(Failure::StepTimedOut,None).to_string());
+    }
+    #[test] fn retained_source_is_not_formatted() {
+        let a=Attempt::new("described",Some(1),Duration::from_secs(20));
+        let e=a.failure(Failure::Transport{timeout:true,connect:false,body:true,decode:false},Some("secret URL or payload".into()));
+        assert!(e.source().is_some()); assert!(!format!("{e} {e:?}").contains("secret"));
+    }
+    #[test] fn preparation_time_consumes_same_budget() {
+        let mut a=Attempt::new("basic",Some(0),Duration::from_millis(20));
+        a.started=Instant::now()-Duration::from_millis(21);
+        assert_eq!(a.remaining(),Err(Failure::StepTimedOut));
+    }
+}
