+/// SDK-default capability selection DATA, not epoch rewarded-set assignment.
+/// Persistent ingress/egress uses these official defaults, while the runtime
+/// still independently requires both gateways present in its actual topology.
+fn capability_role_allowed(role:&NodeRole, supported_mixnode:bool, ingress:bool, ignore_epoch_role:bool) -> bool {
+    ignore_epoch_role || if ingress {!supported_mixnode} else {!matches!(role,NodeRole::Mixnode{..})}
+}
+fn sdk_capability_flags() -> (bool,bool) {
+    let topology=nym_client_core::config::Topology::default();
+    (topology.ignore_ingress_epoch_role,topology.ignore_egress_epoch_role)
+}
