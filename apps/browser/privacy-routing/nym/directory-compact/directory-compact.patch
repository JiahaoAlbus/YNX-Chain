+/// Official versioned API bincode uses little-endian varints. Reject over-budget input
+/// before decoding, and reject trailing bytes rather than accepting a valid prefix.
+pub fn decode_directory_bincode<T:serde::de::DeserializeOwned>(bytes:&[u8])->Result<T,String> {
+    use nym_http_api_common::BincodeOptions;
+    if bytes.len()>4_194_304 {return Err(invalid("oversized directory bincode"))}
+    nym_http_api_common::make_bincode_serializer().with_limit(4_194_304)
+        .reject_trailing_bytes().deserialize(bytes).map_err(|_|invalid("directory bincode decode"))
+}
