+/// A DATA-only codec result for the same complete snapshot, never a route/Root
+/// capability. The Python QA bridge must not substitute a regex crypto codec.
+fn typed_candidate_ids(basic:&PaginatedCachedNodesResponseV2<SkimmedNodeV1>,described:&PaginatedResponse<NymNodeDescriptionV2>) -> Result<(Vec<u32>,Vec<u32>),String> {
+    let full:BTreeMap<_,_>=described.data.iter().map(|node|(node.node_id,node)).collect();
+    let mut entries=Vec::new();let mut exits=Vec::new();
+    for node in &basic.nodes.data {
+        let Some(description)=full.get(&node.node_id) else {continue};
+        if description.ed25519_identity_key()!=node.ed25519_identity_pubkey {return Err("qa-directory-identity-mismatch".into())}
+        if matches!(node.role,NodeRole::EntryGateway) && node.supported_roles.entry
+            && tls_entry_eligible(node.entry.as_ref(),&description.entry_information())? {entries.push(node.node_id)}
+        if matches!(node.role,NodeRole::ExitGateway) && node.supported_roles.exit_nr
+            && qa_requester_eligible(description.description.network_requester.as_ref(),node.ed25519_identity_pubkey) {exits.push(node.node_id)}
+    }
+    if entries.is_empty() || exits.is_empty() || entries.len().checked_add(exits.len()).is_none_or(|n|n>20_000) {return Err("qa-directory-candidate-count".into())}
+    entries.sort_unstable();exits.sort_unstable();Ok((entries,exits))
+}
