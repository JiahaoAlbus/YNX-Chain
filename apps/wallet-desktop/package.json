{
  "name": "@ynx-chain/wallet-desktop",
  "version": "0.1.0",
  "description": "Fail-closed YNX Testnet Wallet desktop engineering preview",
  "homepage": "https://www.ynxweb4.com/wallet",
  "author": {
    "name": "YNX Chain",
    "email": "support@ynxweb4.com"
  },
  "private": true,
  "type": "module",
  "main": "src/main.mjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "start": "electron .",
    "dist:linux": "electron-builder --linux deb AppImage --x64 --publish never",
    "dist:linux-appimage": "electron-builder --linux AppImage --x64 --publish never",
    "dist:windows": "electron-builder --win nsis --x64 --publish never",
    "dist:windows-arm64": "electron-builder --win nsis --arm64 --publish never",
    "dist:mac": "electron-builder --mac dmg --universal --publish never"
  },
  "dependencies": {
    "@ynx-chain/wallet-auth": "file:../../packages/wallet-auth"
  },
  "devDependencies": {
    "electron": "42.8.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.ynxweb4.wallet.desktop",
    "productName": "YNX Wallet Testnet Preview",
    "artifactName": "ynx-wallet-desktop-${version}-${arch}.${ext}",
    "asar": true,
    "files": [
      "src/**",
      "package.json",
      "node_modules/@ynx-chain/wallet-auth/**",
      "node_modules/@noble/**"
    ],
    "linux": {
      "target": ["deb", "AppImage"],
      "category": "Utility",
      "maintainer": "YNX Chain <support@ynxweb4.com>",
      "executableName": "ynx-wallet-desktop",
      "synopsis": "Fail-closed YNX Testnet Wallet desktop preview",
      "description": "YNX Wallet desktop engineering preview consuming the frozen wallet-auth contract."
    },
    "deb": {
      "depends": ["libgtk-3-0", "libnotify4", "libnss3", "libxss1", "libxtst6", "xdg-utils"]
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.utilities",
      "hardenedRuntime": false
    },
    "win": {
      "target": ["nsis"],
      "executableName": "YNX Wallet Testnet Preview",
      "requestedExecutionLevel": "asInvoker",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false
    }
  }
}
