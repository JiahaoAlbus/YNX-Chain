{
  "name": "@ynx-chain/wallet-desktop",
  "version": "0.6.10",
  "description": "YNX Testnet Wallet for desktop",
  "homepage": "https://www.ynxweb4.com/wallet",
  "author": {
    "name": "YNX Chain",
    "email": "support@ynxweb4.com"
  },
  "private": true,
  "type": "module",
  "main": "src/main.mjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "start": "electron .",
    "dist:linux": "electron-builder --linux deb AppImage --x64 --publish never",
    "dist:linux-appimage": "electron-builder --linux AppImage --x64 --publish never",
    "dist:windows": "electron-builder --win nsis --x64 --publish never",
    "dist:mac": "node scripts/build-mac.mjs",
    "dist:mac:arm64": "node scripts/build-mac.mjs arm64",
    "build:original-auth-native": "node scripts/build-wallet-native-component.mjs"
  },
  "dependencies": {
    "@reown/walletkit": "1.5.6",
    "@walletconnect/core": "2.23.10",
    "@walletconnect/utils": "2.23.10",
    "@ynx-chain/wallet-auth": "file:../../packages/wallet-auth",
    "ethers": "6.17.0",
    "jsqr": "1.4.0",
    "qrcode": "1.5.4",
    "bitcoinjs-lib": "7.0.1",
    "tiny-secp256k1": "2.2.3",
    "tronweb": "6.5.1",
    "ecpair": "3.0.1"
  },
  "devDependencies": {
    "electron": "42.10.0",
    "electron-builder": "26.15.3"
  },
  "overrides": {
    "plist@3.1.0": {
      "@xmldom/xmldom": "0.8.15"
    }
  },
  "build": {
    "appId": "com.ynxweb4.wallet.macos",
    "productName": "YNX Wallet",
    "extraMetadata": {
      "main": "code/apps/wallet-desktop/src/main.mjs"
    },
    "removePackageScripts": false,
    "removePackageKeywords": false,
    "protocols": [
      {
        "name": "YNX Wallet Authorization",
        "schemes": [
          "ynxwallet"
        ]
      }
    ],
    "asar": true,
    "asarUnpack": ["native/original-auth-identity.node"],
    "afterPack": "scripts/after-pack.mjs",
    "files": [
      "src/**",
      "native/original-auth-identity.node",
      "native/original-auth-identity-build.json",
      "native/original-auth-identity-r155-source-intake.json",
      "native/YNXIdentityReceiver",
      "package.json",
      "node_modules/@ynx-chain/wallet-auth/**",
      "!node_modules/@ynx-chain/wallet-auth/native/tests/**",
      "node_modules/@noble/**"
    ],
    "linux": {
      "artifactName": "ynx-wallet-desktop-${version}-${arch}.${ext}",
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Utility",
      "maintainer": "YNX Chain <support@ynxweb4.com>",
      "executableName": "ynx-wallet-desktop",
      "synopsis": "YNX Testnet Wallet",
      "description": "Manage your YNX Testnet accounts, review app connections and approve transactions."
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils"
      ]
    },
    "mac": {
      "signIgnore": ["/Contents/Resources/consensus-proof-verifier/darwin-arm64/ynx-consensus-proof-verify$"],
      "extendInfo": {
        "NSCameraUsageDescription": "Scan a YNX receiving QR code locally. Camera frames are not uploaded, and scanning never authorizes a payment."
      },
      "artifactName": "ynx-wallet-macos-${version}-${arch}.${ext}",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": false,
      "icon": "src/icon.png"
    },
    "win": {
      "artifactName": "ynx-wallet-desktop-${version}-${arch}.${ext}",
      "target": [
        "nsis"
      ],
      "executableName": "YNX Wallet",
      "requestedExecutionLevel": "asInvoker",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false
    }
  }
}
