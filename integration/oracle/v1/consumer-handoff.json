{
  "schemaVersion": 1,
  "productId": "ynx-oracle-market-data",
  "owner": "19 Oracle & Market Data",
  "sourceCommit": "8f4310988a6641c5b023497c74e901ff508771fe",
  "oracleSchema": "ynx.oracle.v1",
  "aggregationPolicyVersion": "weighted-median-mad-v1",
  "derivativesPolicyVersion": "index-funding-mark-v1",
  "normalizerVersion": "observation-normalizer-v1",
  "storeVersion": 3,
  "authorityBoundary": {
    "oracleOwns": [
      "provider registry",
      "signed provider observation validation",
      "market and source coverage enforcement",
      "normalization",
      "spot aggregation",
      "index price derivation",
      "funding reference derivation",
      "mark price derivation",
      "quality and staleness",
      "lineage",
      "corrections",
      "historical replay"
    ],
    "doesNotOwn": [
      "wallet identity",
      "product session issuance",
      "chain consensus",
      "balances",
      "orders",
      "liquidation execution",
      "settlement",
      "mint or burn",
      "bridge release",
      "reserve audit opinion",
      "financial advice"
    ],
    "gatewayRule": "Public reads may be anonymous and rate-limited. Internal ingestion requires canonical Gateway or service admission plus a valid registered reporter signature. Reporter signatures do not replace network admission control.",
    "consensusRule": "Consensus code must never call the Oracle HTTP API. Chain Core must commit an already-validated, versioned Oracle record through deterministic state transition and governance rules."
  },
  "providerInputs": [
    "spot_price",
    "premium_reference",
    "basis_reference",
    "fx",
    "stablecoin_price",
    "stablecoin_reserve_ratio",
    "stablecoin_depeg",
    "ohlcv",
    "trades",
    "clob_order_book",
    "dex_pool_state",
    "dex_twap",
    "interest_rate_candidate",
    "provider_status"
  ],
  "oracleDerivedOutputs": [
    "index_price",
    "funding_reference",
    "mark_price"
  ],
  "contracts": {
    "priceSchema": "integration/oracle/v1/price.schema.json",
    "observationSchema": "integration/oracle/v1/observation.schema.json",
    "marketDataSchema": "integration/oracle/v1/market-data-feed.schema.json",
    "testVectors": "integration/oracle/v1/consumer-test-vectors.json",
    "crossProductTestVectors": "docs/integration/ORACLE_CROSS_PRODUCT_TEST_VECTORS.json",
    "goSdk": "sdk/oracle/go/client.go"
  },
  "api": {
    "genericPrice": "GET /v1/prices?market={market}&type={type}",
    "exchangeIndex": "GET /v1/index?market={market}",
    "exchangeFunding": "GET /v1/funding?market={market}",
    "exchangeMark": "GET /v1/mark?market={market}",
    "providers": "GET /v1/providers",
    "markets": "GET /v1/markets",
    "status": "GET /v1/status",
    "history": "GET /v1/history",
    "corrections": "GET /v1/corrections",
    "replay": "GET /v1/replay",
    "marketData": "GET /v1/market-data",
    "health": "GET /health",
    "version": "GET /version",
    "internalObservation": "POST /internal/v1/observations"
  },
  "consumerRules": {
    "requiredFields": [
      "schema",
      "market",
      "type",
      "value",
      "scale",
      "source",
      "version",
      "asOf",
      "producedAt",
      "quality",
      "observationIds",
      "observationHashes",
      "lineageHash"
    ],
    "derivedRequiredFields": [
      "derivation.method",
      "derivation.policyVersion",
      "derivation.componentTypes",
      "derivation.componentLineageHashes",
      "derivation.clamped"
    ],
    "mustRejectStatus": [
      "degraded",
      "divergent",
      "partial",
      "limited_sources",
      "circuit_breaker",
      "last_good_stale",
      "emergency_pause",
      "paused",
      "unavailable"
    ],
    "mustReject": [
      "stale=true",
      "circuitBreaker=true",
      "failure is non-empty",
      "sourceCount below requiredSourceCount",
      "confidence below consumer policy",
      "coverage below consumer policy",
      "unknown schema or policy version",
      "malformed lineage",
      "clamped derived value"
    ]
  },
  "owners": [
    {
      "product": "Chain Core",
      "consume": ["spot_price", "index_price", "stablecoin_price"],
      "deliver": "deterministic system record containing value, scale, asOf, policy versions, quality, and lineageHash",
      "mustReject": ["HTTP during consensus", "stale or breaker value", "fewer than three sources", "unknown policy version"],
      "acceptanceEvidence": ["state-transition vector", "upgrade and rollback height", "Explorer record"]
    },
    {
      "product": "Exchange",
      "consume": ["index_price", "mark_price", "funding_reference"],
      "deliver": "versioned reference adapter separate from venue trades and order authority",
      "mustReject": ["provider-published index, mark, or funding value", "single venue as index", "last-good stale for liquidation", "clamped derivative", "hidden fallback"],
      "acceptanceEvidence": ["index, mark, and funding vectors", "liquidation breaker drill", "funding spike drill"]
    },
    {
      "product": "DEX",
      "consume": ["dex_twap", "spot_price"],
      "produce": ["dex_pool_state"],
      "deliver": "confirmed pool observations with chain ID, block height, block hash, reserves, and reporter signature",
      "mustReject": ["same-height replacement without correction", "unconfirmed or stale block", "single-block pool spot as authoritative price"],
      "acceptanceEvidence": ["reorg vector", "TWAP window vector", "flash-loan manipulation vector"]
    },
    {
      "product": "Quant",
      "consume": ["spot_price", "ohlcv", "trades", "clob_order_book"],
      "deliver": "Oracle reference facts alongside unchanged raw venue data",
      "mustReject": ["fixture trades in live mode", "structured feed substituted for settlement price"],
      "acceptanceEvidence": ["live and history parity vector", "source lineage display"]
    },
    {
      "product": "Stablecoin and Economics",
      "consume": ["stablecoin_price", "stablecoin_reserve_ratio", "stablecoin_depeg"],
      "deliver": "separate market price, reserve-evidence ratio, and depeg signals",
      "mustReject": ["Oracle value as mint or burn authority", "assumed parity", "reserve ratio without issuer or custodian evidence"],
      "acceptanceEvidence": ["depeg vector", "reserve evidence review", "mint and burn authority separation review"]
    },
    {
      "product": "Finance, Pay, and Bridge",
      "consume": ["spot_price", "fx", "interest_rate_candidate", "stablecoin_price"],
      "deliver": "quote, display, or risk-limit adapter whose expiry derives from asOf",
      "mustReject": ["expired quote", "guaranteed return", "hidden spread or fee", "Oracle price as bridge release proof"],
      "acceptanceEvidence": ["quote expiry vector", "fee disclosure review", "bridge breaker halt drill"]
    },
    {
      "product": "Explorer and Monitor",
      "consume": ["provider_status", "data_correction", "price quality"],
      "deliver": "lineage and correction views plus alerts for stale, divergence, breaker, provider, and policy changes",
      "mustReject": ["green status without fresh evidence", "credential exposure"],
      "acceptanceEvidence": ["public record URL", "alert delivery and recovery timestamps"]
    }
  ],
  "migration": {
    "breakingChange": true,
    "reason": "The former provider observation schema permitted provider-published index, mark, and funding values. These values are now Oracle-owned derived outputs.",
    "providerAction": "Emit spot_price, premium_reference, and basis_reference inputs instead of index_price, mark_price, or funding_reference.",
    "consumerAction": "Consume versioned derived endpoints and validate derivation metadata and policyVersion.",
    "freezeOwner": "29 Integration",
    "compatibilityRule": "Do not retain two authoritative protocols. Legacy provider-derived values must remain rejected after migration."
  },
  "releaseState": {
    "implementedLocal": true,
    "testedLocal": true,
    "installedLocal": true,
    "integratedCentral": false,
    "deployedStaging": false,
    "deployedPublic": false,
    "downloadHosted": false,
    "productionSigned": false,
    "storeReleased": false
  },
  "acceptanceRule": "Each owner must return the named evidence against the exact source commit. File presence alone never sets integratedCentral, deployedStaging, or deployedPublic to true."
}
