{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ynx:oracle:v1:observation",
  "title": "YNX Oracle signed provider observation",
  "description": "Provider-input schema. Index price, mark price, funding reference, stablecoin reserve ratio, correction events, and historical replay are Oracle-derived or Oracle-owned records and are intentionally not valid provider input types.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "providerId", "reporterId", "sequence", "nonceDomain", "market", "type", "value", "scale", "observedAt", "source", "sourceVersion", "signatureHex", "hash"],
  "properties": {
    "schema": {"const": "ynx.oracle.v1"},
    "id": {"type": "string", "minLength": 1, "maxLength": 160},
    "providerId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "reporterId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9:_-]{2,127}$"},
    "sequence": {"type": "integer", "minimum": 1},
    "nonceDomain": {"type": "string", "pattern": "^[a-z0-9][a-z0-9:_-]{2,127}$"},
    "market": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._/-]{2,63}$"},
    "type": {
      "enum": [
        "spot_price",
        "premium_reference",
        "basis_reference",
        "fx",
        "stablecoin_price",
        "stablecoin_reserve_evidence",
        "stablecoin_depeg",
        "ohlcv",
        "trades",
        "clob_order_book",
        "dex_pool_state",
        "interest_rate_candidate",
        "provider_status"
      ]
    },
    "value": {"type": "integer"},
    "scale": {"type": "integer", "minimum": 1},
    "liquidity": {"type": "integer", "minimum": 0},
    "volume24h": {"type": "integer", "minimum": 0},
    "candle": {"$ref": "#/$defs/candle"},
    "trades": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "#/$defs/trade"}},
    "orderBook": {"$ref": "#/$defs/orderBook"},
    "poolState": {"$ref": "#/$defs/poolState"},
    "reserveEvidence": {"$ref": "#/$defs/reserveEvidence"},
    "providerHealth": {"$ref": "#/$defs/providerHealth"},
    "observedAt": {"type": "string", "format": "date-time"},
    "receivedAt": {"type": "string", "format": "date-time", "readOnly": true},
    "source": {"type": "string", "minLength": 1},
    "sourceVersion": {"type": "string", "minLength": 1},
    "signatureHex": {"type": "string", "pattern": "^[a-f0-9]{128}$"},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "oneOf": [
    {
      "properties": {"type": {"enum": ["spot_price", "fx", "stablecoin_price"]}, "value": {"type": "integer", "minimum": 1}},
      "not": {"anyOf": [{"required": ["candle"]}, {"required": ["trades"]}, {"required": ["orderBook"]}, {"required": ["poolState"]}, {"required": ["reserveEvidence"]}, {"required": ["providerHealth"]}]}
    },
    {
      "properties": {"type": {"const": "stablecoin_reserve_evidence"}, "value": {"const": 0}},
      "required": ["reserveEvidence"]
    },
    {
      "properties": {"type": {"const": "stablecoin_depeg"}, "value": {"enum": [0, 1]}},
      "not": {"anyOf": [{"required": ["candle"]}, {"required": ["trades"]}, {"required": ["orderBook"]}, {"required": ["poolState"]}, {"required": ["reserveEvidence"]}, {"required": ["providerHealth"]}]}
    },
    {
      "properties": {"type": {"enum": ["premium_reference", "basis_reference", "interest_rate_candidate"]}, "value": {"type": "integer"}},
      "not": {"anyOf": [{"required": ["candle"]}, {"required": ["trades"]}, {"required": ["orderBook"]}, {"required": ["poolState"]}, {"required": ["reserveEvidence"]}, {"required": ["providerHealth"]}]}
    },
    {"properties": {"type": {"const": "ohlcv"}, "value": {"const": 0}}, "required": ["candle"]},
    {"properties": {"type": {"const": "trades"}, "value": {"const": 0}}, "required": ["trades"]},
    {"properties": {"type": {"const": "clob_order_book"}, "value": {"const": 0}}, "required": ["orderBook"]},
    {"properties": {"type": {"const": "dex_pool_state"}, "value": {"const": 0}}, "required": ["poolState"]},
    {"properties": {"type": {"const": "provider_status"}, "value": {"const": 0}}, "required": ["providerHealth"]}
  ],
  "$defs": {
    "candle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["open", "high", "low", "close", "volume", "intervalStart", "intervalEnd"],
      "properties": {
        "open": {"type": "integer", "minimum": 1},
        "high": {"type": "integer", "minimum": 1},
        "low": {"type": "integer", "minimum": 1},
        "close": {"type": "integer", "minimum": 1},
        "volume": {"type": "integer", "minimum": 0},
        "intervalStart": {"type": "string", "format": "date-time"},
        "intervalEnd": {"type": "string", "format": "date-time"}
      }
    },
    "trade": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "price", "amount", "side", "at"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "price": {"type": "integer", "minimum": 1},
        "amount": {"type": "integer", "minimum": 1},
        "side": {"enum": ["buy", "sell"]},
        "at": {"type": "string", "format": "date-time"}
      }
    },
    "depthLevel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["price", "amount"],
      "properties": {"price": {"type": "integer", "minimum": 1}, "amount": {"type": "integer", "minimum": 1}}
    },
    "orderBook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "bids", "asks"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "bids": {"type": "array", "minItems": 1, "maxItems": 2000, "items": {"$ref": "#/$defs/depthLevel"}},
        "asks": {"type": "array", "minItems": 1, "maxItems": 2000, "items": {"$ref": "#/$defs/depthLevel"}}
      }
    },
    "poolState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chainId", "pool", "token0", "token1", "token0Decimals", "token1Decimals", "reserve0", "reserve1", "blockNumber", "blockHash", "parentBlockHash", "blockTime", "confirmations"],
      "properties": {
        "chainId": {"type": "string", "minLength": 1},
        "pool": {"type": "string", "minLength": 1},
        "token0": {"type": "string", "minLength": 1},
        "token1": {"type": "string", "minLength": 1},
        "token0Decimals": {"type": "integer", "minimum": 0, "maximum": 38},
        "token1Decimals": {"type": "integer", "minimum": 0, "maximum": 38},
        "reserve0": {"type": "string", "maxLength": 78, "pattern": "^0*[1-9][0-9]*$"},
        "reserve1": {"type": "string", "maxLength": 78, "pattern": "^0*[1-9][0-9]*$"},
        "blockNumber": {"type": "integer", "minimum": 1},
        "blockHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "parentBlockHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "blockTime": {"type": "string", "format": "date-time"},
        "confirmations": {"type": "integer", "minimum": 1}
      }
    },
    "providerHealth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "latencyMillis"],
      "properties": {
        "status": {"enum": ["up", "degraded", "down"]},
        "latencyMillis": {"type": "integer", "minimum": 0},
        "lastSuccess": {"type": "string", "format": "date-time"},
        "failure": {"type": "string"}
      }
    },
    "reserveEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attestationVersion", "evidenceId", "issuerId", "attestorId", "assuranceStandard", "jurisdiction", "unit", "reserveAssets", "outstandingClaims", "reportingPeriodEnd", "publishedAt", "expiresAt", "documentHash", "conclusion", "attestationSignatureHex"],
      "properties": {
        "attestationVersion": {"const": "reserve-attestation-ed25519-v1"},
        "evidenceId": {"type": "string", "minLength": 1},
        "issuerId": {"type": "string", "minLength": 1},
        "attestorId": {"type": "string", "minLength": 1},
        "assuranceStandard": {"type": "string", "minLength": 1},
        "jurisdiction": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._/-]{2,63}$"},
        "reserveAssets": {"type": "string", "maxLength": 78, "pattern": "^0*[1-9][0-9]*$"},
        "outstandingClaims": {"type": "string", "maxLength": 78, "pattern": "^0*[1-9][0-9]*$"},
        "reportingPeriodEnd": {"type": "string", "format": "date-time"},
        "publishedAt": {"type": "string", "format": "date-time"},
        "expiresAt": {"type": "string", "format": "date-time"},
        "documentHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "conclusion": {"enum": ["unmodified", "qualified", "adverse", "disclaimer"]},
        "attestationSignatureHex": {"type": "string", "pattern": "^[a-f0-9]{128}$"}
      }
    }
  }
}
