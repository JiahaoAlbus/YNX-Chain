{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ynx:oracle:v1:price",
  "title": "YNX Oracle aggregated or derived scalar market value",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "market", "type", "value", "scale", "source", "version", "asOf", "producedAt", "quality", "observationIds", "observationHashes", "lineageHash"],
  "properties": {
    "schema": {"const": "ynx.oracle.v1"},
    "market": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._/-]{2,63}$"},
    "type": {
      "enum": [
        "spot_price",
        "index_price",
        "mark_price",
        "funding_reference",
        "premium_reference",
        "basis_reference",
        "fx",
        "stablecoin_price",
        "stablecoin_reserve_ratio",
        "stablecoin_depeg",
        "dex_twap",
        "interest_rate_candidate"
      ]
    },
    "value": {"type": "integer"},
    "scale": {"type": "integer", "minimum": 1},
    "source": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "asOf": {"type": "string", "format": "date-time"},
    "producedAt": {"type": "string", "format": "date-time"},
    "quality": {"$ref": "#/$defs/quality"},
    "observationIds": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "observationHashes": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "lineageHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "derivation": {"$ref": "#/$defs/derivation"}
  },
  "allOf": [
    {
      "if": {"properties": {"type": {"enum": ["spot_price", "index_price", "mark_price", "fx", "stablecoin_price", "dex_twap"]}}, "required": ["type"]},
      "then": {"properties": {"value": {"type": "integer", "minimum": 1}}}
    },
    {
      "if": {"properties": {"type": {"enum": ["funding_reference", "premium_reference", "basis_reference", "interest_rate_candidate"]}}, "required": ["type"]},
      "then": {"properties": {"value": {"type": "integer"}}}
    },
    {
      "if": {"properties": {"type": {"const": "stablecoin_reserve_ratio"}}, "required": ["type"]},
      "then": {"properties": {"value": {"type": "integer", "minimum": 0}}}
    },
    {
      "if": {"properties": {"type": {"const": "stablecoin_depeg"}}, "required": ["type"]},
      "then": {"properties": {"value": {"enum": [0, 1]}}}
    },
    {
      "if": {"properties": {"type": {"enum": ["index_price", "mark_price", "funding_reference"]}}, "required": ["type"]},
      "then": {"required": ["derivation"]},
      "else": {"not": {"required": ["derivation"]}}
    },
    {
      "if": {"properties": {"type": {"const": "index_price"}}, "required": ["type"]},
      "then": {
        "properties": {
          "derivation": {
            "allOf": [
              {"$ref": "#/$defs/derivation"},
              {
                "properties": {
                  "method": {"const": "liquidity_weighted_median_spot_index"},
                  "policyVersion": {"const": "index-funding-mark-v1"},
                  "componentTypes": {"prefixItems": [{"const": "spot_price"}], "minItems": 1, "maxItems": 1},
                  "clamped": {"const": false}
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {"properties": {"type": {"const": "funding_reference"}}, "required": ["type"]},
      "then": {
        "properties": {
          "scale": {"const": 1000000},
          "derivation": {
            "allOf": [
              {"$ref": "#/$defs/derivation"},
              {
                "required": ["fundingWindowSeconds", "rawAdjustmentPpm", "appliedAdjustmentPpm", "clampPpm"],
                "properties": {
                  "method": {"const": "premium_plus_basis_with_governance_clamp"},
                  "policyVersion": {"const": "index-funding-mark-v1"},
                  "componentTypes": {"prefixItems": [{"const": "premium_reference"}, {"const": "basis_reference"}], "minItems": 2, "maxItems": 2}
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {"properties": {"type": {"const": "mark_price"}}, "required": ["type"]},
      "then": {
        "properties": {
          "derivation": {
            "allOf": [
              {"$ref": "#/$defs/derivation"},
              {
                "required": ["fundingWindowSeconds", "rawAdjustmentPpm", "appliedAdjustmentPpm", "clampPpm"],
                "properties": {
                  "method": {"const": "index_times_one_plus_funding_reference"},
                  "policyVersion": {"const": "index-funding-mark-v1"},
                  "componentTypes": {"prefixItems": [{"const": "index_price"}, {"const": "funding_reference"}], "minItems": 2, "maxItems": 2}
                }
              }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "stale", "sourceCount", "requiredSourceCount", "rejectedSources", "divergencePpm", "confidencePpm", "coveragePpm", "circuitBreaker"],
      "properties": {
        "status": {"enum": ["good", "degraded", "divergent", "partial", "corrected", "limited_sources", "circuit_breaker", "last_good_stale", "emergency_pause", "paused", "unavailable"]},
        "stale": {"type": "boolean"},
        "sourceCount": {"type": "integer", "minimum": 0},
        "requiredSourceCount": {"type": "integer", "minimum": 0},
        "rejectedSources": {"type": "array", "items": {"type": "string"}},
        "sourceLimitation": {"type": "string"},
        "divergencePpm": {"type": "integer", "minimum": 0},
        "confidencePpm": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "coveragePpm": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "circuitBreaker": {"type": "boolean"},
        "failure": {"type": "string"}
      }
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "policyVersion", "componentTypes", "componentLineageHashes", "clamped"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "policyVersion": {"type": "string", "minLength": 1},
        "componentTypes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "componentLineageHashes": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
        "fundingWindowSeconds": {"type": "integer", "minimum": 1},
        "premiumPpm": {"type": "integer"},
        "basisPpm": {"type": "integer"},
        "rawAdjustmentPpm": {"type": "integer"},
        "appliedAdjustmentPpm": {"type": "integer"},
        "clampPpm": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "clamped": {"type": "boolean"}
      }
    }
  }
}
