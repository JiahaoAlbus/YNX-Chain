{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ynx.network/data-fabric/candidates/ecosystem-sharing-events-v1.schema.json",
  "title": "YNX Ecosystem Sharing Events v1 Candidate",
  "description": "Unactivated privacy-safe canonical event candidate for media, Creator Studio, and Calendar. It stores only content digests, opaque references, permission summaries, owner pseudonyms, version and audit data; it never stores private content or keys.",
  "x-contract-status": "CANDIDATE",
  "x-activation": "PROHIBITED_UNTIL_INTEGRATION_ACCEPTANCE",
  "x-owner": "data-fabric",
  "x-review-target": "integration",
  "x-runtime-boundary": "This candidate neither grants access nor changes product authority. Product consent, policy, access, and revocation decisions remain with their owning product until Integration accepts a contract and each producer is explicitly onboarded.",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventType", "schemaVersion", "tenant", "product", "service", "aggregateId", "ownerReference", "correlationId", "causationId", "sequence", "occurredAt", "effectiveAt", "sourceCommit", "sourceRelease", "contentDigest", "dataReference", "permissionSummary", "version", "privacyClass", "retention", "auditId"],
  "properties": {
    "eventId": {"$ref": "#/$defs/id"},
    "eventType": {"enum": ["media.asset.published", "media.asset.versioned", "media.asset.shared", "media.access.granted", "media.access.revoked", "media.asset.deleted", "creator.revenue.accrued", "creator.revenue.corrected", "calendar.event.created", "calendar.event.shared", "calendar.event.cancelled"]},
    "schemaVersion": {"const": "1.0"},
    "tenant": {"$ref": "#/$defs/slug"},
    "product": {"enum": ["video", "music", "social", "creator", "calendar", "shop", "cloud"]},
    "service": {"$ref": "#/$defs/slug"},
    "aggregateId": {"$ref": "#/$defs/id"},
    "ownerReference": {"type": "string", "pattern": "^po_[A-Za-z0-9_-]{16,96}$", "description": "Per-product owner pseudonym, never an account address or cross-product public identifier."},
    "correlationId": {"$ref": "#/$defs/id"},
    "causationId": {"$ref": "#/$defs/id"},
    "sequence": {"type": "integer", "minimum": 1},
    "occurredAt": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "effectiveAt": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
    "sourceRelease": {"type": "string", "minLength": 1, "maxLength": 128},
    "contentDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "dataReference": {"type": "string", "pattern": "^ref_[A-Za-z0-9._:-]{8,127}$", "description": "Opaque product-owned reference; no content URI, message, file name, recipient list, token, or key."},
    "permissionSummary": {"type": "object", "additionalProperties": false, "required": ["state", "policyVersion", "authorized"], "properties": {"state": {"enum": ["private", "shared", "revoked", "deleted", "restricted"]}, "policyVersion": {"type": "string", "minLength": 1, "maxLength": 64}, "authorized": {"type": "boolean"}}},
    "version": {"type": "integer", "minimum": 1},
    "privacyClass": {"enum": ["pseudonymous", "restricted-metadata"]},
    "retention": {"enum": ["operational", "audit-7y", "legal-hold"]},
    "auditId": {"$ref": "#/$defs/id"},
    "chainCommitmentId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$", "description": "Optional external Chain Core Bulk Data Commitment reference. It is not generated, mutated, or treated as permission authority by Data Fabric."}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"}, "slug": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"}}
}
