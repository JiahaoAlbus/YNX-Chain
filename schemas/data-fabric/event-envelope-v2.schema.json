{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ynx.network/data-fabric/event-envelope-v2.schema.json",
  "title": "YNX Canonical Event Envelope v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "producer",
    "product",
    "service",
    "aggregateType",
    "aggregateId",
    "actor",
    "actorId",
    "accountId",
    "productSessionId",
    "correlationId",
    "traceId",
    "requestId",
    "sequence",
    "timestamp",
    "occurredAt",
    "effectiveAt",
    "receivedAt",
    "sourceCommit",
    "sourceRelease",
    "integrity",
    "integrityHash",
    "signature",
    "privacyClassification",
    "retentionClass",
    "residencyClass",
    "auditId",
    "idempotencyKey",
    "partitionKey",
    "orderingKey",
    "source",
    "payload",
    "metadata"
  ],
  "properties": {
    "eventId": {"$ref": "#/$defs/id"},
    "eventType": {"$ref": "#/$defs/eventType"},
    "schemaVersion": {"const": "2.0"},
    "producer": {"$ref": "#/$defs/producer"},
    "product": {"$ref": "#/$defs/slug"},
    "service": {"$ref": "#/$defs/slug"},
    "aggregateType": {"$ref": "#/$defs/producer"},
    "aggregateId": {"$ref": "#/$defs/id"},
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actorId", "accountId", "sessionId"],
      "properties": {
        "actorId": {"$ref": "#/$defs/id"},
        "accountId": {"$ref": "#/$defs/id"},
        "sessionId": {"$ref": "#/$defs/id"}
      }
    },
    "actorId": {"$ref": "#/$defs/id"},
    "accountId": {"$ref": "#/$defs/id"},
    "productSessionId": {"$ref": "#/$defs/id"},
    "correlationId": {"$ref": "#/$defs/id"},
    "causationId": {"$ref": "#/$defs/id"},
    "traceId": {"$ref": "#/$defs/id"},
    "requestId": {"$ref": "#/$defs/id"},
    "sequence": {"type": "integer", "minimum": 1},
    "timestamp": {"$ref": "#/$defs/timestamp"},
    "occurredAt": {"$ref": "#/$defs/timestamp"},
    "effectiveAt": {"$ref": "#/$defs/timestamp"},
    "receivedAt": {"$ref": "#/$defs/timestamp"},
    "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
    "sourceRelease": {"type": "string", "minLength": 1},
    "integrity": {"$ref": "#/$defs/integrity"},
    "integrityHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "privacyClassification": {"enum": ["public", "internal", "confidential", "restricted"]},
    "retentionClass": {"enum": ["transient", "operational", "financial-7y", "audit-7y", "legal-hold"]},
    "residencyClass": {"enum": ["global", "regional", "account-home", "legal-hold"]},
    "auditId": {"$ref": "#/$defs/id"},
    "chainCommitmentId": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "idempotencyKey": {"$ref": "#/$defs/id"},
    "partitionKey": {"$ref": "#/$defs/id"},
    "orderingKey": {"$ref": "#/$defs/id"},
    "source": {"$ref": "#/$defs/source"},
    "payload": {"type": "object"},
    "metadata": {
      "type": "object",
      "propertyNames": {"minLength": 1, "maxLength": 64},
      "additionalProperties": {"type": "string", "maxLength": 1024}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"},
    "slug": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
    "producer": {
      "type": "string",
      "anyOf": [
        {"pattern": "^[a-z][a-z0-9-]{1,63}$"},
        {"pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"}
      ]
    },
    "eventType": {"type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_-]*){2,7}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "digest", "signature"],
      "properties": {
        "algorithm": {"const": "hmac-sha256"},
        "keyId": {"$ref": "#/$defs/id"},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "signature": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "asOf", "version", "status"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "asOf": {"$ref": "#/$defs/timestamp"},
        "version": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "status": {"enum": ["authoritative", "third-party", "estimated", "ai-inferred", "cached", "user-input", "unavailable"]},
        "failure": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "unavailable"}}, "required": ["status"]},
          "then": {"required": ["failure"], "properties": {"failure": {"minLength": 1}}}
        }
      ]
    }
  }
}
