{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ynx.network/data-fabric/accepted/wallet-connectivity-events-v1.schema.json",
  "title": "YNX Accepted Wallet Connectivity Events v1",
  "description": "Integration-accepted asynchronous observer input for Data Fabric runtime adapters. It is not a Wallet, Gateway, signing, transaction, Card funding, or UI control-plane contract.",
  "x-contract-id": "connectionEvents",
  "x-contract-status": "ACCEPTED",
  "x-contract-version": "1.0.0-p0.0",
  "x-schema-version": "1.0",
  "x-accepted-by": "integration",
  "x-acceptance-commit": "e13fca35d890427a25bff9d6122e7c7581247cdb",
  "x-source-candidate": "schemas/data-fabric/wallet-connectivity-events-v1.candidate.schema.json@63a7d633a10bcb8f7f929a2aa67af32074f49ea7",
  "x-runtime-adapter": "internal/datafabric.ConnectionEvent",
  "x-synchronous-boundary": "Producer failure is observable only. Data Fabric, broker, ledger, analytics and diagnostics must never block or translate into Wallet Offline for DApp connect, Wallet approval, standard Wallet connection, signing, transaction, or Product Session outcome.",
  "x-card-boundary": "card.funded is outside this contract. Canonical Card funding recipient remains PENDING_CHAIN_ACCOUNT_ISSUANCE and no funding or balance event may be inferred from a callback, deep link, or UI.",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventType", "schemaVersion", "tenant", "product", "platform", "transport", "connectionId", "sessionClass", "chainId", "result", "errorClass", "retryable", "correlationId", "causationId", "sequence", "sourceCommit", "releaseId", "timestamp", "effectiveAt", "privacyClass", "retention", "auditId", "payloadHash", "status"],
  "properties": {
    "eventId": {"$ref": "#/$defs/id"},
    "eventType": {"enum": ["wallet.connection.requested", "wallet.connection.approved", "wallet.connection.rejected", "wallet.connection.established", "wallet.connection.disconnected", "wallet.connection.recovered", "wallet.connection.expired", "wallet.connection.revoked", "product.session.upgrade.requested", "product.session.upgrade.completed", "product.session.upgrade.failed", "product.session.revoked", "walletconnect.pairing.created", "walletconnect.session.established", "walletconnect.session.disconnected", "endpoint.health.degraded", "endpoint.health.recovered", "endpoint.schema.mismatch", "faucet.requested", "faucet.completed", "faucet.failed", "client.retired", "client.retired.connection_rejected"]},
    "schemaVersion": {"const": "1.0"},
    "tenant": {"$ref": "#/$defs/slug"},
    "product": {"$ref": "#/$defs/slug"},
    "platform": {"enum": ["web", "ios", "android", "desktop", "extension", "server", "unknown"]},
    "transport": {"enum": ["eip1193", "eip6963", "walletconnect-v2", "deep-link", "product-session", "gateway", "faucet", "unknown"]},
    "connectionId": {"type": "string", "pattern": "^pc_[A-Za-z0-9_-]{16,96}$"},
    "sessionClass": {"enum": ["standard-wallet", "product-session", "walletconnect", "none"]},
    "chainId": {"const": "0x1917", "description": "Canonical YNX Wallet Testnet identity. Producers may normalize decimal 6423 only through the asynchronous Data Fabric adapter; legacy 9102 and every other chain are rejected."},
    "result": {"enum": ["requested", "approved", "rejected", "established", "disconnected", "recovered", "expired", "revoked", "completed", "failed", "degraded"]},
    "errorClass": {"enum": ["none", "user-rejected", "device-proof", "device-key", "session-binding", "protocol", "expiry-or-clock-skew", "callback", "registry", "endpoint-schema", "gateway-unavailable", "relay-unavailable", "client-retired", "faucet-not-accepted", "faucet-pending-finality", "unknown"]},
    "retryable": {"type": "boolean"},
    "correlationId": {"$ref": "#/$defs/id"},
    "causationId": {"$ref": "#/$defs/id"},
    "sequence": {"type": "integer", "minimum": 1},
    "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
    "releaseId": {"type": "string", "minLength": 1, "maxLength": 128},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "effectiveAt": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "privacyClass": {"const": "pseudonymous"},
    "retention": {"enum": ["operational", "audit-7y"]},
    "auditId": {"$ref": "#/$defs/id"},
    "payloadHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "status": {"enum": ["queued", "pending", "published", "dead-letter"]},
    "diagnostic": {"type": "object", "additionalProperties": false, "properties": {"httpStatusClass": {"enum": ["none", "400", "403", "other"]}, "endpointClass": {"enum": ["gateway", "relay", "faucet", "registry", "callback", "unknown"]}, "clientVersion": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,1})\\.[0-9]{1,3}\\.[0-9]{1,3}$"}}},
    "faucet": {"type": "object", "additionalProperties": false, "required": ["acceptanceId", "txHash", "authoritativeReceiptId", "finality"], "properties": {"acceptanceId": {"$ref": "#/$defs/id"}, "txHash": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"}, "authoritativeReceiptId": {"$ref": "#/$defs/id"}, "finality": {"const": "finalized"}}}
  },
  "allOf": [{"if": {"properties": {"eventType": {"const": "faucet.completed"}}, "required": ["eventType"]}, "then": {"required": ["faucet"], "properties": {"transport": {"not": {"const": "deep-link"}}, "result": {"const": "completed"}, "errorClass": {"const": "none"}, "retryable": {"const": false}}}}],
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"}, "slug": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"}}
}
