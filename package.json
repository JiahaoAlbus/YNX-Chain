{
  "name": "ynx-chain-contract-tooling",
  "version": "0.0.0-private",
  "private": true,
  "type": "module",
  "scripts": {
    "contracts:check": "bash ./scripts/verify/contract-tooling-check.sh",
    "contracts:selectors": "node ./scripts/contracts/generate-selector-metadata.mjs",
    "hardhat:build": "hardhat build",
    "hardhat:test:wallet": "hardhat run ./scripts/contracts/test-smart-account-hardhat.js",
    "hardhat:deploy:wallet-smart-account": "hardhat run ./scripts/contracts/deploy-wallet-smart-account.js --network ynxTestnet",
    "dex:contracts:test": "hardhat run ./scripts/dex/contract-test.mjs --config hardhat.dex.config.ts --network dexTest",
    "dex:vault:test": "hardhat run ./scripts/dex/vault-test.mjs --config hardhat.dex.config.ts --network dexTest",
    "dex:fairflow:test": "hardhat run ./scripts/dex/fairflow-test.mjs --config hardhat.dex.config.ts --network dexTest",
    "dex:concentrated:test": "hardhat run ./scripts/dex/concentrated-test.mjs --config hardhat.dex.config.ts --network dexTest",
    "dex:stable:test": "hardhat run ./scripts/dex/stable-test.mjs --config hardhat.dex.config.ts --network dexTest",
    "dex:lp-protection:test": "hardhat run ./scripts/dex/lp-protection-test.mjs --config hardhat.dex.config.ts --network dexTest",
    "dex:deploy:testnet": "hardhat run ./scripts/dex/deploy-testnet.mjs --config hardhat.dex.config.ts --network ynxTestnet",
    "dex:manifests:check": "node ./scripts/dex/check-manifests.mjs",
    "dex:testnet:probe": "node ./scripts/dex/probe-testnet.mjs",
    "dex:package:all": "hardhat build --config hardhat.dex.config.ts && npm run package:pwa --prefix apps/dex && node ./scripts/dex/package-all.mjs",
    "dex:artifacts:verify": "node ./scripts/dex/verify-artifacts.mjs",
    "hardhat:deploy:ynx-testnet": "hardhat run ./scripts/contracts/deploy-samples-hardhat.js --network ynxTestnet"
  },
  "devDependencies": {
    "@account-abstraction/contracts": "0.8.0",
    "@noble/curves": "1.4.2",
    "@noble/hashes": "1.4.0",
    "@nomicfoundation/hardhat-ethers": "^4.0.15",
    "ethers": "^6.17.0",
    "hardhat": "^3.11.1",
    "typescript": "^5.9.0",
    "undici": "^6.27.0"
  },
  "overrides": {
    "adm-zip": "0.6.0"
  }
}
