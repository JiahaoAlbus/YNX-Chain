      "authority": "verified provider event after local provider submission",
      "providerAdapter": "resend",
      "truthRules": [
        "HTTP success is provider acceptance only",
        "provider delivered means receiving mail server accepted the message",
        "opened or clicked never becomes YNX user-read state",
        "webhook event IDs are persistent replay keys",
        "older events cannot downgrade newer delivery facts"
      ]
    }
