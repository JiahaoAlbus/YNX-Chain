          "messageId",
          "cost"
        ]
      },
      {
        "name": "error",
        "requiredFields": [
          "generationId",
          "error",
          "retryable"
        ]
      }
    ],
    "providerFailureCreatesAssistantMessage": false
  },
  "generationCancellation": {
    "route": "POST /api/generations/{generationId}/cancel",
    "requiredScope": "ai:generate",
    "ownerBinding": "Wallet account",
    "wrongAccountStatus": 404,
    "activeOwnerStatus": 202,
    "existenceDisclosureToOtherAccounts": false
  },
  "toolApproval": {
    "adviceOnly": true,
    "states": [
