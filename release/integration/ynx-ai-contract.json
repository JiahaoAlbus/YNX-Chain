  },
  "network": {
    "cosmosChainId": "ynx_6423-1",
    "evmChainId": 6423,
    "nativeAsset": "YNXT",
    "environment": "testnet"
  },
  "walletAuth": {
    "owner": "02-wallet-auth",
    "registrySchemaVersion": 2,
    "productClientId": "ynx-ai-v1",
    "requestingProduct": "ai",
    "bundleId": "com.ynxweb4.ai",
    "callbacks": [
      "ynxai://wallet-auth/callback"
    ],
    "deviceAlgorithms": [
      "p256-sha256"
    ],
    "orderedScopes": [
      "ai:actions",
      "ai:attachments",
      "ai:conversations",
      "ai:data-control",
      "ai:generate",
      "ai:permissions"
    ],
    "maxSessionSeconds": 300,
    "requiredVerifier": "verifyCentralWalletSession",
    "requiredActiveGuard": "assertCentralWalletSessionActive",
    "failClosedUntilAccepted": true,
    "localFixtureAuthIsProductionAuthority": false
  },
  "generationGateway": {
    "owner": "14-ai",
    "route": "POST /ai/stream",
    "requestMediaType": "application/json",
    "responseMediaType": "text/event-stream",
    "maxBodyBytes": 2097152,
    "queryParametersAllowed": false,
    "unknownFieldsAllowed": false,
    "request": {
      "required": [
        "session",
        "prompt",
        "outputLanguage",
        "includedContext",
        "excludedContext",
        "attachments",
        "continueFrom"
      ],
      "maxSessionCharacters": 128,
      "maxPromptCharacters": 8000,
      "maxContextEntries": 8,
      "maxProductContextEntries": 8,
      "maxAttachments": 8,
      "maxAttachmentNameCharacters": 160,
      "maxAttachmentTextBytes": 262144,
      "maxContinueFromCharacters": 120,
      "allowedAttachmentMediaTypes": [
        "text/plain",
        "text/markdown",
        "application/json"
      ],
      "allowedContextTypes": [
        "conversation",
        "selected_chain_records",
        "selected_files",
        "selected_trust_records",
        "selected_product_context"
      ],
      "attachmentContextRequirement": "selected_files must be explicitly included",
      "productContextRequirement": "selected_product_context plus exact registry policy, explicit selection, freshness, byte budget, source version, reference hashes, and permission when required",
      "supportedOutputLanguages": [
        "en",
        "zh-CN",
        "zh-TW",
        "ja",
        "ko",
        "es",
        "fr",
        "de",
        "pt",
        "ru",
        "ar",
        "id"
      ]
    },
    "events": [
      {
        "name": "metadata",
        "requiredFields": [
          "requestId",
          "sessionId"
        ]
      },
      {
        "name": "token",
        "requiredFields": [
          "text"
        ]
      },
      {
        "name": "done",
        "requiredFields": [
          "requestId"
        ]
      }
    ],
    "audit": {
      "rawPromptStored": false,
      "rawAttachmentStored": false,
      "rawProductContextStored": false,
      "originalPromptHashStored": true,
      "requestIdStored": true,
      "productContextFields": ["accountHash", "productId", "contextType", "dataClass", "sourceOwner", "sourceVersion", "asOf", "permissionId", "referenceHashes"]
    },
    "errorEnvelope": {
      "fields": [
        "code",
        "error",
        "requestId"
      ],
      "providerBodyExposed": false
    }
  },
  "productAIRegistry": {
    "schemaVersion": "ynx.ai.product-registry.v1",
    "registryVersion": "1.0.0",
    "path": "internal/aiproduct/product-ai-registry.json",
    "productCount": 24,
    "products": ["ai", "wallet", "social", "pay", "card", "exchange", "quant", "shop", "seller", "developer", "explorer", "monitor", "trust", "resource", "cloud", "browser", "search", "finance", "mail", "music", "video", "creator-studio", "docs", "calendar"],
    "defaultPolicy": "deny",
    "unknownProduct": "deny",
    "unknownContext": "deny",
    "crossProductReuse": "deny",
    "secretBearingContext": "deny",
    "toolExecution": "deny",
    "publicProductEndpoint": "GET /api/product-ai-registry",
    "gatewayContextContent": "metadata-and-reference-hashes-only until an accepted owner adapter explicitly supplies content"
  },
  "productGenerationStream": {
    "route": "POST /api/conversations/{id}/generate",
    "responseMediaType": "text/event-stream",
    "events": [
      {
        "name": "metadata",
        "requiredFields": [
          "generationId",
          "provider",
          "model",
          "actualUsageReported"
