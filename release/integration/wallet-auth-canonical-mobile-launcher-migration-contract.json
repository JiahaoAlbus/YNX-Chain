      "androidRequiredCalls": ["resolveActivity", "queryIntentActivities"],
      "explicitComponentAfterExactResolution": "com.ynxweb4.wallet/.MainActivity",
      "allowedResults": [
        {"opened": true},
        {"opened": false, "code": "WALLET_NOT_INSTALLED"},
        {"opened": false, "code": "SCHEME_NOT_REGISTERED"},
        {"opened": false, "code": "USER_REJECTED"},
        {"opened": false, "code": "NETWORK_UNAVAILABLE"}
      ],
      "rawActivityNotFoundExposed": false,
      "unavailableActions": ["download-ynx-wallet", "download-metamask", "guest", "return-to-product"]
    },
    "callback": {
      "create": "createCallbackURL",
      "parse": "parseCallbackURL",
      "approveVerify": "verifyAuthorization",
      "rejectVerify": "verifyAuthorizationRejection",
      "queryFields": ["response"],
      "registrySubstitutionAllowed": false,
      "callbackSubstitutionAllowed": false
    }
  },
