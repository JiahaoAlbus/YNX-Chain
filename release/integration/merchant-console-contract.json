    {"owner": "28-website", "contract": "canonical microsite, downloads, support/privacy/security/status and SEO", "state": "metadataPrepared"},
    {"owner": "29-integration", "contract": "protocol freeze and shared Testnet acceptance", "state": "pendingSubmission"},
    {"owner": "30-security-sre", "contract": "release, provenance, hosting, backup and incident standards", "state": "localPartial"}
