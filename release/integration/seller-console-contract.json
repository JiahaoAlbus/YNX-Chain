{
  "schemaVersion": 1,
  "contractId": "ynx-seller-console-integration-v1",
  "product": {
    "number": 10,
    "id": "ynx-seller-console",
    "name": "YNX Seller Console",
    "slug": "seller-console",
    "owner": "10-seller-console",
    "sourceBranch": "codex/final-seller-console",
    "sourceCommit": "a90d1ee59eec38c15ce42b39420f2625ed758dd0"
  },
  "releaseStatus": {
    "implementedLocal": true,
    "testedLocal": true,
    "installedLocal": false,
    "integratedCentral": false,
    "deployedStaging": false,
    "deployedPublic": false,
    "downloadHosted": false,
    "productionSigned": false,
    "storeReleased": false
  },
  "auth": {
    "owner": "02-wallet-auth",
    "registrySchemaVersion": 2,
    "productClientId": "ynx-seller-v1",
    "requestingProduct": "shop-seller",
    "bundleId": "com.ynxweb4.seller-console",
    "callbacks": ["ynxseller://wallet-auth/callback"],
    "orderedScopes": ["account:read", "shop:seller:operate"],
    "deviceAlgorithms": ["p256-sha256"],
    "sessionStorage": "memory-only-browser-token",
    "requiredNegativeCases": [
      "missing-session",
      "wrong-product",
      "wrong-bundle",
      "wrong-callback",
      "wrong-device",
      "scope-widening",
      "scope-reordering",
      "expired-session",
      "revoked-session",
      "replayed-challenge"
    ],
    "storeAuthorizationRevocation": {
      "owner": "02-wallet-auth",
      "acceptanceState": "pendingAcceptance",
      "method": "POST",
      "path": "/v1/product-authorizations/revocations",
      "resourceType": "seller_store",
      "requestFields": ["requestId", "account", "productClientId", "bundleId", "resourceType", "resourceId", "reason"],
      "receiptFields": ["revoked", "revocationId", "requestId", "account", "productClientId", "bundleId", "resourceType", "resourceId", "sessionCount", "revokedAt"],
      "requiredReceiptBindings": ["requestId", "account", "productClientId", "bundleId", "resourceType", "resourceId"],
      "localRoleRevocationImmediate": true,
      "regrantBlockedUntil": "confirmed",
      "truthfulFailureStates": ["unavailable", "rejected"]
    }
  },
  "rbac": {
    "schemaVersion": 1,
    "owner": "10-seller-console",
    "canonicalRoles": [
      "owner",
      "admin",
      "catalog",
      "inventory",
      "fulfillment",
      "finance",
      "support",
      "viewer"
    ],
    "assignableRoles": [
      "admin",
      "catalog",
      "inventory",
      "fulfillment",
      "finance",
      "support",
      "viewer"
    ],
    "permissions": {
      "owner": ["seller.read", "catalog.write", "inventory.write", "fulfillment.write", "returns.resolve", "refunds.approve", "finance.read", "team.read", "audit.read", "team.write", "store.activate", "store.policy.write"],
      "admin": ["seller.read", "catalog.write", "inventory.write", "fulfillment.write", "returns.resolve", "refunds.approve", "finance.read", "team.read", "audit.read"],
      "catalog": ["seller.read", "catalog.write"],
      "inventory": ["seller.read", "inventory.write"],
      "fulfillment": ["seller.read", "fulfillment.write"],
      "finance": ["seller.read", "finance.read", "refunds.approve"],
      "support": ["seller.read", "returns.resolve"],
      "viewer": ["seller.read", "finance.read", "team.read", "audit.read"]
    },
    "invariants": [
      "Only owner may create, cancel or update Seller team authority.",
      "First-time membership requires one-time acceptance by the invitation's exact canonical Wallet account.",
      "The direct role-update API applies only to an existing member and cannot bypass invitation acceptance.",
      "Owner cannot be assigned through invitations or the role API.",
      "Unknown roles and unknown permissions fail closed.",
      "Catalog cannot change inventory.",
      "Inventory cannot edit or publish catalog content.",
      "Fulfillment cannot approve refunds.",
      "Support cannot approve refunds.",
      "Finance cannot fulfill orders or edit catalog content.",
      "Only owner may revoke a non-owner role.",
      "Local Seller authority is removed before central Wallet invalidation is attempted.",
      "A revoked account cannot be regranted until the store-scoped Wallet invalidation receipt is confirmed.",
      "Mismatched or unavailable Wallet receipts never become confirmed."
    ],
    "teamInvitations": {
      "owner": "10-seller-console",
      "identityOwner": "02-wallet-auth",
      "statuses": ["pending", "accepted", "cancelled", "expired"],
      "minimumExpiryMinutes": 15,
      "maximumExpiryMinutes": 10080,
      "acceptanceBinding": ["invitationId", "storeId", "targetAccount", "role", "expiresAt", "authenticated Wallet account"],
      "acceptanceIsOneTime": true,
      "invitationIdIsAuthenticationCredential": false,
      "wrongAccountResponse": "not found",
      "firstMembershipViaInvitationOnly": true,
      "cancelIsPermanent": true
    },
    "migration": {
      "fromSnapshotVersion": 2,
      "toSnapshotVersion": 6,
      "steps": [
        {"snapshotVersion": 3, "change": "manager roles canonicalize to admin"},
        {"snapshotVersion": 4, "change": "seller role revocation records are initialized"},
        {"snapshotVersion": 5, "change": "append-only Seller integration events are initialized"},
        {"snapshotVersion": 6, "change": "Seller team invitations are initialized"}
      ],
      "legacyRole": "manager",
      "canonicalReplacement": "admin",
      "newRequestsAcceptLegacyRole": false,
      "futureVersionsFailClosed": true,
      "rollbackExport": {
        "operatorCommand": "ynx-shopd --state <path> --export-rollback <new-path> --rollback-version <3|4|5>",
        "supportedTargets": [3, 4, 5],
        "exclusiveDestination": true,
        "activeStateOverwriteAllowed": false,
        "integrityEnvelopePreservedWhenConfigured": true,
        "lossyStateRefused": ["seller invitations for all targets", "seller integration events before v5", "seller role revocations before v4", "v6-only event fields for v5"]
      },
      "rollbackBoundary": "Binaries that do not understand Snapshot v6 invitations, revocations and Seller integration events must not write a v6 state file. Normal startup never normalizes a future snapshot version downward."
    }
  },
  "dataLifecycle": {
    "owner": "10-seller-console",
    "sellerExport": {
      "method": "POST",
      "path": "/api/seller/stores/{id}/exports",
      "authority": "owner",
      "schemaVersion": 1,
      "storeScoped": true,
      "auditAction": "seller_data_exported",
      "includedClasses": ["store_profile", "catalog", "inventory", "orders", "settlement_and_refund_evidence", "seller_roles", "seller_invitations", "seller_revocations", "seller_outbox", "store_scoped_audit"],
      "excludedClasses": ["unrelated_stores", "buyer_profiles", "carts", "ai_jobs", "idempotency_records", "rate_limit_windows", "provider_credentials"]
    },
    "transientRetention": {
      "previewByDefault": true,
      "explicitConfirmationRequired": true,
      "integrityKeyRequired": true,
      "minimumRetentionDays": 30,
      "prunableClasses": ["terminal_ai_jobs", "expired_rate_limit_samples"],
      "protectedClasses": ["stores", "products", "orders", "settlement_and_refund_evidence", "seller_roles", "seller_invitations", "seller_revocations", "seller_outbox", "audits", "idempotency_records", "buyer_profiles", "carts"],
      "operatorCommand": "ynx-shopd --state <path> --prune-transient-before <RFC3339> [--confirm-prune-transient]"
    }
  },
  "apis": [
    {"method": "GET", "path": "/api/seller/stores", "authority": "valid seller role"},
    {"method": "POST", "path": "/api/seller/stores", "authority": "authenticated seller account"},
    {"method": "PUT", "path": "/api/seller/stores/{id}", "authority": "owner"},
    {"method": "POST", "path": "/api/seller/stores/{id}/activate", "authority": "owner"},
    {"method": "POST", "path": "/api/seller/stores/{id}/exports", "authority": "owner", "effect": "audited store-scoped portability export"},
    {"method": "GET", "path": "/api/seller/stores/{id}/roles", "authority": "team.read", "returns": ["roles", "revocations", "invitations", "events", "actorRole"]},
    {"method": "PUT", "path": "/api/seller/stores/{id}/roles", "authority": "owner", "constraint": "existing member only"},
    {"method": "POST", "path": "/api/seller/stores/{id}/roles/{account}/revoke", "authority": "owner", "localEffect": "immediate", "centralEffect": "confirmed, unavailable or rejected"},
    {"method": "GET", "path": "/api/seller/invitations", "authority": "authenticated canonical Seller Wallet account", "visibility": "target account only"},
    {"method": "POST", "path": "/api/seller/stores/{id}/invitations", "authority": "owner", "effect": "pending invitation only"},
    {"method": "POST", "path": "/api/seller/invitations/{invitation}/accept", "authority": "exact target canonical Wallet account", "effect": "one-time role assignment"},
    {"method": "POST", "path": "/api/seller/stores/{id}/invitations/{invitation}/cancel", "authority": "owner", "effect": "permanent cancellation"},
    {"method": "GET", "path": "/api/seller/products", "authority": "seller.read"},
    {"method": "POST", "path": "/api/seller/products", "authority": "catalog.write"},
    {"method": "PUT", "path": "/api/seller/products/{id}", "authority": "catalog.write"},
    {"method": "POST", "path": "/api/seller/products/{id}/publish", "authority": "catalog.write"},
    {"method": "POST", "path": "/api/seller/products/{id}/unpublish", "authority": "catalog.write"},
    {"method": "POST", "path": "/api/seller/inventory", "authority": "inventory.write"},
    {"method": "GET", "path": "/api/seller/settlements", "authority": "finance.read"},
    {"method": "GET", "path": "/api/seller/audit", "authority": "audit.read"},
    {"method": "POST", "path": "/api/orders/{id}/transition", "authority": "action-specific seller permission"}
  ],
  "authoritativeBoundaries": {
    "payment": {
      "owner": "04-pay",
      "paidRequires": ["invoiceId", "intentId", "merchant", "payoutAddress", "payer", "asset", "amount", "transactionHash", "blockHeight", "confirmedAt", "auditHash"],
      "uiOrWebhookAloneIsAuthoritative": false
    },
    "refund": {
      "owner": "04-pay",
      "refundedRequires": ["refundId", "intentId", "merchant", "asset", "amount", "transactionHash", "blockHeight", "recordedAt", "requestHash", "auditHash"],
      "sellerApprovalAloneIsAuthoritative": false
    },
    "dispute": {
      "owner": "15-trust-center",
      "sellerConsoleAuthority": "request and display evidence only"
    },
    "billingLedger": {
      "owner": "26-data-fabric",
      "sellerConsoleAuthority": "consumer and presentation layer"
    }
  },
  "localIntegrationOutbox": {
    "owner": "10-seller-console",
    "snapshotVersion": 6,
    "appendOnly": true,
    "deliveryState": "persistedLocalPendingDataFabricAcceptance",
    "events": [
      {
        "name": "ynx.seller.role.updated.v1",
        "fields": ["id", "source", "storeId", "account", "actor", "previousRole", "role", "status", "schemaVersion", "occurredAt"]
      },
      {
        "name": "ynx.seller.role.revoked.v1",
        "fields": ["id", "source", "storeId", "account", "actor", "revocationId", "previousRole", "sessionStatus", "schemaVersion", "occurredAt"]
      },
      {
        "name": "ynx.seller.authorization.revocation.updated.v1",
        "fields": ["id", "source", "storeId", "account", "actor", "revocationId", "previousRole", "sessionStatus", "sessionRevocationId", "sessionCount", "schemaVersion", "occurredAt"]
      },
      {
        "name": "ynx.seller.team.invitation.created.v1",
        "fields": ["id", "source", "storeId", "account", "actor", "invitationId", "role", "status", "expiresAt", "schemaVersion", "occurredAt"]
      },
      {
        "name": "ynx.seller.team.invitation.accepted.v1",
        "fields": ["id", "source", "storeId", "account", "actor", "invitationId", "role", "status", "expiresAt", "schemaVersion", "occurredAt"]
      },
      {
        "name": "ynx.seller.team.invitation.cancelled.v1",
        "fields": ["id", "source", "storeId", "account", "actor", "invitationId", "role", "status", "expiresAt", "schemaVersion", "occurredAt"]
      },
      {
        "name": "ynx.seller.team.invitation.expired.v1",
        "fields": ["id", "source", "storeId", "account", "actor", "invitationId", "role", "status", "expiresAt", "schemaVersion", "occurredAt"]
      }
    ],
    "centralCanonicalOwner": "26-data-fabric",
    "centralAcceptance": false
  },
  "canonicalEventOwner": "26-data-fabric",
  "canonicalEventStatus": "pendingAcceptance",
  "canonicalEvents": [
    "seller.store.created",
    "seller.store.activated",
    "seller.role.assigned",
    "seller.role.updated",
    "seller.role.revoked",
    "seller.team.invitation.created",
    "seller.team.invitation.accepted",
    "seller.team.invitation.cancelled",
    "seller.team.invitation.expired",
    "seller.catalog.created",
    "seller.catalog.updated",
    "seller.catalog.published",
    "seller.catalog.unpublished",
    "seller.inventory.updated",
    "seller.order.shipped",
    "seller.return.resolved",
    "seller.refund.approved",
    "seller.settlement.observed"
  ],
  "errorCodes": [
    {"code": "SELLER_UNAUTHORIZED", "http": 403},
    {"code": "SELLER_SESSION_UNAVAILABLE", "http": 503},
    {"code": "SELLER_NOT_FOUND", "http": 404},
    {"code": "SELLER_CONFLICT", "http": 409},
    {"code": "SELLER_INVALID_STATE", "http": 409},
    {"code": "SELLER_INVENTORY_CONFLICT", "http": 409},
    {"code": "SELLER_PROVIDER_UNAVAILABLE", "http": 503}
  ],
  "healthAndVersion": {
    "paths": ["/health", "/version", "/api/capabilities"],
    "mustExpose": ["service", "version", "commit", "chainId", "dependencyStatus"],
    "mustNotExpose": ["secret", "privateKey", "providerCredential", "localAbsolutePath"]
  },
  "dependencies": [
    {"owner": "02-wallet-auth", "contract": "Seller product registration, session introspection and store-scoped authorization revocation receipt", "status": "pendingAcceptance"},
    {"owner": "04-pay", "contract": "Authoritative settlement and refund evidence", "status": "pendingAcceptance"},
    {"owner": "15-trust-center", "contract": "Dispute and appeal evidence", "status": "pendingAcceptance"},
    {"owner": "26-data-fabric", "contract": "Canonical commerce events and billing ledger", "status": "pendingAcceptance"},
    {"owner": "13-monitor", "contract": "Seller service health, SLO and incident signals", "status": "pendingAcceptance"},
    {"owner": "28-website", "contract": "Canonical seller-console public route and metadata", "status": "pendingAcceptance"},
    {"owner": "29-integration", "contract": "Shared Testnet protocol freeze and cross-product proof", "status": "pendingAcceptance"},
    {"owner": "30-security", "contract": "Release, artifact, backup and security gates", "status": "pendingAcceptance"}
  ],
  "externalInputs": [
    "Central Wallet registry deployment authority",
    "Authoritative Pay merchant and payout configuration",
    "Trust endpoint deployment authority",
    "Provider credentials or agreements for tax and carrier integrations",
    "Current-source staging deployment and artifact hosting authority"
  ],
  "testCommands": [
    "go test ./internal/commerce/...",
    "go test -race ./internal/commerce",
    "go vet ./internal/commerce/...",
    "npm test (apps/seller-console)",
    "npm run build (apps/seller-console)",
    "npm run smoke (apps/seller-console)"
  ]
}
