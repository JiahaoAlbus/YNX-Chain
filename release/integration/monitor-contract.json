    "sourcePathConfig": "YNX_MONITOR_PUBLIC_STATUS_PATH",
    "expectedSourceConfig": "YNX_MONITOR_PUBLIC_STATUS_EXPECTED_SOURCE",
    "integrityKeyConfig": "YNX_MONITOR_PUBLIC_STATUS_INTEGRITY_KEY",
