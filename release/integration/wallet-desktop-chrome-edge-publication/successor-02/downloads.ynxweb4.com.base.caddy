	header @walletWindowsArm64 Content-Disposition "attachment; filename=\"ynx-wallet-desktop-0.1.1-arm64.exe\""

	@otherDiskImages {
		path *.dmg
		not path /wallet/sha256-69b4fa5db7b8a9ab105af6633de44f5a5a4a9fceeaa0925a306f77b22381b044/ynx-wallet-macos-0.1.2-universal.dmg
