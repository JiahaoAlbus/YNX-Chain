  "gatewayOperations": [
    {
      "operation": "completeProductSession",
      "path": "/v1/wallet/sessions/complete",
      "requiredScope": null,
      "binding": "authorizationRequest+walletApproval+P-256 device challenge; proof header null"
    },
    {
      "operation": "introspectProductSession",
      "path": "/v1/wallet/sessions/introspect",
      "requiredScope": "caller-selected subset of granted ordered scopes",
      "binding": "separate P-256 header proof over method+path+canonical bodyDigest+nonce"
    },
    {
      "operation": "revokeProductSession",
      "path": "/v1/wallet/sessions/revoke",
      "requiredScope": null,
      "binding": "separate path-bound P-256 header proof from the session being revoked"
    },
    {
      "operation": "revokeOwnApproval",
      "path": "/v1/wallet/approvals/revoke",
      "requiredScope": null,
      "binding": "separate path-bound P-256 proof from a session created by the approval"
    },
    {
      "operation": "revokeOwnProductDevice",
      "path": "/v1/wallet/devices/revoke",
      "requiredScope": null,
      "binding": "separate path-bound P-256 proof from the product device being revoked"
    },
    {
      "operation": "logoutAllAccountDevices",
      "path": "/v1/wallet/accounts/logout-all",
      "requiredScope": "wallet:sessions",
      "binding": "canonical ynx-wallet-v1 and com.ynxweb4.wallet Product Session only"
    },
    {
      "operation": "activateStrategyMandate",
      "path": "/v1/wallet/mandates/activate",
      "requiredScope": "quant:mandate:create",
      "binding": "account+productClientId+sessionBinding+P-256 request proof"
    },
    {
      "operation": "authorizeStrategyAction",
      "path": "/v1/wallet/mandates/authorize-action",
      "requiredScope": "quant:mandate:execute",
      "binding": "mandateDigest+nonceDomain+nonce+limits+typed target+P-256 request proof"
    },
    {
      "operation": "listStrategyMandates",
      "path": "/v1/wallet/mandates",
      "requiredScope": "quant:account",
      "binding": "account+productClientId+P-256 request proof"
    },
    {
      "operation": "revokeStrategyMandate",
      "path": "/v1/wallet/mandates/revoke",
      "requiredScope": "quant:mandate:revoke",
      "binding": "account+productClientId+sessionBinding+P-256 request proof"
    },
    {
      "operation": "killStrategyMandate",
      "path": "/v1/wallet/mandates/kill",
      "requiredScope": "quant:mandate:revoke",
      "binding": "account+productClientId+sessionBinding+P-256 request proof"
    },
    {
      "operation": "emergencyExitStrategyMandate",
      "path": "/v1/wallet/mandates/emergency-exit",
      "requiredScope": "quant:mandate:revoke",
      "binding": "existing mandate ownership+bounded exit reason+P-256 request proof"
    }
  ],
  "strategyAssetBoundary": {
    "exchange": {
      "required": ["subaccount-only", "no-withdraw", "independent-nonce-domain", "immediate-revoke"],
