  "testVectors": "docs/integration/CROSS_PRODUCT_TEST_VECTORS.json",
  "migration": "apps/search/MIGRATION_COMPATIBILITY.md",
  "health": "/api/health",
  "metrics": "/api/metrics",
  "version": "/api/health build",
  "externalInputs": [
    "approved production source inventory",
    "external search provider credential and agreement",
    "AI Gateway client reference",
    "Trust case acceptance",
    "public deployment authority and domain route"
  ]
}
