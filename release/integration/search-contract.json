      "status": "pending"
    },
    {
      "owner": "22-browser",
      "required": "reviewed Search route and failure-state acceptance",
      "status": "pending"
    },
    {
      "owner": "26-data-fabric",
      "required": "canonical Search events and public data-class labels",
      "status": "pending"
    },
    {
      "owner": "28-website",
      "required": "public /search route, feeds, metadata, and support/privacy/security/status paths",
      "status": "pending"
    },
    {
      "owner": "29-integration",
      "required": "contract freeze and shared Testnet acceptance",
      "status": "pending"
    }
  ],
  "testVectors": "docs/integration/CROSS_PRODUCT_TEST_VECTORS.json",
  "migration": "apps/search/MIGRATION_COMPATIBILITY.md",
  "health": "/api/health",
