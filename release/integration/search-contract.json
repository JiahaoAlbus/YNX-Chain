{
  "schemaVersion": "1.4.0",
  "contractId": "ynx.search.integration.v1",
  "product": {
    "number": 23,
    "name": "YNX Search",
    "slug": "search",
    "owner": "23-search"
  },
  "sourceCommit": "afb1b017c32dd95e593ba6269a6a67d47d9a40d3",
  "releaseStatus": {
    "implementedLocal": true,
    "testedLocal": true,
    "installedLocal": false,
    "integratedCentral": true,
    "deployedStaging": false,
    "deployedPublic": false,
    "downloadHosted": false,
    "productionSigned": false,
    "storeReleased": false
  },
  "authority": {
    "searchOwns": [
      "source-registry schema",
      "index receipts",
      "search result schema",
      "ranking explanation schema",
      "public search feeds",
      "search correction and removal case adapter",
      "request, trace and error correlation schema",
      "Search runtime metrics and bounded log schema"
    ],
    "externalOwners": {
      "walletAuth": "02-wallet-auth",
      "aiGateway": "14-ai",
      "trustCases": "15-trust-center",
      "monitor": "13-monitor",
      "publicDocsAndBrand": "18-docs-compliance",
      "browserClient": "22-browser",
      "canonicalEvents": "26-data-fabric",
      "websiteAndSeo": "28-website",
      "protocolFreeze": "29-integration",
      "releaseSecurity": "30-security-sre-release"
    }
  },
  "network": {
    "testnetName": "YNX Testnet",
    "evmChainId": 6423,
    "cosmosChainId": "ynx_6423-1",
    "nativeAsset": "YNXT"
  },
  "apis": [
    {
      "method": "GET",
      "path": "/api/health",
      "auth": "public",
      "purpose": "truthful build, dependency and observability status"
    },
    {
      "method": "GET",
      "path": "/api/metrics",
      "auth": "operator-configured Monitor bearer; 503 when unconfigured",
      "purpose": "bounded Prometheus request, latency, error and uptime metrics"
    },
    {
      "method": "GET",
      "path": "/api/search",
      "auth": "public rate-limited",
      "purpose": "bounded YNX index retrieval"
    },
    {
      "method": "GET",
      "path": "/api/index/status",
      "auth": "public",
      "purpose": "redacted source coverage and indexing status"
    },
    {
      "method": "POST",
      "path": "/api/sources",
      "auth": "operator bearer reference",
      "purpose": "register reviewed source governance record"
    },
    {
      "method": "POST",
      "path": "/api/sources/{sourceId}/index",
      "auth": "operator bearer reference",
      "purpose": "crawl one registered source through fail-closed outbound policy"
    },
    {
      "method": "POST",
      "path": "/api/removal|correction|appeal",
      "auth": "same-origin public request, rate-limited",
      "purpose": "create auditable remedy case"
    },
    {
      "method": "POST",
      "path": "/api/ai/prepare|answer|stream|review",
      "auth": "same-origin plus explicit user consent",
      "purpose": "citation-bound AI over AI-eligible retrieved sources"
    },
    {
      "method": "POST",
      "path": "/api/wallet/prepare|callback",
      "auth": "same-origin and device-bound challenge",
      "purpose": "prepare or accept callback binding; central Gateway remains authoritative"
    }
  ],
  "schemas": {
    "sourceRegistry": {
      "version": 4,
      "dataPolicyVersion": "1.0.0",
      "required": [
        "id",
        "url",
        "origin",
        "label",
        "sourceType",
        "owner",
        "jurisdiction",
        "authorization.referenceDigest",
        "authorization.reviewedAt",
        "robots.policy",
        "permittedScope",
        "terms.url",
        "terms.permittedUse",
        "dataRights.storage",
        "dataRights.snippets",
        "dataRights.aiRetrieval",
        "dataPolicy.version",
        "dataPolicy.allowedClasses",
        "dataPolicy.defaultClass",
        "retentionDays",
        "remedies.removalUrl",
        "remedies.correctionUrl",
        "languages",
        "crawlPolicy.freshnessSloSeconds",
        "crawlPolicy.maxRequestsPerMinute",
        "crawlPolicy.backoffSeconds"
      ],
      "migration": "pre-v4 entries lacking explicit reviewed public data classes are disabled and marked source-registry-v4 until reviewed"
    },
    "searchResult": {
      "version": 4,
      "required": [
        "resultType",
        "title",
        "sourceUrl",
        "sourceLabel",
        "sourceScope",
        "sourceUse",
        "dataClass",
        "language",
        "freshness.publishedAt",
        "freshness.fetchedAt",
        "freshness.indexedAt",
        "indexReceiptDigest",
        "contentType",
        "score",
        "ranking.version",
        "ranking.queryIntent",
        "ranking.factors",
        "ranking.whyThisResult",
        "ranking.authorityBasis",
        "ranking.sourceQualityBasis",
        "ranking.vectorStatus",
        "remedies.removalUrl",
        "remedies.correctionUrl",
        "remedies.appealEndpoint",
        "snippet"
      ],
      "entityRegistryVersion": "1.0.0",
      "vectorStatus": "candidate-disabled",
      "correctionPolicy": "exact aliases only; YNX is never corrected to Lynx"
    },
    "publicFeeds": {
      "version": "1.0.0",
      "directory": "release/public/search",
      "files": [
        "public-search-index.json",
        "public-products.json",
        "public-documents.json",
        "public-releases.json",
        "public-faq.json",
        "public-entities.json"
      ],
      "manifest": "public-feed-manifest.json",
      "hash": "sha256",
      "publicStatus": "local artifact only; not hosted"
    },
    "indexReceipt": {
      "version": 1,
      "digestDomain": "YNX_INDEX_RECEIPT_V1",
      "authorizationReference": "digest only in public responses"
    },
    "remedyCase": {
      "version": 1,
      "kinds": ["removal", "correction", "appeal"],
      "states": ["submitted", "under-review", "accepted", "rejected", "corrected", "removed"]
    },
    "recovery": {
      "version": "1.0.0",
      "databaseVersion": 4,
      "dataPolicyVersion": "1.0.0",
      "sourceUsePolicyVersion": "1.0.0",
      "integrity": ["SHA-256 exact bytes", "manifest digest", "public index projection digest", "index receipt binding"],
      "restore": "new separate path only; existing, in-place and in-bundle destinations rejected",
      "reindex": "deterministic public projection; private cases, AI audit and Wallet challenges excluded",
      "encryption": "not implemented",
      "offsiteDurability": "not verified",
      "operationalRpo": "not verified",
      "centralAcceptance": "pending"
    },
    "observability": {
      "version": "1.0.0",
      "responseHeaders": ["x-request-id", "x-trace-id", "x-error-id on errors"],
      "structuredEvents": ["request-completed", "request-error"],
      "excludedFields": ["query strings", "request bodies", "client IP addresses", "error messages", "source snippets", "Wallet data", "authorization evidence"],
      "metrics": ["ynx_search_requests_total", "ynx_search_request_duration_milliseconds_sum", "ynx_search_request_duration_milliseconds_max", "ynx_search_server_errors_total", "ynx_search_process_uptime_seconds"],
      "metricsAuth": "operator-configured bearer; fail closed with 503 when absent",
      "centralMonitorAcceptance": "pending",
      "stagingEvidence": "pending current-source deployment"
    }
  },
  "auth": {
    "productClientId": "ynx-search-web",
    "bundleId": "com.ynxweb4.search.web",
    "requestedScopes": ["account:read", "search:cases"],
    "callbacks": ["https://web4.ynxweb4.com/search/auth/callback"],
    "callbackClass": "reviewed exact HTTPS callback",
    "sessionState": "central registration accepted; positive public callback pending deployment",
    "failClosedTests": [
      "wrong product",
      "wrong bundle",
      "wrong callback",
      "wrong device",
      "scope widening",
      "expiry",
      "replay"
    ]
  },
  "canonicalEvents": [
    "ynx.search.source.registered.v1",
    "ynx.search.source.crawl_started.v1",
    "ynx.search.source.crawl_failed.v1",
    "ynx.search.document.indexed.v1",
    "ynx.search.case.submitted.v1",
    "ynx.search.case.resolved.v1",
    "ynx.search.ai.reviewed.v1"
  ],
  "errorCodes": [
    "SEARCH_INVALID_QUERY",
    "SEARCH_SOURCE_GOVERNANCE_REQUIRED",
    "SEARCH_DATA_CLASS_FORBIDDEN",
    "SEARCH_SENSITIVE_CONTENT_REJECTED",
    "SEARCH_SOURCE_DISABLED",
    "SEARCH_ROBOTS_BLOCKED",
    "SEARCH_OUTBOUND_DESTINATION_REJECTED",
    "SEARCH_SOURCE_BACKOFF_ACTIVE",
    "SEARCH_PROVIDER_UNAVAILABLE",
    "SEARCH_AI_CONSENT_REQUIRED",
    "SEARCH_AI_UNINDEXED_CITATION",
    "SEARCH_WALLET_GATEWAY_REQUIRED",
    "SEARCH_REPLAY_REJECTED"
  ],
  "failureSemantics": {
    "emptyCorpus": "successful empty result with registered-authorized-sources-only coverage claim",
    "staleSource": "result retains timestamp and stale state; it is never silently freshened",
    "providerUnavailable": "unavailable, never synthetic success",
    "legacyRegistry": "disabled pending renewed Source Registry v4 public data-class review",
    "dataClassPolicy": "private, internal, unknown, out-of-source-policy, and high-confidence sensitive content fail closed before persistence",
    "outboundPolicy": "fail closed before content fetch and persist failed/backoff status",
    "centralGatewayMissing": "no Product Session or Trust completion is claimed"
  },
  "dependencies": [
