{
  "schemaVersion": 1,
  "product": {
    "number": "04",
    "id": "pay",
    "name": "YNX Pay",
    "owner": "04-pay",
    "branch": "codex/final-pay",
    "sourceCommit": "6477a42b0b96761a74b676c4f18f2e987b628a3d"
  },
  "network": {
    "cosmosChainId": "ynx_6423-1",
    "evmChainId": 6423,
    "nativeAsset": "YNXT"
  },
  "authority": {
    "walletAuthOwner": "02-wallet-auth",
    "chainSettlementOwner": "01-chain-core",
    "oracleOwner": "19-oracle-market-data",
    "bridgeOwner": "21-bridge-interoperability",
    "billingLedgerOwner": "26-data-fabric-billing-ledger",
    "integrationFreezeOwner": "29-integration",
    "releaseSecurityOwner": "30-security-sre-release"
  },
  "walletBinding": {
    "productClientId": "ynx-pay-v1",
    "bundleId": "com.ynxweb4.pay",
    "callback": "ynxpay://wallet-auth/callback",
    "scopes": [
      "account:read",
      "pay:case:create",
      "pay:route:select",
      "pay:settlement:submit",
      "pay:sponsorship:request"
    ],
    "deviceAlgorithm": "p256-sha256",
    "sessionAssertionDomain": "YNX_PRODUCT_GATEWAY_ASSERTION_V1",
    "failClosed": true
  },
  "api": {
    "publicRead": [
      {"method": "GET", "path": "/health"},
      {"method": "GET", "path": "/v1/settlement-assets"},
      {"method": "GET", "path": "/v1/invoices/{id}"},
      {"method": "GET", "path": "/v1/split-payments/{id}"}
    ],
    "walletGateway": [
      {"method": "POST", "path": "/v1/invoices/{id}/settlements", "scope": "pay:settlement:submit"},
      {"method": "POST", "path": "/v1/invoices/{id}/refund-requests", "scope": "pay:case:create"},
      {"method": "POST", "path": "/v1/invoices/{id}/disputes", "scope": "pay:case:create"},
      {"method": "POST", "path": "/v1/invoices/{id}/sponsorship-quotes", "scope": "pay:sponsorship:request"},
      {"method": "POST", "path": "/v1/invoices/{id}/route-quotes", "scope": "pay:route:select"},
      {"method": "POST", "path": "/v1/route-quotes/{id}/select", "scope": "pay:route:select"},
      {"method": "POST", "path": "/v1/split-payments/{id}/shares/{shareId}/claim", "scope": "pay:settlement:submit"}
    ],
    "merchant": [
      {"method": "POST", "path": "/v1/merchant/invoices", "permission": "invoice"},
      {"method": "POST", "path": "/v1/merchant/split-payments", "permission": "invoice"},
      {"method": "POST", "path": "/v1/merchant/recurring-drafts", "roles": ["owner", "finance"]},
      {"method": "GET", "path": "/v1/merchant/state", "permission": "read"}
    ]
  },
  "schemas": {
    "invoice": {
      "currentVersion": 4,
      "compatibility": [1, 2, 3, 4],
      "v4Adds": ["splitPaymentId", "splitShareId", "expectedPayerHash"],
      "signature": "merchant-ed25519",
      "paidAuthority": "authoritative-central-pay-api"
    },
    "splitPayment": {
      "version": 1,
      "minimumShares": 2,
      "maximumShares": 20,
      "states": ["open", "partially_claimed", "partially_paid", "committed", "expired"],
      "claimAuthority": "wallet-product-session",
      "childInvoicePerShare": true,
      "wrongPayerRejected": true,
      "publicPayerRedaction": true
    },
    "recurringDraft": {
      "version": 1,
      "automaticChargeEnabled": false,
      "walletApprovalEveryOccurrence": true
    }
  },
  "canonicalEvents": [
    "invoice.create",
    "invoice.committed",
    "invoice.expired",
    "split.create",
    "split.share.claim",
    "refund.requested",
    "dispute.created",
    "webhook.dead_letter",
    "webhook.manual_replay"
  ],
  "errorSemantics": {
    "unknownField": "reject",
    "replay": "reject",
    "scopeWidening": "reject",
    "wrongProduct": "reject",
    "wrongDevice": "reject",
    "expiredSession": "reject",
    "wrongSplitPayer": "reject",
    "unsupportedSettlementAsset": "unavailable",
    "providerFailure": "explicit failure; never paid"
  },
  "migration": {
    "snapshotVersion": 1,
    "missingSplitPaymentsField": "normalize to empty map",
    "invoiceV1V2V3Verification": "preserved",
    "invoiceV4Writer": "local implementation"
  },
  "tests": [
    "go test ./internal/payproduct/... -count=1",
    "go test -race ./internal/payproduct/... -count=1",
    "npm run check (apps/pay; 10 tests plus Android/iOS bundle)",
    "TestSplitPaymentCreatesSignedSharesAndBindsClaimedPayer",
    "TestSplitPaymentValidationFailsClosed"
  ],
  "releaseStatus": {
    "implementedLocal": true,
    "testedLocal": true,
    "installedLocal": false,
    "integratedCentral": false,
    "deployedStaging": false,
    "deployedPublic": false,
    "downloadHosted": false,
    "productionSigned": false,
    "storeReleased": false
  },
  "externalInputs": [
    "accepted central Wallet/Gateway registry and deployed product routes",
    "public Testnet deployment authority",
    "configured paymaster or stablecoin/bridge provider where applicable",
    "mobile production signing and store accounts"
  ]
}
