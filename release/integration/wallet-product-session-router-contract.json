    "pendingChallengesAndCachedSuccessesPurged": true,
    "shopAndroidRetired": true,
    "shopWebPwaActive": true,
    "replacementBoundToRegisteredWebOrigin": true,
    "sharedSdkExposesActionableRetirementStatus": true,
    "automaticReplacementRedirectAllowed": false,
    "currentPublicRuntimeUsesRegistryV3": false
  },
