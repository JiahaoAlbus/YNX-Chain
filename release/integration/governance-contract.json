      "Oracle price facts",
      "Bridge asset custody",
      "Data Fabric canonical billing",
      "Security/SRE signer custody",
      "Website public status"
    ]
  },
  "api": {
    "schema": "ynx-governance-api/v1",
    "health": "/health",
    "version": "/version",
    "metrics": "/metrics",
    "publicReads": [
      "/proposals",
      "/votes",
      "/delegations",
      "/roles",
      "/parameters",
      "/timelocks",
      "/executions",
      "/upgrades",
      "/canaries",
      "/emergency-actions",
      "/conflicts",
      "/appeals",
      "/audit"
    ],
    "protectedMutationPrefix": "/governance"
  },
  "auth": {
    "authority": "02-wallet-auth",
    "product": "governance",
    "walletTuple": [
      "account",
      "deviceId",
      "sessionId",
      "product",
      "issuedAt",
      "expiresAt",
      "status"
    ],
    "wildcardScopesAllowed": false,
    "plaintextBearerForwardingAllowed": false,
    "requiredFailures": [
      "wrong_product",
      "wrong_origin",
      "wrong_device",
      "unknown_session",
      "expired_session",
      "revoked_session",
      "scope_widening"
    ]
  },
  "signedIntent": {
    "domain": "ynx-governance-action/v1",
    "chainId": 6423,
    "canonicalEncoding": "RFC8785-compatible canonical JSON",
    "signature": "secp256k1",
    "noncePolicy": "exact next account nonce with changed-input conflict rejection"
  },
  "canonicalEvents": [
    "governance.proposal.created.v1",
    "governance.vote.recorded.v1",
    "governance.timelock.started.v1",
    "governance.canary.completed.v1",
    "governance.execution.verified.v1",
    "governance.rollback.verified.v1",
    "governance.emergency.closed.v1"
  ],
  "errorCodes": [
    "governance_auth_invalid",
    "governance_scope_denied",
    "governance_replay",
    "governance_conflict",
    "governance_parameter_out_of_bounds",
    "governance_timelock_not_ready",
    "governance_canary_failed",
    "governance_receipt_mismatch",
    "governance_dependency_unavailable"
  ],
  "migration": {
