{
  "schemaVersion": "ynx.card.integration.v1",
  "product": {
    "number": "06",
    "id": "ynx-card",
    "name": "YNX Card",
    "owner": "06-card",
    "sourceCommit": "d79872f5df4da0566e11ef40e5314ea68d9846f4",
    "branch": "codex/final-card"
  },
  "network": {
    "cosmosChainId": "ynx_6423-1",
    "evmChainId": 6423,
    "environmentLabel": "YNX Testnet Sandbox"
  },
  "walletBinding": {
    "productId": "ynx-card",
    "clientId": "ynx-card-v1",
    "bundleId": "com.ynxweb4.card",
    "callback": "ynxcard://wallet-auth/callback",
    "orderedScopes": [
      "account:read",
      "card:application:write",
      "card:controls:write",
      "card:dispute:write"
    ],
    "routeScopes": {
      "default": [
        "account:read",
        "card:application:write",
        "card:controls:write",
        "card:dispute:write"
      ],
      "DELETE /v1/account/data": [
        "account:read",
        "card:application:write",
        "card:controls:write",
        "card:data:delete",
        "card:dispute:write"
      ]
    },
    "assertionDomain": "YNX_PRODUCT_GATEWAY_ASSERTION_V1",
    "requiredBindings": [
      "chainId",
      "productId",
      "clientId",
      "bundleId",
      "callback",
      "account",
      "sessionId",
      "deviceId",
      "orderedScopes",
      "requestDigest",
      "method",
      "path",
      "bodyHash",
      "nonce",
      "issuedAt",
      "expiresAt"
    ],
    "failureMode": "fail_closed"
  },
  "api": {
    "service": "ynx-card-productd",
    "stateVersion": 1,
    "maxBodyBytes": 1048576,
    "routes": [
      {"method": "GET", "path": "/health", "auth": "public", "purpose": "liveness and dependency truth"},
      {"method": "GET", "path": "/ready", "auth": "public", "purpose": "issuer-dependent readiness"},
      {"method": "GET", "path": "/version", "auth": "public", "purpose": "build and schema identity"},
      {"method": "GET", "path": "/v1/account/state", "auth": "gateway_assertion"},
      {"method": "GET", "path": "/v1/account/export", "auth": "gateway_assertion", "schema": "ynx.card.account-export.v1"},
      {"method": "POST", "path": "/v1/account/retention", "auth": "gateway_assertion", "schema": "ynx.card.data-lifecycle.v1"},
      {"method": "DELETE", "path": "/v1/account/data", "auth": "gateway_assertion", "scope": "card:data:delete", "schema": "ynx.card.data-lifecycle.v1"},
      {"method": "POST", "path": "/v1/card/applications", "auth": "gateway_assertion"},
      {"method": "POST", "path": "/v1/cards/{id}/actions", "auth": "gateway_assertion"},
      {"method": "PUT", "path": "/v1/cards/{id}/controls", "auth": "gateway_assertion"},
      {"method": "POST", "path": "/v1/cards/{id}/disputes", "auth": "gateway_assertion"},
      {"method": "POST", "path": "/v1/ai/runs", "auth": "gateway_assertion"},
      {"method": "POST", "path": "/v1/ai/runs/{id}/review", "auth": "gateway_assertion"},
      {"method": "POST", "path": "/v1/provider/events", "auth": "provider_event_signature"}
    ]
  },
  "issuerProvider": {
    "interfaceVersion": 1,
    "capabilitySchema": "ynx.card.provider.capabilities.v1",
    "methods": [
      "Health",
      "CheckEligibility",
      "SubmitApplication",
      "IssueSandbox",
      "UpdateStatus",
      "Replace",
      "UpdateControls"
    ],
    "defaultMode": "unavailable",
    "testMode": "sandbox",
    "productionProvider": null,
    "productionStatus": "not_selected",
    "providerEventDomain": "YNX_CARD_PROVIDER_EVENT_V1",
    "providerEventTypes": ["authorization", "reversal", "clearing", "decline", "refund"],
    "providerEventVerification": {
      "keyIdHeader": "X-YNX-Provider-Key-ID",
      "legacyDefaultKeyId": "default",
      "maximumOverlappingVerificationKeys": 4,
      "timestampPastWindowSeconds": 300,
      "timestampFutureSkewSeconds": 30,
      "unknownOrRetiredKey": "reject_unauthorized",
      "tamperedBody": "reject_unauthorized"
    },
    "providerEventRelationships": {
      "clearing": "authorization",
      "reversal": "authorization",
      "refund": "clearing",
      "sameProviderCardRequired": true,
      "outOfOrderBehavior": "conflict_without_consuming_event_id_then_retry"
    }
  },
  "canonicalStates": {
    "application": ["provider_unavailable", "pending_review", "rejected", "issued_sandbox"],
    "card": ["issued_sandbox", "active", "frozen", "replaced", "closed"],
    "dispute": ["open", "resolved"],
    "aiRun": ["review", "reviewed", "rejected"]
  },
  "canonicalEvents": [
    "card.application.created",
    "card.issued_sandbox",
    "card.activated",
    "card.frozen",
    "card.unfrozen",
    "card.replaced",
    "card.closed",
    "card.controls.updated",
    "card.authorization.received",
    "card.clearing.received",
    "card.reversal.received",
    "card.decline.received",
    "card.refund.received",
    "card.dispute.opened",
    "card.ai_draft.reviewed"
  ],
  "errorCodes": {
    "CARD_INVALID": 400,
    "CARD_UNAUTHORIZED": 401,
    "CARD_NOT_FOUND": 404,
    "CARD_CONFLICT": 409,
    "CARD_PROVIDER_UNAVAILABLE": 503,
    "CARD_INTERNAL": 500
  },
  "sensitiveDataBoundary": {
    "persisted": ["opaqueProviderCardId", "providerName", "sandboxNetwork", "last4", "expiry", "status", "controls", "events", "disputes", "audit", "pseudonymizedDeletionReceipt"],
    "forbidden": ["PAN", "CVV", "CVC", "PIN", "trackData", "magneticStripeData", "rawKYC", "identityDocument", "issuerSecret", "walletPrivateKey", "mobileSigningKey"],
    "secureDisplay": "provider-hosted only; not implemented until an official provider is selected"
  },
  "dataLifecycle": {
    "schema": "ynx.card.data-lifecycle.v1",
    "exportSchema": "ynx.card.account-export.v1",
    "exportRedactions": ["eligibilityReference", "providerApplicationReference", "providerCardId", "providerEventId", "relatedProviderEventId", "requestId", "traceId"],
    "defaultRetention": {
      "notifications": "2160h0m0s",
      "aiRuns": "720h0m0s",
      "idempotency": "720h0m0s",
      "providerReplayRecords": "9600h0m0s",
      "deletionReceipts": "720h0m0s"
    },
    "deletionConfirmation": "DELETE YNX CARD DATA",
    "deletionScope": "card:data:delete",
    "providerClosureBeforeDeletion": "required_fail_closed",
    "auditBehavior": "pseudonymize account/object/correlation fields, rebuild hash chain, append account_data_deleted receipt audit",
    "durableFinancialEventRetention": "not removed by bounded routine retention"
  },
  "dataFabricHandoff": {
    "owner": "26-data-fabric",
    "status": "contract_required",
    "requiredEnvelopeFields": ["eventId", "eventType", "productId", "accountReference", "objectId", "occurredAt", "sourceCommit", "schemaVersion", "auditId"],
    "billingAuthority": "Card does not create provider settlement or reward revenue without authoritative provider and Billing Ledger evidence"
  },
  "dependencies": [
    {"owner": "02-wallet-auth", "contract": "accepted Card registry and Gateway assertion", "status": "pending_acceptance"},
    {"owner": "14-ai", "contract": "review-only AI Gateway transport", "status": "local_adapter_only"},
    {"owner": "15-trust-center", "contract": "dispute/appeal evidence handoff", "status": "not_integrated"},
    {"owner": "26-data-fabric", "contract": "canonical Card event envelope", "status": "not_integrated"},
    {"owner": "29-integration", "contract": "protocol freeze and shared Testnet", "status": "pending"},
    {"owner": "30-security-sre", "contract": "release, artifact, signing and deployment gates", "status": "pending"}
  ],
  "migration": {
    "currentStateVersion": 1,
    "backupSchemaVersion": "ynx.card.backup.v1",
    "backupIntegrityDomain": "YNX_CARD_BACKUP_V1",
    "backwardCompatibility": "bounded v0 fixture migrates to state v1 by initializing notifications and deletion receipts; existing state-v1 documents missing deletionReceipts normalize to an empty map; this is test compatibility and not a claim of prior production deployment",
    "rollbackMigration": "a verified pre-restore v1 backup is created and has been restored in the local drill",
    "failClosedOnUnknownVersion": true,
    "maximumBackupBytes": 67108864
  },
  "recovery": {
    "operatorCommand": "ynx-card-product-admin",
    "operations": ["backup", "verify", "restore"],
    "absolutePathsRequired": true,
    "fileMode": "0600",
    "nonOverwritingBackupDestination": true,
    "fileAndDirectorySync": true,
    "sourceVerifiedBeforeMutation": true,
    "validPrimaryBehavior": "create verified rollback backup",
    "corruptPrimaryBehavior": "preserve exact bytes as quarantine and report SHA-256",
    "missingPrimaryBehavior": "cold restore without fabricating a rollback artifact",
    "offHostEncryptedBackup": false,
    "scheduledBackup": false,
    "timedRpoRtoEvidence": false
  },
  "releaseStatus": {
    "implementedLocal": true,
    "testedLocal": true,
    "installedLocal": false,
    "integratedCentral": false,
    "deployedStaging": false,
    "deployedPublic": false,
    "downloadHosted": false,
    "productionSigned": false,
    "storeReleased": false
  },
  "externalInputs": [
    {
      "input": "official issuer sandbox program and credential reference",
      "minimumPrivilege": "sandbox-only API access restricted to the selected Card program",
      "securePath": "provider secret manager or approved CI secret reference; never chat or Git",
      "neededNow": false
    },
    {
      "input": "mobile production signing identities",
      "minimumPrivilege": "release-signing job only",
      "securePath": "30-security-sre controlled signing runner",
      "neededNow": false
    }
  ]
}
