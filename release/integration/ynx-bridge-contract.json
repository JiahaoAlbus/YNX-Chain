    "bridge.transfer.source_finalized.v1",
    "bridge.transfer.proof_available.v1",
    "bridge.transfer.proof_verified.v1",
    "bridge.transfer.destination_submitted.v1",
    "bridge.transfer.destination_confirmed.v1",
    "bridge.transfer.destination_available.v1",
    "bridge.transfer.failed.v1",
    "bridge.transfer.refunded.v1",
    "bridge.transfer.disputed.v1",
    "bridge.reconciliation.recorded.v1"
  ],
  "errorSemantics": [
    {"class":"invalid","httpStatus":400,"retry":"no"},
    {"class":"unauthorized","httpStatus":401,"retry":"after-auth"},
    {"class":"not_found","httpStatus":404,"retry":"no"},
    {"class":"conflict","httpStatus":409,"retry":"after-state-refresh"},
    {"class":"rate_limited","httpStatus":429,"retry":"bounded-backoff"},
    {"class":"unavailable","httpStatus":503,"retry":"bounded-backoff-or-recovery"}
