    "domainBindings": ["routeId","messageId","nonceDomain","sourceChain","sourceTxHash","sourceEventIndex","intentDigest","finalizedBlockHash","finalizedBlockHeight"],
    "lightClientProof": "unsupported",
    "canonicalBridgeClaim": false
  },
  "canonicalEvents": [
    "bridge.transfer.source_submitted.v1",
