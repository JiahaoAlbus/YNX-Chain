    "billingLedger": "YNX Data Fabric after accepted canonical event ingestion",
    "publicStatus": "YNX Website/Integration/SRE after deployment proof"
  },
  "objectModel": {
    "idFields": ["objectId", "parentId", "version"],
    "kinds": ["folder", "doc"],
    "currentWritePrimitive": "server-serialized optimistic revision",
    "conflictCondition": "baseVersion does not equal current object version",
    "conflictResponse": {
      "httpStatus": 409,
      "bodyFields": ["error", "current"]
    },
    "duplicateSemantics": {
      "owner": "requesting actor",
      "versionsCopied": "current version only, renumbered to 1",
      "copied": ["visible untrashed subtree", "current content references"],
      "notCopied": ["ACL grants", "share links", "comments", "trash state", "star state"],
      "persistenceFailure": "complete in-memory rollback"
    }
  },
  "commentModel": {
    "rootThread": "threadId equals root comment id",
    "reply": "parentId identifies an existing comment and threadId identifies the root",
    "anchor": {
      "unit": "Unicode rune index",
      "fields": ["start", "end", "quote"],
      "validation": "server reads the exact version and derives the quote; mismatch fails"
    },
    "resolution": "editor may resolve or reopen a root thread",
    "resolvedThreadReply": "rejected until reopen"
  },
  "exportModel": {
    "formats": ["text", "markdown", "html", "json"],
    "pdf": "not implemented or claimed",
    "exactVersion": true,
    "responseEvidenceHeaders": [
      "X-YNX-Source-SHA256",
      "X-Content-SHA256",
      "X-YNX-Document-Version"
    ],
    "auditFields": ["version", "format", "sourceHash", "exportHash", "bytes"]
  },
