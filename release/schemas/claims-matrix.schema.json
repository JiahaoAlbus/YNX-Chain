{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ynxweb4.com/schemas/claims-matrix.schema.json",
  "title": "YNX claims evidence matrix",
  "allOf": [
    {"$ref": "./public-record.schema.json"},
    {
      "type": "object",
      "required": ["highRiskTerms", "claims"],
      "properties": {
        "highRiskTerms": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["claimId", "exactClaim", "product", "riskLevel", "evidenceLocation", "sourceCommit", "asOf", "owner", "reviewStatus", "allowedWording", "forbiddenWording", "expiry"],
            "properties": {
              "claimId": {"type": "string", "pattern": "^CLM-[0-9]{3}$"},
              "evidenceLocation": {"type": "array", "items": {"type": "string"}, "minItems": 1},
              "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
              "reviewStatus": {"enum": ["approved", "approved_with_qualifier", "blocked"]},
              "forbiddenWording": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    }
  ]
}
