  "vectors": [
    {
      "id": "MAIL-WALLET-001",
      "ownerDependencies": ["02-wallet-auth"],
      "scenario": "canonical product session sign-in",
      "input": {
        "productId": "com.ynx.mail",
        "productClientId": "ynx-mail-v1",
        "bundleId": "com.ynxweb4.mail",
        "scope": ["mail:account"],
        "callback": "ynxmail://wallet-auth/callback"
      },
      "expected": "live Wallet Auth v1 session accepted; replay, wrong product, wrong bundle, wrong device, reordered scope and expiry fail closed"
    },
    {
      "id": "MAIL-NATIVE-001",
      "ownerDependencies": [],
      "scenario": "two-user native delivery",
      "input": {
        "sender": "@alice",
        "recipient": "@bob",
        "subject": "Native delivery",
        "body": "Signed bounded message"
      },
      "expected": {
        "channel": "ynx_native",
        "state": "delivered",
        "recipientFolder": "inbox",
        "senderFolder": "sent",
        "senderSignatureValid": true
      }
    },
    {
      "id": "MAIL-INTERNET-001",
      "ownerDependencies": ["30-security-sre"],
      "scenario": "provider accepts an outbound Internet message",
      "providerResponse": {
        "status": 200,
        "messageId": "provider-message-reference"
      },
      "expected": {
        "channel": "internet_provider",
        "state": "provider_accepted",
        "delivered": false,
        "userRead": false,
        "idempotencyAttempt": 1
      }
    },
    {
      "id": "MAIL-INTERNET-002",
      "ownerDependencies": ["30-security-sre"],
      "scenario": "verified delivered webhook",
      "event": "email.delivered",
      "expected": {
        "state": "delivered",
        "meaning": "receiving mail server accepted the message",
        "userRead": false
      }
    },
    {
      "id": "MAIL-INTERNET-003",
      "ownerDependencies": ["30-security-sre"],
      "scenario": "opened provider event",
      "event": "email.opened",
      "expected": {
        "providerEventStored": true,
        "deliveryStateChanged": false,
        "userRead": false
      }
    },
    {
      "id": "MAIL-INTERNET-004",
      "ownerDependencies": ["30-security-sre"],
      "scenario": "permanent bounce followed by explicit retry",
      "event": "email.bounced",
      "expectedBeforeRetry": {
        "state": "bounced"
      },
      "expectedRetry": {
        "newIdempotencyAttempt": 2,
        "priorProviderMessageIdCleared": true,
        "stateAfterProviderAcceptance": "provider_accepted"
      }
    },
    {
      "id": "MAIL-INTERNET-005",
      "ownerDependencies": ["30-security-sre"],
      "scenario": "duplicate signed webhook after process restart",
      "expected": {
        "duplicate": true,
        "stateMutationCount": 0,
        "persistentReplayProtection": true
      }
    },
    {
      "id": "MAIL-INTERNET-006",
      "ownerDependencies": ["30-security-sre"],
      "scenario": "stale or invalid webhook signature",
      "expected": {
        "httpStatus": 400,
        "stateMutationCount": 0,
        "failClosed": true
      }
    },
    {
      "id": "MAIL-INTERNET-007",
      "ownerDependencies": ["13-monitor", "15-trust-center", "30-security-sre"],
      "scenario": "verified complaint suppresses future delivery",
      "expected": {
        "suppressionStoredByRecipientHash": true,
        "futureProviderCalls": 0,
        "futureDeliveryState": "failed",
        "futureReason": "recipient_suppressed",
        "deadLetterState": "blocked"
      }
    },
    {
      "id": "MAIL-INTERNET-008",
      "ownerDependencies": ["13-monitor", "30-security-sre"],
      "scenario": "provider rate limit then successful explicit retry",
      "expected": {
        "healthBeforeRetry": "rate_limited",
        "openDeadLettersBeforeRetry": 1,
        "healthAfterRetry": "submission_accepted_local_evidence",
        "openDeadLettersAfterRetry": 0,
        "queueMaximum": 1000
      }
    },
    {
      "id": "MAIL-AI-001",
      "ownerDependencies": ["14-ai"],
      "scenario": "approved selected-context reply draft",
      "expected": {
        "requiresPreview": true,
        "requiresApproval": true,
        "createsDraftOnly": true,
        "sendsMail": false,
        "cancellable": true
      }
    },
    {
      "id": "MAIL-DATA-001",
      "ownerDependencies": ["26-data-fabric", "29-integration", "30-security-sre"],
      "scenario": "transactional canonical delivery event pull and acknowledgement",
      "input": {
        "send": "one native recipient and one unconfigured Internet recipient",
        "batchLimit": 100,
        "restartBeforeNextSend": true
      },
      "expected": {
        "eventTypes": ["mail.send.approved", "mail.native.delivered", "mail.internet.failed"],
        "sequence": "monotonic and persistent across restart and acknowledgement compaction",
        "acknowledgement": "cannot move backwards or exceed emitted sequence",
        "contains": ["id", "schema_version", "type", "product", "owner", "source_commit", "sequence", "authority", "source", "coverage", "privacy_class", "occurred_at", "as_of", "recorded_at", "user_read_claimed"],
        "deliveryFieldsWhenApplicable": ["message_id", "recipient_hash", "provider", "provider_message_id", "state", "reason_code", "attempt", "mail_server_delivered"],
        "excludes": ["message_body", "message_subject", "mailbox_address", "attachment_name", "attachment_content", "account", "provider_credential", "raw_webhook"],
        "overflow": "Mail mutation fails closed before evidence can be dropped",
        "publicRoute": false
      }
    },
    {
      "id": "MAIL-DATA-002",
      "ownerDependencies": ["26-data-fabric", "29-integration"],
      "scenario": "provider acceptance, verified delivery and ignored engagement truth",
      "expected": {
        "providerAcceptance": {"state": "provider_accepted", "mail_server_delivered": false, "user_read_claimed": false},
        "verifiedDelivery": {"state": "delivered", "mail_server_delivered": true, "user_read_claimed": false},
        "openedOrClicked": {"type": "mail.internet.provider_event_ignored", "applied": false, "user_read_claimed": false},
        "duplicateWebhook": "no additional event",
        "providerEventId": "SHA-256 hash only",
        "rawWebhookStoredInCanonicalEvent": false
      }
    }
  ]
