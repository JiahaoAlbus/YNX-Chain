{
  "schemaVersion": "explorer.test-vectors.v1",
  "product": "YNX Explorer",
  "owner": "12-explorer",
  "sourceCommit": "57b0038312a58e48c97c73f8efaf4473764b9890",
  "vectors": [
    {
      "id": "EXP-CURSOR-001",
      "category": "positive",
      "request": "GET /api/blocks/latest?limit=2",
      "expected": {
        "httpStatus": 200,
        "fields": ["blocks", "nextCursor", "cursorVersion"],
        "cursorVersion": 1,
        "ordering": "height-descending"
      }
    },
    {
      "id": "EXP-CURSOR-002",
      "category": "positive",
      "precondition": "Use nextCursor from EXP-CURSOR-001 without modification",
      "request": "GET /api/blocks/latest?limit=2&cursor={nextCursor}",
      "expected": {
        "httpStatus": 200,
        "invariant": "No record from the first page repeats and newly inserted higher blocks do not shift the continuation anchor"
      }
    },
    {
      "id": "EXP-CURSOR-003",
      "category": "negative-tamper",
      "precondition": "Change one byte of a valid block cursor",
      "request": "GET /api/blocks/latest?cursor={tamperedCursor}",
      "expected": {
        "httpStatus": 400,
        "error": "invalid_cursor",
        "failClosed": true
      }
    },
    {
      "id": "EXP-CURSOR-004",
      "category": "negative-cross-feed",
      "precondition": "Use a valid block cursor on the transaction feed",
      "request": "GET /api/txs?cursor={blockCursor}",
      "expected": {
        "httpStatus": 400,
        "error": "invalid_cursor",
        "failClosed": true
      }
    },
    {
      "id": "EXP-CURSOR-005",
      "category": "restart",
      "precondition": "Do not configure YNX_INDEXER_CURSOR_KEY; issue a cursor, restart Indexer, then reuse it",
      "expected": {
        "httpStatus": 400,
        "healthCursorPersistence": "process-scoped",
        "meaning": "Pre-restart cursor expired; no silent acceptance"
      }
    },
    {
      "id": "EXP-CURSOR-006",
      "category": "restart-configured-key",
      "precondition": "Configure the same approved 32-byte-or-longer key before and after restart",
      "expected": {
        "healthCursorPersistence": "configured-key",
        "invariant": "A retained anchor cursor remains verifiable across restart"
      },
      "status": "testedLocal",
      "sourceCommit": "1d403f82e1e3a17ee892e43187752e2d564767c5",
      "evidence": "scripts/verify/indexer-cursor-restart-check.sh"
    },
    {
      "id": "EXP-ERROR-001",
      "category": "failure-classification",
      "precondition": "Indexer rejects a cursor with HTTP 400",
      "expected": {
        "explorerHttpStatus": 400
      }
    },
    {
      "id": "EXP-ERROR-002",
      "category": "failure-classification",
      "precondition": "Indexer returns HTTP 503 while request contains a cursor",
      "expected": {
        "explorerHttpStatus": 502,
        "invariant": "Dependency outage is not mislabeled as client cursor failure"
      }
    },
    {
      "id": "EXP-ROUTE-001",
      "category": "canonical-route",
      "input": {
        "searchResult": {"type":"block","query":"41"}
      },
      "expected": {
        "route": "/block/41",
        "drawer": "open",
        "back": "route / and drawer closed",
        "forward": "route /block/41 and drawer restored"
      }
    },
    {
      "id": "EXP-ROUTE-002",
      "category": "negative-route",
      "inputs": [
        "/unknown/value",
        "/block/41/extra",
        "/?kind=wallet&id=41",
        "/?kind=block&id="
      ],
      "expected": {
        "selection": null,
        "failClosed": true
      }
    },
    {
      "id": "EXP-SUMMARY-001",
      "category": "schema-migration",
      "input": {
        "rpcHeight": 6423,
        "indexedHeight": 6422,
        "syncLagBlocks": 1,
        "network": {"name":"YNX Testnet","chainId":6423,"nativeCurrencySymbol":"YNXT"}
      },
      "expected": {
        "displayHeight": 6423,
        "displayNetwork": "YNX Testnet",
        "displayChainId": 6423
      }
    },
    {
      "id": "EXP-SUMMARY-002",
      "category": "old-client-compatibility",
      "input": {
        "latestHeight": 41,
        "network": "ynx_6423-1",
        "chainId": 6423
      },
      "expected": {
        "displayHeight": 41,
        "displayNetwork": "ynx_6423-1",
        "displayChainId": 6423
      }
    },
    {
      "id": "EXP-EVIDENCE-001",
      "category": "public-evidence-positive",
      "request": "GET /api/evidence/transaction/{knownHash}",
      "expected": {
        "httpStatus": 200,
        "schemaVersion": "explorer.public-evidence.v1",
        "sourceAuthority": "01-chain-core",
        "transportOwner": "12-explorer",
        "transport": "ynx-indexer",
        "asOfBasis": "source-event-time",
        "integrityAlgorithm": "sha256",
        "payloadHash": "{knownHash}"
      }
    },
    {
      "id": "EXP-EVIDENCE-002",
      "category": "public-evidence-partial",
      "precondition": "RPC height is one block ahead of Indexer height",
      "request": "GET /api/evidence/block/{indexedHeight}",
      "expected": {
        "httpStatus": 200,
        "freshnessState": "partial",
        "partial": true,
        "offline": false,
        "lagBlocks": 1,
        "coverageStatus": "partial",
        "missing": ["records-after-indexed-height"]
      }
    },
    {
      "id": "EXP-EVIDENCE-003",
      "category": "public-evidence-freshness-degraded",
      "precondition": "Requested Indexer record succeeds while the cross-source Summary probe fails",
      "expected": {
        "httpStatus": 200,
        "payloadPreserved": true,
        "freshnessState": "unknown",
        "partial": true,
        "offline": false,
        "coverageStatus": "partial",
        "missing": ["cross-source-freshness"]
      }
    },
    {
      "id": "EXP-EVIDENCE-004",
      "category": "public-evidence-fail-closed",
      "precondition": "The authoritative record source returns HTTP 503",
      "expected": {
        "httpStatus": 502,
        "errorCode": "evidence_source_unavailable",
        "retryable": true,
        "freshnessState": "offline",
        "payload": null,
        "integrity": null,
        "internalHostDisclosure": false
      }
    },
    {
      "id": "EXP-SSE-001",
      "category": "last-event-id-replay",
      "precondition": "Receive at least two dashboard events, disconnect after event N, then reconnect with Last-Event-ID: N while successor events remain in the 64-event history",
      "request": "GET /api/stream with Last-Event-ID: {retainedEventId}",
      "expected": {
        "httpStatus": 200,
        "recoveryHeader": "replay",
        "invariant": "Every retained successor is emitted once in ascending event-ID order before live events"
      },
      "status": "testedLocal",
      "sourceCommit": "57b0038312a58e48c97c73f8efaf4473764b9890",
      "evidence": ["internal/explorer/server_stream_test.go", "scripts/verify/explorer-check.sh"]
    },
    {
      "id": "EXP-SSE-002",
      "category": "gap-snapshot-recovery",
      "precondition": "Reconnect with an invalid, expired, future or restart-invalidated Last-Event-ID",
      "request": "GET /api/stream with Last-Event-ID: {unavailableEventId}",
      "expected": {
        "httpStatus": 200,
        "recoveryHeader": "snapshot",
        "firstControlEvent": "stream-reset",
        "recoverySchema": "explorer.stream-recovery.v1",
        "invariant": "No missing interval is represented as continuous; the next dashboard event is a full snapshot"
      },
      "status": "testedLocal",
      "sourceCommit": "57b0038312a58e48c97c73f8efaf4473764b9890",
      "evidence": ["internal/explorer/server_stream_test.go", "apps/explorer/src/live.test.ts", "scripts/verify/explorer-check.sh"]
    },
    {
      "id": "EXP-SSE-003",
      "category": "slow-client-recovery",
      "precondition": "A stream client fails to drain its bounded 64-event channel",
      "expected": {
        "connection": "closed-by-server",
        "clientRecovery": "native EventSource reconnect with Last-Event-ID",
        "fallback": "bounded snapshot polling until a dashboard event arrives",
        "silentDrop": false
      },
      "status": "testedLocal",
      "sourceCommit": "57b0038312a58e48c97c73f8efaf4473764b9890",
      "evidence": ["internal/explorer/server_stream_test.go", "apps/explorer/src/live.test.ts"]
    }
  ]
}
