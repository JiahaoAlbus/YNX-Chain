  "consumers": [
    {"id":"wallet","responsibility":"quote, exact route review, fee/risk/finality review, source signature, recovery entry","mutationAuthority":"user-approved canonical Wallet intent only"},
    {"id":"pay","responsibility":"keep bridge funding pending through destination confirmation; pay only at destination_available with explicit availability flag","mutationAuthority":"none"},
    {"id":"exchange","responsibility":"keep deposit pending through destination confirmation; credit only at destination_available with explicit availability flag","mutationAuthority":"custody-approved backend only"},
    {"id":"dex","responsibility":"label route as external and show provider/contracts/slippage/finality/refund","mutationAuthority":"user-approved canonical Wallet intent only"},
    {"id":"finance","responsibility":"read-only exposure and source-qualified reconciliation","mutationAuthority":"none"},
    {"id":"explorer","responsibility":"deep-link source transaction, proof status, destination transaction, confirmation, and availability evidence","mutationAuthority":"none"},
    {"id":"monitor","responsibility":"alert on pause, exposure saturation, provider failure, proof failure, and reconciliation age/difference","mutationAuthority":"operator safety action through approved control plane only"},
    {"id":"trust","responsibility":"open dispute and appeal with immutable evidence references","mutationAuthority":"product-scoped Gateway session without asset authority"}
  ],
  "truthRules": [
    "quote is not source acceptance",
    "source acceptance is not source finality",
    "proof availability is not proof verification",
    "provider webhook is not chain finality",
    "destination submission is not destination confirmation",
    "destination confirmation is not destination asset availability",
    "asset availability requires destination_available and destinationAssetAvailable=true",
    "operator reconciliation is not independent proof",
    "unavailable provider routes remain unavailable"
  ]
